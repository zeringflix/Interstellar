      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DamageModel</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Pure damage / status logic. No Roblox instances in here, so it runs in plain
-- Luau and is covered by tests/damage_spec.luau. The server (DamageService) is the
-- only code that mutates dummy state, and it does so only through these functions.
local Config = require(script.Parent.GameConfig)
local D = Config.Damage

local DamageModel = {}

DamageModel.REGIONS = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }
DamageModel.REGION_LABEL = {
	Head = "HEAD", Torso = "TORSO", LeftArm = "LEFT ARM", RightArm = "RIGHT ARM",
	LeftLeg = "LEFT LEG", RightLeg = "RIGHT LEG",
}

-- Rig part name -> logical body region.
local PART_REGION = {
	Head = "Head", UpperTorso = "Torso", LowerTorso = "Torso", HumanoidRootPart = "Torso",
	LeftUpperArm = "LeftArm", LeftLowerArm = "LeftArm", LeftHand = "LeftArm",
	RightUpperArm = "RightArm", RightLowerArm = "RightArm", RightHand = "RightArm",
	LeftUpperLeg = "LeftLeg", LeftLowerLeg = "LeftLeg", LeftFoot = "LeftLeg",
	RightUpperLeg = "RightLeg", RightLowerLeg = "RightLeg", RightFoot = "RightLeg",
}
-- Exact spot shown to the player ("Left Knee"), finer than the six damage regions.
local PART_LABEL = {
	Head = "Head", UpperTorso = "Chest", LowerTorso = "Pelvis", HumanoidRootPart = "Chest",
	LeftUpperArm = "Left Shoulder", LeftLowerArm = "Left Elbow", LeftHand = "Left Hand",
	RightUpperArm = "Right Shoulder", RightLowerArm = "Right Elbow", RightHand = "Right Hand",
	LeftUpperLeg = "Left Thigh", LeftLowerLeg = "Left Knee", LeftFoot = "Left Foot",
	RightUpperLeg = "Right Thigh", RightLowerLeg = "Right Knee", RightFoot = "Right Foot",
}
function DamageModel.partLabel(partName: string): string
	return PART_LABEL[partName] or "Chest"
end

-- Plain-language injury for a hit, by region kind and severity (game flavour, not medicine).
local INJURY = {
	Head = { LIGHT = "Dazed", MEDIUM = "Concussed", HEAVY = "Skull cracked", CRITICAL = "Severe head trauma" },
	Torso = { LIGHT = "Winded", MEDIUM = "Bruised ribs", HEAVY = "Broken ribs", CRITICAL = "Chest crushed" },
	Arm = { LIGHT = "Arm bruised", MEDIUM = "Arm sprained", HEAVY = "Arm broken", CRITICAL = "Arm shattered" },
	Leg = { LIGHT = "Leg bruised", MEDIUM = "Leg sprained", HEAVY = "Leg broken", CRITICAL = "Leg shattered" },
}
function DamageModel.injury(region: string, severity: string): string
	local kind = if region == "Head" or region == "Torso" then region elseif string.find(region, "Arm") then "Arm" else "Leg"
	return INJURY[kind][severity] or "Hit"
end

-- One short phrase for how the dummy is doing right now ("Hurt, still standing").
function DamageModel.condition(state, now: number): string
	if state.dead then
		return "Dead"
	elseif now < state.unconsciousUntil then
		return "Knocked out"
	elseif state.ragdolled and not DamageModel.canStand(state) then
		return "Crawling"
	elseif state.ragdolled then
		return "Down"
	elseif state.health >= state.maxHealth then
		return "Unhurt"
	elseif state.regions.LeftLeg < 0.5 or state.regions.RightLeg < 0.5 then
		return "Limping"
	elseif state.health <= D.CRITICAL_HEALTH then
		return "Critical, still standing"
	end
	return "Hurt, still standing"
end

function DamageModel.regionOf(partName: string): string
	return PART_REGION[partName] or "Torso"
end

function DamageModel.newState(id: number, typeName: string)
	local t = Config.DummyTypes[typeName] or Config.DummyTypes.Noob
	local regions = {}
	for _, r in DamageModel.REGIONS do
		regions[r] = 1
	end
	return {
		id = id, typeName = typeName, armor = t.armor,
		health = t.health, maxHealth = t.health, blood = 100, regions = regions,
		ragdolled = false, dead = false, bleeding = false,
		unconsciousUntil = 0, staggerUntil = 0, hitUntil = 0, recoveringUntil = 0, downUntil = 0,
		lastSource = "", lastSpeed = 0, lastRegion = "", lastDamageTime = -math.huge, lastDir = { 0, 0, 0 },
		history = {},
	}
end

local function clamp(x, lo, hi)
	return math.max(lo, math.min(hi, x))
end

-- hit = { relSpeed (studs/s), vehicleImpact (per-vehicle weight class), region, source }
-- Returns { damage, severity, reaction } without touching state.
function DamageModel.evaluate(state, hit)
	local score = hit.relSpeed * (hit.vehicleImpact or 1)
	local severity = "LIGHT"
	if score >= D.SEVERITY.CRITICAL then
		severity = "CRITICAL"
	elseif score >= D.SEVERITY.HEAVY then
		severity = "HEAVY"
	elseif score >= D.SEVERITY.MEDIUM then
		severity = "MEDIUM"
	end
	local t = clamp((hit.relSpeed - D.SPEED_FLOOR) / (D.SPEED_FULL - D.SPEED_FLOOR), 0, 1.5)
	local damage = (t ^ D.CURVE) * D.BASE_MAX * (hit.vehicleImpact or 1)
		* (D.REGION_MULT[hit.region] or 1) * (state.armor or 1)
	if state.ragdolled then
		damage *= D.RAGDOLLED_MULT
	end
	damage = math.floor(damage + 0.5)
	return { damage = damage, severity = severity }
end

-- Applies a validated hit. Mutates state and returns a record describing exactly what changed.
function DamageModel.applyHit(state, hit, now: number)
	if state.dead then
		return { ignored = true, reason = "dead" }
	end
	local ev = DamageModel.evaluate(state, hit)
	local damage, severity = ev.damage, ev.severity
	local before = state.health
	state.health = math.max(0, state.health - damage)
	local region = hit.region
	state.regions[region] = clamp(state.regions[region] - damage / 60, 0, 1)

	state.lastSource, state.lastSpeed, state.lastRegion = hit.source or "Unknown", hit.relSpeed, region
	state.lastDamageTime = now
	state.hitUntil = now + D.HIT_FLASH_TIME

	local reaction = "STAGGER"
	if state.health <= 0 then
		state.dead = true
		state.ragdolled = true
		reaction = "RAGDOLL"
	else
		local knockout = severity == "CRITICAL" or (region == "Head" and severity == "HEAVY") or damage >= 45
		if knockout then
			state.unconsciousUntil = math.max(state.unconsciousUntil, now + 5 + damage * 0.12)
		end
		if (severity == "HEAVY" or severity == "CRITICAL" or damage >= 35) and state.regions[region] < 0.55 then
			state.bleeding = true
			state.blood = math.max(D.BLOOD_FLOOR, state.blood - damage * 0.12) -- the wound itself costs some blood
		end
		local legsOut = state.regions.LeftLeg <= 0.2 or state.regions.RightLeg <= 0.2
		if severity ~= "LIGHT" or knockout or legsOut or state.ragdolled or state.health <= D.CRITICAL_HEALTH then
			reaction = "RAGDOLL"
			state.ragdolled = true
			local f = clamp(damage / 60, 0, 1)
			state.downUntil = math.max(state.downUntil, now + D.DOWN_TIME[1] + (D.DOWN_TIME[2] - D.DOWN_TIME[1]) * f)
		else
			state.staggerUntil = now + D.STAGGER_TIME
		end
	end

	local record = {
		id = state.id, region = region, severity = severity, damage = before - state.health,
		health = state.health, source = state.lastSource, relSpeed = hit.relSpeed, reaction = reaction,
		injury = DamageModel.injury(region, severity), partLabel = DamageModel.partLabel(hit.partName or ""),
		blood = math.floor(state.blood + 0.5), bleeding = state.bleeding, dead = state.dead,
		time = now, chain = hit.chain or false,
	}
	table.insert(state.history, record)
	if #state.history > 12 then
		table.remove(state.history, 1)
	end
	return record
end

-- Time-based changes (bleeding drain). Returns true when something changed.
function DamageModel.tick(state, dt: number, now: number?): boolean
	if state.dead or not state.bleeding then
		return false
	end
	local changed = false
	if state.blood > D.BLOOD_FLOOR then
		state.blood = math.max(D.BLOOD_FLOOR, state.blood - D.BLOOD_RATE * dt)
		changed = true
		if state.blood < 55 and now then -- heavy blood loss: the dummy passes out
			state.unconsciousUntil = math.max(state.unconsciousUntil, now + 4)
			state.ragdolled = true
		end
	else
		state.bleeding = false -- clotted
		changed = true
	end
	if state.health > D.BLEED_FLOOR then
		state.health = math.max(D.BLEED_FLOOR, state.health - D.BLEED_RATE * dt)
		changed = true
	end
	return changed
end

function DamageModel.isUnconscious(state, now: number): boolean
	return not state.dead and now < state.unconsciousUntil
end

function DamageModel.canStand(state): boolean
	return state.regions.LeftLeg > 0.2 and state.regions.RightLeg > 0.2
end

-- May the dummy start getting up right now?
function DamageModel.canRecover(state, now: number): boolean
	return state.ragdolled and not state.dead and not DamageModel.isUnconscious(state, now)
		and DamageModel.canStand(state) and now >= state.downUntil and state.health > D.CRITICAL_HEALTH * 0.4
end

-- The ordered list of condition labels that are true right now. Always derived from state.
function DamageModel.statusList(state, now: number): { string }
	if state.dead then
		return { "DEAD" }
	end
	local list = {}
	if state.health <= D.CRITICAL_HEALTH then
		table.insert(list, "CRITICAL")
	end
	if now < state.unconsciousUntil then
		table.insert(list, "UNCONSCIOUS")
	elseif state.ragdolled and not DamageModel.canStand(state) then
		table.insert(list, "CRAWLING")
	elseif state.ragdolled then
		table.insert(list, "DOWN")
	elseif now < state.recoveringUntil then
		table.insert(list, "RECOVERING")
	elseif now < state.staggerUntil then
		table.insert(list, "STAGGERING")
	elseif state.regions.LeftLeg < 0.5 or state.regions.RightLeg < 0.5 then
		table.insert(list, "LIMPING")
	elseif now < state.hitUntil then
		table.insert(list, "HIT")
	end
	if state.bleeding then
		table.insert(list, "BLEEDING")
	end
	if #list == 0 then
		list[1] = "HEALTHY"
	end
	return list
end

function DamageModel.statusText(state, now: number): string
	return table.concat(DamageModel.statusList(state, now), " · ")
end

function DamageModel.regionLabel(cond: number): string
	if cond >= 0.85 then
		return "Healthy"
	elseif cond >= 0.6 then
		return "Light Damage"
	elseif cond >= 0.35 then
		return "Moderate Damage"
	elseif cond > 0.1 then
		return "Severe Damage"
	end
	return "Broken"
end

-- Which face the dummy should wear. Driven purely by state.
function DamageModel.face(state, now: number): string
	if state.dead then
		return "Dead"
	elseif now < state.unconsciousUntil then
		return "Unconscious"
	elseif now < state.hitUntil and now - state.lastDamageTime < 0.6 then
		return "Surprised"
	elseif state.ragdolled or now < state.staggerUntil then
		return "Dizzy"
	elseif state.health <= D.CRITICAL_HEALTH or state.bleeding or state.health < state.maxHealth * 0.6 then
		return "Hurt"
	end
	return "Normal"
end

function DamageModel.revive(state, now: number)
	state.health = state.maxHealth
	state.blood = 100
	for _, r in DamageModel.REGIONS do
		state.regions[r] = 1
	end
	state.dead, state.bleeding = false, false
	state.unconsciousUntil, state.staggerUntil, state.hitUntil, state.downUntil = 0, 0, 0, 0
	state.recoveringUntil = now + D.RECOVER_TIME
end

return DamageModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Shared tuning constants for RAGDOLL CRASH PHYSICS. Everything a designer may want to tweak lives here.
local Config = {}

-- Units ---------------------------------------------------------------
-- Game convention: 1 stud = 0.28 m (Roblox's documented character scale), so
-- 1 stud/s = 0.28 m/s = 0.626 mph. Every "MPH" shown in the UI uses this.
Config.STUDS_PER_SEC_TO_MPH = 0.626

-- Session -------------------------------------------------------------
Config.MAX_PLAYERS = 1 -- set the same value in Game Settings > Places
Config.MAX_VEHICLES = 2
Config.DUMMY_LIMITS = { Low = 12, Automatic = 20, High = 25 }
Config.MOBILE_DUMMY_LIMIT = 14

-- Dummies -------------------------------------------------------------
-- Every dummy is fully grey. `body` picks the avatar: "Robloxian2" (default) | "Man" | "Blocky".
-- Robloxian 2.0 / Man bodies and the animatable Man head are Roblox's own catalog assets, loaded at
-- runtime with Players:CreateHumanoidModelFromDescription (see DummyRig).
Config.DummyBody = "Robloxian2"
Config.Bodies = {
	Robloxian2 = { Torso = 27112025, RightArm = 27112039, LeftArm = 27112052, LeftLeg = 27112056, RightLeg = 27112068 },
	Man = { Torso = 86500008, RightArm = 86500036, LeftArm = 86500054, LeftLeg = 86500064, RightLeg = 86500078 },
	Blocky = {},
}
Config.MAN_DYNAMIC_HEAD = 10725826963 -- "Man Face - Head": the dynamic (FaceControls) Man head
local function grey(hex)
	return { head = hex, arms = hex, torso = hex, legs = hex }
end
Config.DummyTypes = {
	Noob = { display = "DUMMY", scale = 1, density = 0.7, armor = 1, health = 100, colors = grey("#a3a2a5") },
	Crash = { display = "CRASH DUMMY", scale = 1, density = 0.7, armor = 1, health = 100, colors = grey("#8d8c90"), markings = true },
	Heavy = { display = "HEAVY DUMMY", scale = 1.18, density = 1.6, armor = 0.7, health = 140, colors = grey("#6f6e72") },
	Light = { display = "LIGHT DUMMY", scale = 0.88, density = 0.35, armor = 1.2, health = 80, colors = grey("#c4c3c7") },
	Armored = { display = "ARMORED DUMMY", scale = 1, density = 1.0, armor = 0.5, health = 110, colors = grey("#7b7a7e"), armorKit = true },
}

-- Impact detection ----------------------------------------------------
Config.Impact = {
	MIN_SPEED = 8,            -- studs/s relative speed below which a touch is only a push
	CONTACT_BREAK_TIME = 0.35, -- contact must be absent this long before a new impact can register
	MIN_REHIT_TIME = 0.5,     -- hard floor between two damaging hits from the same source
	QUERY_PADDING = 1.5,      -- studs added around the vehicle for the swept overlap query
	MAX_IMPULSE_SPEED = 170,  -- clamp for the velocity a hit can give a dummy part (studs/s)
	ACTIVE_RADIUS = 260,      -- vehicles further than this from every dummy skip queries
}

-- Damage curve (see DamageModel) ---------------------------------------
Config.Damage = {
	SPEED_FLOOR = 8,     -- studs/s where damage starts
	SPEED_FULL = 130,    -- studs/s where the base curve reaches BASE_MAX
	BASE_MAX = 70,
	CURVE = 1.25,
	REGION_MULT = { Head = 1.35, Torso = 1.0, LeftArm = 0.6, RightArm = 0.6, LeftLeg = 0.75, RightLeg = 0.75 },
	RAGDOLLED_MULT = 0.6, -- an already tumbling dummy absorbs less
	SEVERITY = { MEDIUM = 22, HEAVY = 55, CRITICAL = 95 }, -- thresholds on relSpeed * vehicleImpact
	BLEED_RATE = 1,      -- health per second while BLEEDING
	BLEED_FLOOR = 10,    -- bleeding alone never takes a dummy below this
	BLOOD_RATE = 0.8,    -- % of blood lost per second while BLEEDING
	BLOOD_FLOOR = 40,    -- bleeding stops by itself here (clotting); below 55% the dummy passes out
	CRITICAL_HEALTH = 25,
	STAGGER_TIME = 1.3,
	HIT_FLASH_TIME = 2.0,
	RECOVER_TIME = 1.6,
	DOWN_TIME = { 2.5, 6 }, -- seconds a conscious, healthy-legged dummy stays down (min, max by damage)
}

-- Crash score -----------------------------------------------------------
Config.Score = { LIGHT = 50, MEDIUM = 150, HEAVY = 400, CRITICAL = 800, CHAIN = 120, PROP = 15, REPEAT_WINDOW = 4 }

-- Replay ----------------------------------------------------------------
Config.Replay = { SECONDS = 10, HZ_HIGH = 20, HZ_LOW = 10, SPEED = 0.25 }

-- Map -------------------------------------------------------------------
Config.Map = {
	SIZE = 700,
	Names = { "Test Grounds", "Downtown", "Desert Range" },
	Spawns = { -- position (ground level) and yaw in degrees; yaw 0 faces -Z
		Road = { 0, 0, 34, 0 },
		TankField = { -220, 0, 185, 0 },
		Runway = { 290, 0, 285, 0 },
		Helipad = { 236, 0, 150, 0 },
		Rail = { -330, 0, 285, 0 },
		SledTrack = { 335, 0, 290, 0 },
	},
	Zones = { -- name, teleport position for the player
		{ "Central Spawn", 0, 48 },
		{ "Dummy Testing Field", -190, -20 },
		{ "High-Speed Crash Track", -150, 240 },
		{ "Giant Ramp Area", 150, -30 },
		{ "Aircraft Airfield", 262, 270 },
		{ "Tank Test Field", -200, 190 },
		{ "Destruction Yard", 120, 60 },
	},
}

-- Progression -----------------------------------------------------------------------------------
-- Vehicles are ranked from least to most cool. The first 14 unlock in that order as the player's
-- lifetime CRASH POINTS grow (points come only from verified crash reports that a vehicle started).
-- The 3 coolest are Robux game passes: create them on the Creator Dashboard (Monetization > Passes)
-- and paste each pass id below; while an id is 0 the vehicle shows "SOON" and stays locked.
Config.Progression = {
	Ladder = { -- { vehicle, lifetime crash points needed }
		{ "Sedan", 0 }, { "GoKart", 1500 }, { "CityBus", 4000 }, { "PickupTruck", 8000 }, { "DumpTruck", 13000 },
		{ "PoliceCar", 19000 }, { "MuscleCar", 26000 }, { "Bulldozer", 34000 }, { "Train", 43000 }, { "SmallPlane", 53000 },
		{ "ArmoredTruck", 64000 }, { "SportsCar", 76000 }, { "Helicopter", 90000 }, { "CargoPlane", 110000 },
	},
	Paid = { -- coolest last
		{ vehicle = "MonsterTruck", passId = 0, price = 99 },
		{ vehicle = "Tank", passId = 0, price = 149 },
		{ vehicle = "RocketSled", passId = 0, price = 199 },
	},
	MAX_POINTS_PER_CRASH = 15000, -- one report can never award more than this
	DATASTORE = "RCP_Progress_v1",
	AUTOSAVE_SECONDS = 120,
	StudioUnlockAll = false, -- true = every vehicle usable while testing in Studio (never in a live server)
}

-- Shop window: the three Robux vehicles (built from Config.Progression.Paid).
Config.Shop = {}
for _, p in Config.Progression.Paid do
	table.insert(Config.Shop, { vehicle = p.vehicle, price = p.price, id = p.passId, kind = "pass" })
end

-- Crash explosions: velocity lost in one physics step (studs/s) that turns a crash into a fireball.
Config.Explosion = { GROUND_DV = 70, AIRCRAFT_DV = 45, RADIUS = 30, COOLDOWN = 2 }

Config.StatusColors = {
	HEALTHY = "#7ee08a", HIT = "#fff3b0", STAGGERING = "#ffd84a", DOWN = "#ff9a3c", LIMPING = "#ffc46b",
	CRAWLING = "#ff8a5c", BLEEDING = "#d9534f", UNCONSCIOUS = "#b49cff", CRITICAL = "#ff3b3b",
	DEAD = "#9a6b6b", RECOVERING = "#5fe3e0",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">VehicleBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Builds a vehicle Model from VehicleSpecs (the same data the Blender meshes are made from).
-- visualOnly = true gives an anchored, constraint-free copy for menu ViewportFrames.
--
-- Physics layout of a live vehicle:
--   Root          invisible box carrying ALL the mass (density derived from spec.mass)
--   spec parts    Massless, welded to Root; the ones flagged collide are the crash surfaces
--   WheelCollider frictionless balls welded to Root - the vehicle slides on these and the
--                 client applies drive / grip forces (VehicleInputController), so handling is
--                 fully tunable and stable at high speed
--   Wheel visuals / propellers / rotors: light non-colliding parts on motor hinges
--   Turret        (tank) separate assembly on a servo hinge
local Specs = require(script.Parent.VehicleSpecs)
local MeshInfo = require(script.Parent.VehicleMeshInfo)

local Builder = {}

local MATERIAL = {
	body = Enum.Material.SmoothPlastic, glass = Enum.Material.Glass, light = Enum.Material.Neon,
	neon = Enum.Material.Neon, dark = Enum.Material.SmoothPlastic, metal = Enum.Material.Metal,
	rubber = Enum.Material.Rubber,
}
local NO_FRICTION = PhysicalProperties.new(0.7, 0, 0, 100, 1)
local BODY_PROPS = PhysicalProperties.new(0.7, 0.2, 0.15, 1, 1)
local FEATHER = PhysicalProperties.new(0.01, 0, 0, 1, 1)

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function axisCFrame(axis: string): CFrame
	if axis == "y" then
		return CFrame.Angles(0, 0, math.rad(90))
	elseif axis == "z" then
		return CFrame.Angles(0, math.rad(90), 0)
	end
	return CFrame.identity
end

local function makePart(p): BasePart
	local part: BasePart
	local size, cf = v3(p.size), CFrame.new(v3(p.pos))
	if p.shape == "wedge" then
		part = Instance.new("WedgePart")
		if p.face == "back" then
			cf *= CFrame.Angles(0, math.rad(180), 0)
		end
	elseif p.shape == "cyl" then
		local c = Instance.new("Part")
		c.Shape = Enum.PartType.Cylinder
		part = c
		-- Roblox cylinders run along the part's X axis.
		if p.axis == "y" then
			size = Vector3.new(size.Y, size.X, size.Z)
		elseif p.axis == "z" then
			size = Vector3.new(size.Z, size.Y, size.X)
		end
		cf *= axisCFrame(p.axis)
	else
		part = Instance.new("Part")
	end
	part.Name = p.name
	part.Size = size
	part.CFrame = cf
	part.Color = Color3.fromHex(p.color)
	part.Material = MATERIAL[p.mat] or Enum.Material.SmoothPlastic
	part.Transparency = if p.mat == "glass" then 0.45 else 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = p.collide
	part.Massless = true
	part.CustomPhysicalProperties = if p.mat == "rubber" then NO_FRICTION else BODY_PROPS
	part.CollisionGroup = "Vehicle"
	part.CastShadow = math.min(size.X, size.Y, size.Z) > 0.4
	return part
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = a, b
	w.Parent = b
end

local function hinge(root: BasePart, part: BasePart, pivot: Vector3, axis: string, name: string): HingeConstraint
	local a0 = Instance.new("Attachment")
	a0.Name = name .. "A0"
	a0.CFrame = root.CFrame:ToObjectSpace(CFrame.new(pivot) * axisCFrame(axis))
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = name .. "A1"
	a1.CFrame = part.CFrame:ToObjectSpace(CFrame.new(pivot) * axisCFrame(axis))
	a1.Parent = part
	local h = Instance.new("HingeConstraint")
	h.Name = name
	h.Attachment0, h.Attachment1 = a0, a1
	h.ActuatorType = Enum.ActuatorType.Motor
	h.MotorMaxTorque = 1e5
	h.AngularVelocity = 0
	h.Parent = root
	return h
end

-- Optional detailed meshes -----------------------------------------------------------------
-- If the Blender models have been imported (ReplicatedStorage.VehicleMeshes.<Key>, see docs/MODELS.md),
-- they replace the look of the part-built vehicle. The parts stay as the collision / physics body.
-- Roblox re-centres every imported mesh on its bounding box, so VehicleMeshInfo (generated from the
-- .blend files) records where each mesh's centre belongs relative to the vehicle origin, and its size.
local function applyMeshes(model: Model, key: string, root: BasePart, parts, wheelParts, spec, visualOnly: boolean?): boolean
	local library = game:GetService("ReplicatedStorage"):FindFirstChild("VehicleMeshes")
	local source = library and library:FindFirstChild(key, true) -- works whether the import sits in the folder or IS the folder
	local info = MeshInfo[key]
	if not source or not info then
		return false
	end
	local used = 0
	for _, src in source:GetDescendants() do
		local entry = src:IsA("MeshPart") and info[src.Name]
		if entry then
			local mesh = src:Clone() :: MeshPart
			for _, child in mesh:GetChildren() do -- keep the imported textures (SurfaceAppearance), drop anything else
				if not child:IsA("SurfaceAppearance") then
					child:Destroy()
				end
			end
			local textured = mesh:FindFirstChildOfClass("SurfaceAppearance") ~= nil
			mesh.Size = Vector3.new(entry[4], entry[5], entry[6])
			mesh.CFrame = CFrame.new(entry[1], entry[2], entry[3])
			mesh.CanCollide, mesh.CanQuery, mesh.CanTouch = false, false, false
			mesh.Massless = true
			mesh.CollisionGroup = "VehicleDecor"
			mesh.Anchored = visualOnly == true
			local kind = string.match(src.Name, "_(%a+)%d*$") or "Body"
			if kind == "Glass" then
				mesh.Material, mesh.Transparency = Enum.Material.Glass, 0.45
			elseif kind == "Lights" then
				mesh.Material = Enum.Material.Neon
			else
				-- textured meshes: the SurfaceAppearance supplies colour, roughness, metalness and normals
				mesh.Material = Enum.Material.SmoothPlastic
			end
			if not textured then
				mesh.Color = Color3.new(1, 1, 1) -- untextured imports carry their colours as vertex colours
			end
			mesh.Parent = model
			if not visualOnly then
				local index = tonumber(string.match(src.Name, "%d+$"))
				local target: BasePart = root
				if kind == "Wheel" and index and wheelParts[index] then
					target = wheelParts[index]
				elseif kind == "Spin" and index and spec.spinners and spec.spinners[index] then
					target = parts[spec.spinners[index].parts[1]]
				elseif kind == "Turret" and spec.turret then
					target = parts[spec.turret[1]]
				end
				weld(target, mesh)
			end
			used += 1
		end
	end
	if used == 0 then
		return false
	end
	for _, d in model:GetDescendants() do -- hide the blocky stand-ins, keep them as colliders
		if d:IsA("BasePart") and not d:IsA("MeshPart") then
			d.Transparency = 1
			d.CastShadow = false
		end
	end
	model:SetAttribute("DetailedMesh", true)
	return true
end

function Builder.getSpec(key: string)
	return Specs.Vehicles[key]
end

function Builder.build(key: string, visualOnly: boolean?): Model
	local spec = Specs.Vehicles[key]
	assert(spec, "unknown vehicle " .. tostring(key))
	local model = Instance.new("Model")
	model.Name = key

	local parts: { [string]: BasePart } = {}
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, p in spec.parts do
		local part = makePart(p)
		parts[p.name] = part
		if p.collide then
			local half = v3(p.size) / 2
			lo, hi = lo:Min(v3(p.pos) - half), hi:Max(v3(p.pos) + half)
		end
	end
	for _, w in spec.wheels do
		local r = Vector3.new(w.width / 2, w.radius, w.radius)
		lo, hi = lo:Min(v3(w.pos) - r), hi:Max(v3(w.pos) + r)
	end

	-- Root: carries the mass, defines the crash-query box.
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = (hi - lo):Max(Vector3.new(2, 1, 2))
	root.CFrame = CFrame.new((lo + hi) / 2)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CollisionGroup = "Vehicle"
	local volume = root.Size.X * root.Size.Y * root.Size.Z
	root.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(spec.mass / volume, 0.01, 100), 0.2, 0.1, 1, 1)
	root.PivotOffset = root.CFrame:Inverse() -- model pivot = ground point under the vehicle centre
	root.Parent = model
	model.PrimaryPart = root

	local special: { [string]: boolean } = {}
	for _, sp in spec.spinners or {} do
		for _, n in sp.parts do
			special[n] = true
		end
	end
	for _, n in spec.turret or {} do
		special[n] = true
	end

	for name, part in parts do
		part.Parent = model
		if visualOnly then
			part.Anchored = true
		elseif not special[name] then
			weld(root, part)
		end
	end

	-- Wheels
	local wheelParts = {}
	for i, w in spec.wheels do
		local wheel = Instance.new("Part")
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Name = "Wheel" .. i
		wheel.Size = Vector3.new(w.width, w.radius * 2, w.radius * 2)
		wheel.CFrame = CFrame.new(v3(w.pos))
		wheel.Color = Color3.fromHex("#17181b")
		wheel.Material = Enum.Material.Rubber
		wheel.CanCollide = false
		wheel.CollisionGroup = "VehicleDecor"
		wheel.CustomPhysicalProperties = FEATHER
		wheel.Parent = model
		wheelParts[i] = wheel
		local rim = Instance.new("Part")
		rim.Shape = Enum.PartType.Cylinder
		rim.Name = "Rim"
		rim.Size = Vector3.new(w.width + 0.08, w.radius * 1.15, w.radius * 1.15)
		rim.CFrame = wheel.CFrame
		rim.Color = Color3.fromHex("#c9cdd3")
		rim.Material = Enum.Material.Metal
		rim.CanCollide = false
		rim.Massless = true
		rim.Parent = wheel
		local spoke = Instance.new("Part") -- a bar across the rim so the spin is visible
		spoke.Name = "Spoke"
		spoke.Size = Vector3.new(w.width + 0.14, w.radius * 1.1, w.radius * 0.22)
		spoke.CFrame = wheel.CFrame
		spoke.Color = Color3.fromHex("#30333a")
		spoke.CanCollide = false
		spoke.Massless = true
		spoke.Parent = wheel
		if visualOnly then
			wheel.Anchored, rim.Anchored, spoke.Anchored = true, true, true
		else
			weld(wheel, rim)
			weld(wheel, spoke)
			hinge(root, wheel, v3(w.pos), "x", "WheelHinge" .. i)
			local ball = Instance.new("Part")
			ball.Shape = Enum.PartType.Ball
			ball.Name = "WheelCollider"
			ball.Size = Vector3.one * w.radius * 2
			ball.CFrame = wheel.CFrame
			ball.Transparency = 1
			ball.Massless = true
			ball.CustomPhysicalProperties = NO_FRICTION
			ball.CollisionGroup = "Vehicle"
			ball.CanQuery = false
			ball.Parent = model
			weld(root, ball)
		end
	end

	if visualOnly then
		applyMeshes(model, key, root, parts, wheelParts, spec, true)
		return model
	end

	-- Propellers / rotors
	for i, sp in spec.spinners or {} do
		local hub = parts[sp.parts[1]]
		for j, n in sp.parts do
			local part = parts[n]
			part.CanCollide = false
			part.CollisionGroup = "VehicleDecor"
			part.Massless = j > 1
			part.CustomPhysicalProperties = FEATHER
			if j > 1 then
				weld(hub, part)
			end
		end
		hinge(root, hub, v3(sp.pivot), sp.axis, "Spinner" .. i)
	end

	-- Tank turret on a servo
	if spec.turret then
		local ring = parts[spec.turret[1]]
		for j, n in spec.turret do
			local part = parts[n]
			part.CollisionGroup = "VehicleDecor"
			part.Massless = j > 1
			if j > 1 then
				weld(ring, part)
			end
		end
		local h = hinge(root, ring, v3(spec.turretPivot), "y", "TurretHinge")
		h.ActuatorType = Enum.ActuatorType.Servo
		h.ServoMaxTorque = 1e7
		h.AngularSpeed = 1.2
		h.TargetAngle = 0
	end

	-- Headlights
	for name, part in parts do
		if string.find(name, "Headlight") or name == "Headlamp" then
			local light = Instance.new("SpotLight")
			light.Face = Enum.NormalId.Front
			light.Range = 60
			light.Brightness = 2
			light.Angle = 70
			light.Parent = part
		end
	end

	-- Driver seat (input only; the legacy VehicleSeat motors are disabled)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.6, 2)
	seat.CFrame = CFrame.new(v3(spec.seat))
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Massless = true
	seat.MaxSpeed, seat.Torque, seat.TurnSpeed = 0, 0, 0
	seat.HeadsUpDisplay = false
	seat.CollisionGroup = "VehicleDecor"
	seat.Parent = model
	weld(root, seat)

	-- Force handles the client drives.
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = root
	local drive = Instance.new("VectorForce")
	drive.Name = "Drive"
	drive.Attachment0 = center
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.ApplyAtCenterOfMass = true
	drive.Force = Vector3.zero
	drive.Parent = root
	local steer = Instance.new("Torque")
	steer.Name = "Steer"
	steer.Attachment0 = center
	steer.RelativeTo = Enum.ActuatorRelativeTo.World
	steer.Torque = Vector3.zero
	steer.Parent = root

	applyMeshes(model, key, root, parts, wheelParts, spec, false)
	model:SetAttribute("VehicleKey", key)
	model:SetAttribute("Kind", spec.phys.kind)
	model:SetAttribute("Display", spec.display)
	model:SetAttribute("Impact", spec.impact)
	return model
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">VehicleMeshInfo</string>
          <string name="Source"><![CDATA[--!nonstrict
-- GENERATED by blender/export_mesh_info.py - do not edit.
-- [objectName] = { centreX, centreY, centreZ, sizeX, sizeY, sizeZ } in studs, Roblox axes, vehicle origin on the ground.
return {
	Sedan = {
		Sedan_Body = { -0.001, 2.803, 0.000, 7.679, 4.222, 15.554 },
		Sedan_Glass = { -0.000, 3.848, 1.248, 6.443, 1.601, 7.679 },
		Sedan_Lights = { 0.000, 2.006, 0.004, 6.766, 1.877, 15.642 },
		Sedan_Trim = { -0.001, 2.390, 0.075, 7.499, 5.226, 15.810 },
		Sedan_Wheel1 = { -3.000, 1.250, -4.650, 1.060, 2.500, 2.500 },
		Sedan_Wheel2 = { 3.000, 1.250, -4.650, 1.060, 2.500, 2.500 },
		Sedan_Wheel3 = { -3.000, 1.250, 4.650, 1.060, 2.500, 2.500 },
		Sedan_Wheel4 = { 3.000, 1.250, 4.650, 1.060, 2.500, 2.500 },
	},
	SportsCar = {
		SportsCar_Body = { -0.001, 2.080, 0.000, 7.609, 3.197, 16.154 },
		SportsCar_Glass = { 0.000, 3.066, 1.793, 6.635, 1.124, 8.086 },
		SportsCar_Lights = { -0.000, 1.676, 0.009, 6.950, 1.713, 16.223 },
		SportsCar_Trim = { -0.001, 1.902, 0.076, 7.429, 4.256, 16.408 },
		SportsCar_Wheel1 = { -3.000, 1.150, -4.805, 1.272, 2.300, 2.300 },
		SportsCar_Wheel2 = { 3.000, 1.150, -4.805, 1.272, 2.300, 2.300 },
		SportsCar_Wheel3 = { -3.000, 1.150, 4.805, 1.272, 2.300, 2.300 },
		SportsCar_Wheel4 = { 3.000, 1.150, 4.805, 1.272, 2.300, 2.300 },
	},
	PoliceCar = {
		PoliceCar_Body = { 0.000, 2.824, 0.000, 7.078, 4.181, 15.954 },
		PoliceCar_Body2 = { -0.001, 3.220, -2.830, 7.678, 0.380, 0.260 },
		PoliceCar_Glass = { -0.000, 3.859, 1.253, 6.443, 1.583, 7.888 },
		PoliceCar_Lights = { 0.000, 3.276, 0.004, 6.766, 4.356, 16.042 },
		PoliceCar_Trim = { 0.000, 2.361, -0.130, 7.107, 5.166, 16.560 },
		PoliceCar_Trim2 = { -0.001, 3.054, -0.087, 7.498, 4.119, 16.535 },
		PoliceCar_Wheel1 = { -3.000, 1.250, -4.805, 1.060, 2.500, 2.500 },
		PoliceCar_Wheel2 = { 3.000, 1.250, -4.805, 1.060, 2.500, 2.500 },
		PoliceCar_Wheel3 = { -3.000, 1.250, 4.805, 1.060, 2.500, 2.500 },
		PoliceCar_Wheel4 = { 3.000, 1.250, 4.805, 1.060, 2.500, 2.500 },
	},
	MuscleCar = {
		MuscleCar_Body = { -0.002, 2.556, 0.000, 8.007, 3.840, 17.554 },
		MuscleCar_Glass = { 0.000, 3.740, 2.215, 6.817, 1.319, 7.930 },
		MuscleCar_Lights = { 0.000, 2.008, 0.012, 7.156, 1.978, 17.635 },
		MuscleCar_Trim = { -0.002, 2.232, 0.075, 7.827, 4.966, 17.811 },
		MuscleCar_Wheel1 = { -3.000, 1.400, -5.270, 1.484, 2.800, 2.800 },
		MuscleCar_Wheel2 = { 3.000, 1.400, -5.270, 1.484, 2.800, 2.800 },
		MuscleCar_Wheel3 = { -3.000, 1.400, 5.270, 1.484, 2.800, 2.800 },
		MuscleCar_Wheel4 = { 3.000, 1.400, 5.270, 1.484, 2.800, 2.800 },
	},
