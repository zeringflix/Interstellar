  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">CrashReportService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Turns verified hit records into (a) the live impact feed and (b) a per-crash report + score.
-- A "crash" is a burst of records; it closes after 3 quiet seconds. Every number in the report is
-- counted from DamageModel records / live dummy state - nothing is invented for display.
local RunService = game:GetService("RunService")
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.GameConfig)
local DamageModel = require(Shared.DamageModel)
local DummyService = require(script.Parent.DummyService)

local CrashReportService = {}
CrashReportService.last = nil
CrashReportService.history = {}
CrashReportService.reportListeners = {} :: { (any) -> () }

local remotes
local current = nil
local pending = {}
local lastScored = {} :: { [number]: number } -- dummy id -> time it last earned score

local function wire(record)
	return {
		id = record.id, display = record.display, region = DamageModel.REGION_LABEL[record.region],
		severity = record.severity, damage = record.damage, health = math.ceil(record.health),
		status = record.status, source = record.source, chain = record.chain, injury = record.injury,
		part = record.partLabel, blood = record.blood, bleeding = record.bleeding, dead = record.dead, condition = record.condition,
		mph = math.floor(record.relSpeed * Config.STUDS_PER_SEC_TO_MPH + 0.5), position = record.position,
	}
end

local function onRecord(record)
	local now = os.clock()
	table.insert(pending, wire(record))
	if not current then
		current = { start = now, vehicle = nil, topMph = 0, dummies = {}, hits = 0, chain = 0, score = 0, props = 0 }
	end
	current.lastTime = now
	current.hits += 1
	if not record.chain then
		current.vehicle = current.vehicle or record.source
		current.topMph = math.max(current.topMph, record.relSpeed * Config.STUDS_PER_SEC_TO_MPH)
	end
	-- Score: full value the first time a dummy is hit in a crash; repeat taps inside the window earn nothing.
	local S = Config.Score
	local first = not current.dummies[record.id]
	current.dummies[record.id] = true
	local recently = lastScored[record.id] and (now - lastScored[record.id]) < S.REPEAT_WINDOW
	if first and not (recently and record.severity == "LIGHT") then
		current.score += S[record.severity] or 0
		lastScored[record.id] = now
	end
	if record.chain and first then
		current.chain += 1
		current.score += S.CHAIN
	end
end

local function close()
	local c = current
	current = nil
	local now = os.clock()
	local report = { vehicle = c.vehicle or "Chain Reaction", mph = math.floor(c.topMph + 0.5), hit = 0,
		down = 0, unconscious = 0, dead = 0, chain = c.chain, props = 0, score = 0 }
	for id in c.dummies do
		report.hit += 1
		local d = DummyService.dummies[id]
		if d then
			local s = d.state
			if s.dead then
				report.dead += 1
			elseif DamageModel.isUnconscious(s, now) then
				report.unconscious += 1
			elseif s.ragdolled then
				report.down += 1
			end
		end
	end
	if CrashReportService.countDisturbedProps then
		report.props = CrashReportService.countDisturbedProps()
	end
	report.score = c.score + report.props * Config.Score.PROP
	if report.hit == 0 then
		return
	end
	CrashReportService.last = report
	table.insert(CrashReportService.history, report)
	if #CrashReportService.history > 10 then
		table.remove(CrashReportService.history, 1)
	end
	report.byVehicle = c.vehicle ~= nil -- only crashes a vehicle started earn crash points
	for _, fn in CrashReportService.reportListeners do
		fn(report)
	end
	remotes.Report:FireAllClients(report)
end

function CrashReportService.init(r)
	remotes = r
	table.insert(DummyService.recordListeners, onRecord)
	RunService.Heartbeat:Connect(function()
		if #pending > 0 then
			remotes.Impact:FireAllClients(pending)
			pending = {}
		end
		if current and os.clock() - current.lastTime > 3 then
			close()
		end
	end)
end

return CrashReportService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DummyRig</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Builds the blocky articulated dummy. Proportions are classic 2x2x1-torso Roblox (R6 silhouette)
-- but with 15 R15-named parts, so it has real elbows / knees for ragdolling and still plays the
-- stock R15 animations. Every joint gets a Motor6D (standing) AND a disabled physics constraint
-- (ragdoll); RagdollService swaps between them.
local Config = require(game.ReplicatedStorage.Shared.GameConfig)

local DummyRig = {}

-- name, size, centre (relative to torso centre), colour slot
local PARTS = {
	{ "LowerTorso", Vector3.new(2, 0.8, 1), Vector3.new(0, -0.6, 0), "torso" },
	{ "UpperTorso", Vector3.new(2, 1.2, 1), Vector3.new(0, 0.4, 0), "torso" },
	{ "Head", Vector3.new(1.25, 1.25, 1.25), Vector3.new(0, 1.625, 0), "head" },
	{ "LeftUpperArm", Vector3.new(1, 1, 1), Vector3.new(-1.5, 0.5, 0), "arms" },
	{ "LeftLowerArm", Vector3.new(1, 0.7, 1), Vector3.new(-1.5, -0.35, 0), "arms" },
	{ "LeftHand", Vector3.new(1, 0.3, 1), Vector3.new(-1.5, -0.85, 0), "arms" },
	{ "RightUpperArm", Vector3.new(1, 1, 1), Vector3.new(1.5, 0.5, 0), "arms" },
	{ "RightLowerArm", Vector3.new(1, 0.7, 1), Vector3.new(1.5, -0.35, 0), "arms" },
	{ "RightHand", Vector3.new(1, 0.3, 1), Vector3.new(1.5, -0.85, 0), "arms" },
	{ "LeftUpperLeg", Vector3.new(1, 1, 1), Vector3.new(-0.5, -1.5, 0), "legs" },
	{ "LeftLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(-0.5, -2.35, 0), "legs" },
	{ "LeftFoot", Vector3.new(1, 0.3, 1), Vector3.new(-0.5, -2.85, 0), "legs" },
	{ "RightUpperLeg", Vector3.new(1, 1, 1), Vector3.new(0.5, -1.5, 0), "legs" },
	{ "RightLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(0.5, -2.35, 0), "legs" },
	{ "RightFoot", Vector3.new(1, 0.3, 1), Vector3.new(0.5, -2.85, 0), "legs" },
}

local DOWN = CFrame.Angles(0, 0, math.rad(-90)) -- attachment X axis pointing down the limb
local UP = CFrame.Angles(0, 0, math.rad(90))

-- motor name, part0, part1, joint position, constraint kind, limits
local JOINTS = {
	{ "Root", "HumanoidRootPart", "LowerTorso", Vector3.new(0, -0.6, 0) },
	{ "Waist", "LowerTorso", "UpperTorso", Vector3.new(0, -0.2, 0), "ball", UP, 25, 20 },
	{ "Neck", "UpperTorso", "Head", Vector3.new(0, 1, 0), "ball", UP, 45, 50 },
	{ "LeftShoulder", "UpperTorso", "LeftUpperArm", Vector3.new(-1.25, 0.8, 0), "ball", DOWN, 110, 60 },
	{ "LeftElbow", "LeftUpperArm", "LeftLowerArm", Vector3.new(-1.5, 0, 0), "hinge", 0, 140 },
	{ "LeftWrist", "LeftLowerArm", "LeftHand", Vector3.new(-1.5, -0.7, 0), "ball", DOWN, 30, 20 },
	{ "RightShoulder", "UpperTorso", "RightUpperArm", Vector3.new(1.25, 0.8, 0), "ball", DOWN, 110, 60 },
	{ "RightElbow", "RightUpperArm", "RightLowerArm", Vector3.new(1.5, 0, 0), "hinge", 0, 140 },
	{ "RightWrist", "RightLowerArm", "RightHand", Vector3.new(1.5, -0.7, 0), "ball", DOWN, 30, 20 },
	{ "LeftHip", "LowerTorso", "LeftUpperLeg", Vector3.new(-0.5, -1, 0), "ball", DOWN, 75, 30 },
	{ "LeftKnee", "LeftUpperLeg", "LeftLowerLeg", Vector3.new(-0.5, -2, 0), "hinge", -140, 0 },
	{ "LeftAnkle", "LeftLowerLeg", "LeftFoot", Vector3.new(-0.5, -2.7, 0), "ball", DOWN, 30, 20 },
	{ "RightHip", "LowerTorso", "RightUpperLeg", Vector3.new(0.5, -1, 0), "ball", DOWN, 75, 30 },
	{ "RightKnee", "RightUpperLeg", "RightLowerLeg", Vector3.new(0.5, -2, 0), "hinge", -140, 0 },
	{ "RightAnkle", "RightLowerLeg", "RightFoot", Vector3.new(0.5, -2.7, 0), "ball", DOWN, 30, 20 },
}
local EXTRA_NO_COLLIDE = {
	{ "LeftUpperLeg", "RightUpperLeg" }, { "LeftUpperArm", "LowerTorso" }, { "RightUpperArm", "LowerTorso" },
	{ "LeftUpperLeg", "UpperTorso" }, { "RightUpperLeg", "UpperTorso" }, { "Head", "LowerTorso" },
	{ "LeftLowerArm", "UpperTorso" }, { "RightLowerArm", "UpperTorso" },
}

DummyRig.HIP_HEIGHT = 2 -- root bottom (-1) to sole (-3), before scale

local function noCollide(a: BasePart, b: BasePart)
	local n = Instance.new("NoCollisionConstraint")
	n.Part0, n.Part1 = a, b
	n.Parent = a
end

local function buildBlocky(typeName: string, id: number): Model
	local t = Config.DummyTypes[typeName] or Config.DummyTypes.Noob
	local s = t.scale
	local model = Instance.new("Model")
	model.Name = "Dummy" .. id
	local props = PhysicalProperties.new(t.density, 0.5, 0.15, 1, 1)
	local parts: { [string]: BasePart } = {}

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.CanCollide = false
	root.RootPriority = 127
	root.CustomPhysicalProperties = props
	root.CollisionGroup = "Dummy"
	root.Parent = model
	parts.HumanoidRootPart = root

	for _, def in PARTS do
		local p = Instance.new("Part")
		p.Name = def[1]
		p.Size = def[2] * s
		p.CFrame = CFrame.new(def[3] * s)
		p.Color = Color3.fromHex(t.colors[def[4]])
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.CustomPhysicalProperties = props
		p.CollisionGroup = "Dummy"
		p.Parent = model
		parts[def[1]] = p
	end

	for _, j in JOINTS do
		local p0, p1 = parts[j[2]], parts[j[3]]
		local world = CFrame.new(j[4] * s)
		local m = Instance.new("Motor6D")
		m.Name = j[1]
		m.Part0, m.Part1 = p0, p1
		m.C0, m.C1 = p0.CFrame:ToObjectSpace(world), p1.CFrame:ToObjectSpace(world)
		m.Parent = p1
		if j[5] then
			local orient = if j[5] == "ball" then j[6] else CFrame.identity
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.Name, a1.Name = j[1] .. "RigAttachment0", j[1] .. "RigAttachment1"
			a0.CFrame = p0.CFrame:ToObjectSpace(world * orient)
			a1.CFrame = p1.CFrame:ToObjectSpace(world * orient)
			a0.Parent, a1.Parent = p0, p1
			local c
			if j[5] == "ball" then
				local b = Instance.new("BallSocketConstraint")
				b.LimitsEnabled, b.UpperAngle = true, j[7]
				b.TwistLimitsEnabled, b.TwistLowerAngle, b.TwistUpperAngle = true, -j[8], j[8]
				b.MaxFrictionTorque = 6 * s -- a little joint stiffness so limbs don't flop like string
				c = b
			else
				local h = Instance.new("HingeConstraint")
				h.LimitsEnabled, h.LowerAngle, h.UpperAngle = true, j[6], j[7]
				c = h
			end
			c.Name = j[1] .. "Ragdoll"
			c.Attachment0, c.Attachment1 = a0, a1
			c.Enabled = false
			c.Parent = p1
			noCollide(p0, p1)
		end
	end
	for _, pair in EXTRA_NO_COLLIDE do
		noCollide(parts[pair[1]], parts[pair[2]])
	end

	if t.markings then -- crash-test target discs
		for _, spec in { { "UpperTorso", Enum.NormalId.Front }, { "Head", Enum.NormalId.Left }, { "Head", Enum.NormalId.Right } } do
			local g = Instance.new("SurfaceGui")
			g.Name = "TestMark"
			g.Face = spec[2]
			g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			g.PixelsPerStud = 40
			g.Parent = parts[spec[1]]
			local outer = Instance.new("Frame")
			outer.AnchorPoint, outer.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
			outer.Size = UDim2.fromOffset(30, 30)
			outer.BackgroundColor3 = Color3.fromHex("#ffd21a")
			outer.Parent = g
			Instance.new("UICorner", outer).CornerRadius = UDim.new(1, 0)
			for q = 0, 1 do
				local quad = Instance.new("Frame")
				quad.Size = UDim2.fromScale(0.5, 0.5)
				quad.Position = UDim2.fromScale(q * 0.5, q * 0.5)
				quad.BackgroundColor3 = Color3.fromHex("#111111")
				quad.BorderSizePixel = 0
				quad.Parent = outer
			end
		end
	end
	if t.armorKit then
		for _, a in { { "UpperTorso", Vector3.new(2.25, 1.3, 1.25), "#2b2e31" }, { "Head", Vector3.new(1.4, 0.75, 1.4), "#2b2e31", Vector3.new(0, 0.38, 0) } } do
			local host = parts[a[1]]
			local plate = Instance.new("Part")
			plate.Name = "Armor"
			plate.Size = a[2] * s
			plate.CFrame = host.CFrame * CFrame.new((a[4] or Vector3.zero) * s)
			plate.Color = Color3.fromHex(a[3])
			plate.Material = Enum.Material.Metal
			plate.Massless, plate.CanCollide = true, false
			plate.CollisionGroup = "Dummy"
			plate.Parent = host
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = host, plate
			w.Parent = plate
		end
	end

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.AutomaticScalingEnabled = false
	hum.HipHeight = DummyRig.HIP_HEIGHT * s
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth, hum.Health = 1e6, 1e6 -- real health lives in DamageService
	hum.WalkSpeed = 8
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	hum.Parent = model
	Instance.new("Animator", hum)

	model.PrimaryPart = root
	model:SetAttribute("DummyId", id)
	model:SetAttribute("DummyType", typeName)
	model:SetAttribute("Display", t.display)
	model:SetAttribute("Scale", s)
	model:SetAttribute("Body", "Blocky")
	return model
end
DummyRig.buildBlocky = buildBlocky

-- ---------------------------------------------------------------------------------------------
-- Catalog-avatar dummies (default): a real R15 rig with the Robloxian 2.0 (or Man) body and the
-- animatable Man head, all grey. Built once per dummy type, then cloned for every spawn.
-- Ragdoll joints are made from the rig's own <Joint>RigAttachment pairs.
local BALL = { -- UpperAngle (cone about the sideways axis), twist lower / upper (swing forward / back)
	Neck = { 40, -40, 40 }, Waist = { 20, -30, 20 }, Shoulder = { 80, -160, 60 }, Hip = { 40, -95, 40 },
	Wrist = { 20, -30, 30 }, Ankle = { 20, -30, 30 },
}
local HINGE = { Elbow = { 0, 140 }, Knee = { -140, 0 } }

local function addRagdollJoints(model: Model, stiffness: number)
	for _, m in model:GetDescendants() do
		if m:IsA("Motor6D") and m.Name ~= "Root" and m.Part0 and m.Part1 then
			local p0, p1 = m.Part0 :: BasePart, m.Part1 :: BasePart
			local a0 = p0:FindFirstChild(m.Name .. "RigAttachment")
			local a1 = p1:FindFirstChild(m.Name .. "RigAttachment")
			if a0 and a1 and a0:IsA("Attachment") and a1:IsA("Attachment") then
				local kind = string.gsub(string.gsub(m.Name, "^Left", ""), "^Right", "")
				local c: Constraint
				if HINGE[kind] then
					local h = Instance.new("HingeConstraint")
					h.LimitsEnabled, h.LowerAngle, h.UpperAngle = true, HINGE[kind][1], HINGE[kind][2]
					c = h
				else
					local lim = BALL[kind] or BALL.Wrist
					local b = Instance.new("BallSocketConstraint")
					b.LimitsEnabled, b.UpperAngle = true, lim[1]
					b.TwistLimitsEnabled, b.TwistLowerAngle, b.TwistUpperAngle = true, lim[2], lim[3]
					b.MaxFrictionTorque = stiffness
					c = b
				end
				c.Name = m.Name .. "Ragdoll"
				c.Attachment0, c.Attachment1 = a0, a1
				c.Enabled = false
				c.Parent = p1
				noCollide(p0, p1)
			end
		end
	end
	for _, pair in EXTRA_NO_COLLIDE do
		local a, b = model:FindFirstChild(pair[1]), model:FindFirstChild(pair[2])
		if a and b then
			noCollide(a :: BasePart, b :: BasePart)
		end
	end
end

local function buildAvatar(typeName: string): Model?
	local t = Config.DummyTypes[typeName] or Config.DummyTypes.Noob
	local body = Config.Bodies[Config.DummyBody]
	if not body or Config.DummyBody == "Blocky" then
		return nil
	end
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.Torso, desc.RightArm, desc.LeftArm = body.Torso, body.RightArm, body.LeftArm
		desc.LeftLeg, desc.RightLeg = body.LeftLeg, body.RightLeg
		desc.Head = Config.MAN_DYNAMIC_HEAD
		local grey = Color3.fromHex(t.colors.head)
		desc.HeadColor, desc.TorsoColor = grey, grey
		desc.LeftArmColor, desc.RightArmColor, desc.LeftLegColor, desc.RightLegColor = grey, grey, grey, grey
		desc.HeightScale, desc.WidthScale, desc.DepthScale, desc.HeadScale = t.scale, t.scale, t.scale, t.scale
		return game:GetService("Players"):CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model or not model:FindFirstChild("UpperTorso") or not model:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	local props = PhysicalProperties.new(t.density, 0.5, 0.15, 1, 1)
	for _, d in model:GetDescendants() do
		if d:IsA("LuaSourceContainer") or d:IsA("Accessory") or d:IsA("Clothing") or d:IsA("ShirtGraphic") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CustomPhysicalProperties = props
			d.CollisionGroup = "Dummy"
			d.Color = Color3.fromHex(t.colors.head)
			d.Anchored = false
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.RootPriority = 127
	model.PrimaryPart = root
	addRagdollJoints(model, 6 * t.scale)
	if t.armorKit then
		local torso = model:FindFirstChild("UpperTorso") :: BasePart
		local plate = Instance.new("Part")
		plate.Name = "Armor"
		plate.Size = torso.Size + Vector3.new(0.25, 0.1, 0.25)
		plate.CFrame = torso.CFrame
		plate.Color = Color3.fromHex("#2b2e31")
		plate.Material = Enum.Material.Metal
		plate.Massless, plate.CanCollide = true, false
		plate.CollisionGroup = "Dummy"
		plate.Parent = torso
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = torso, plate
		w.Parent = plate
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth, hum.Health = 1e6, 1e6
	hum.WalkSpeed = 8
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	if not hum:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = hum
	end
	model:SetAttribute("Scale", t.scale)
	model:SetAttribute("Body", Config.DummyBody)
	model:SetAttribute("DummyType", typeName)
	model:SetAttribute("Display", t.display)
	return model
end

local templates = {} :: { [string]: Model | boolean }

-- Yields the first time a type is requested (the avatar is fetched from Roblox); instant afterwards.
function DummyRig.build(typeName: string, id: number): Model
	local key = Config.DummyBody .. ":" .. typeName
	if templates[key] == nil then
		templates[key] = buildAvatar(typeName) or false
	end
	local template = templates[key]
	if template then
		local model = (template :: Model):Clone()
		model.Name = "Dummy" .. id
		model:SetAttribute("DummyId", id)
		return model
	end
	return buildBlocky(typeName, id) -- offline / asset failure fallback: the part-built blocky dummy
end

return DummyRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DummyService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Owns every dummy: spawn / remove / reset / revive, the per-dummy state (through DamageModel),
-- physical reactions to validated hits, recovery, crawling, limping and safety resets.
local RunService = game:GetService("RunService")
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.GameConfig)
local DamageModel = require(Shared.DamageModel)
local DummyRig = require(script.Parent.DummyRig)
local RagdollService = require(script.Parent.RagdollService)

local DummyService = {}
DummyService.dummies = {} :: { [number]: any }
DummyService.limit = Config.DUMMY_LIMITS.Automatic
DummyService.recordListeners = {} :: { (any) -> () }

local folder: Folder
local nextId = 1
local IDLE_ANIM, WALK_ANIM = "rbxassetid://507766388", "rbxassetid://507777826" -- stock Roblox R15 idle / walk
local rng = Random.new()

local function count(): number
	local n = 0
	for _ in DummyService.dummies do
		n += 1
	end
	return n
end
DummyService.count = count

local function publish(d, now: number)
	local s, m = d.state, d.model
	local text = DamageModel.statusText(s, now)
	if m:GetAttribute("Status") ~= text then
		m:SetAttribute("Status", text)
		m:SetAttribute("StatusPrimary", DamageModel.statusList(s, now)[1])
	end
	local hp = math.ceil(s.health)
	if m:GetAttribute("Health") ~= hp then
		m:SetAttribute("Health", hp)
	end
	local face = DamageModel.face(s, now)
	if m:GetAttribute("Face") ~= face then
		m:SetAttribute("Face", face)
	end
	for _, r in DamageModel.REGIONS do
		local v = math.floor(s.regions[r] * 100 + 0.5)
		if m:GetAttribute("Cond" .. r) ~= v then
			m:SetAttribute("Cond" .. r, v)
		end
	end
	local blood = math.floor(s.blood + 0.5)
	if m:GetAttribute("Blood") ~= blood then
		m:SetAttribute("Blood", blood)
	end
	local cond = DamageModel.condition(s, now)
	if m:GetAttribute("Condition") ~= cond then
		m:SetAttribute("Condition", cond)
	end
	m:SetAttribute("LastSource", s.lastSource)
	m:SetAttribute("LastSpeedMph", math.floor(s.lastSpeed * Config.STUDS_PER_SEC_TO_MPH + 0.5))
	m:SetAttribute("LastRegion", s.lastRegion)
end

function DummyService.init()
	folder = Instance.new("Folder")
	folder.Name = "Dummies"
	folder.Parent = workspace
	DummyService.folder = folder
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.05 then
			DummyService.update(acc)
			acc = 0
		end
	end)
end

function DummyService.spawn(typeName: string, cf: CFrame, tag: string?): any?
	if count() >= DummyService.limit then
		return nil
	end
	typeName = if Config.DummyTypes[typeName] then typeName else "Noob"
	local id = nextId
	nextId += 1
	local model = DummyRig.build(typeName, id)
	if not folder.Parent then
		model:Destroy()
		return nil
	end
	local hum0 = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local rootPart = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hip = hum0.HipHeight
	-- cf is a ground point; lift the root so the feet rest on it
	local standCF = cf * CFrame.new(0, hip + rootPart.Size.Y / 2, 0)
	model:PivotTo(standCF)
	model.Parent = folder
	RagdollService.serverOwn(model)
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local animator = hum:FindFirstChildOfClass("Animator") :: Animator
	local tracks = {}
	for name, animId in { idle = IDLE_ANIM, walk = WALK_ANIM } do
		local a = Instance.new("Animation")
		a.AnimationId = animId
		local ok, track = pcall(function()
			return animator:LoadAnimation(a)
		end)
		if ok then
			track.Looped = true
			tracks[name] = track
		end
	end
	if tracks.idle then
		tracks.idle:Play()
	end
	local d = {
		id = id, model = model, hum = hum, root = model.HumanoidRootPart, torso = model.UpperTorso,
		state = DamageModel.newState(id, typeName), typeName = typeName, spawnCF = cf, hip = hip, tag = tag,
		tracks = tracks, lastVel = Vector3.zero, lastVehicleHit = -math.huge, airTime = 0, nextCrawl = 0,
		nextWander = 0, staggerOn = false, prevPrimary = "HEALTHY",
	}
	DummyService.dummies[id] = d
	publish(d, os.clock())
	return d
end

function DummyService.remove(id: number)
	local d = DummyService.dummies[id]
	if d then
		DummyService.dummies[id] = nil
		d.model:Destroy()
	end
end

function DummyService.clear()
	for id in DummyService.dummies do
		DummyService.remove(id)
	end
end

-- Rebuilds the dummy from scratch at its spawn point: the most reliable way to guarantee a valid rig.
function DummyService.reset(id: number)
	local d = DummyService.dummies[id]
	if not d then
		return
	end
	local typeName, cf, tag = d.typeName, d.spawnCF, d.tag
	DummyService.remove(id)
	local n = DummyService.spawn(typeName, cf, tag)
	return n
end

function DummyService.resetAll()
	local list = {}
	for id in DummyService.dummies do
		table.insert(list, id)
	end
	for _, id in list do
		DummyService.reset(id)
	end
end

function DummyService.revive(id: number): boolean
	local d = DummyService.dummies[id]
	if not d then
		return false
	end
	local now = os.clock()
	DamageModel.revive(d.state, now)
	if d.state.ragdolled then
		if RagdollService.disable(d.model, d.hip) then
			d.state.ragdolled = false
		else
			DummyService.reset(id) -- no ground under it: fall back to a clean respawn
			return true
		end
	else
		RagdollService.endStagger(d.model)
	end
	d.model:SetAttribute("ReviveFx", now)
	publish(d, now)
	return true
end

function DummyService.setLimit(mode: string, mobile: boolean)
	local n = Config.DUMMY_LIMITS[mode] or Config.DUMMY_LIMITS.Automatic
	if mode == "Automatic" and mobile then
		n = Config.MOBILE_DUMMY_LIMIT
	end
	DummyService.limit = n
end

-- Force a ragdoll without damage (used by the grab tool and by falls off platforms).
function DummyService.knockDown(d, seconds: number)
	if d.state.dead or d.state.ragdolled then
		return
	end
	d.state.ragdolled = true
	d.state.downUntil = math.max(d.state.downUntil, os.clock() + seconds)
	RagdollService.enable(d.model)
end

local function applyKnock(d, hit, record)
	local model = d.model
	local I = Config.Impact
	local speed = math.min(hit.relSpeed, I.MAX_IMPULSE_SPEED)
	local dir = if hit.relVelocity.Magnitude > 0.1 then hit.relVelocity.Unit else Vector3.new(0, 0, -1)
	if record.reaction == "RAGDOLL" then
		RagdollService.enable(model)
		-- The body picks up most of the striker's velocity; the struck limb gets all of it plus spin.
		local carry = dir * speed * math.clamp(0.55 + 0.25 * (hit.vehicleImpact or 1), 0.5, 1.15)
			+ Vector3.new(0, speed * 0.16, 0)
		for _, p in model:GetChildren() do
			if p:IsA("BasePart") and p.AssemblyRootPart == p then
				local target = carry
				if hit.part and (p == hit.part or hit.part:IsDescendantOf(p)) then
					target = dir * speed * 1.15 + Vector3.new(0, speed * 0.1, 0)
				end
				local dv = target - p.AssemblyLinearVelocity
				p:ApplyImpulse(dv * p.AssemblyMass)
			end
		end
		if hit.part and hit.part.Parent == model then
			-- off-centre hits spin the dummy: torque from where it was struck relative to the torso
			local arm = hit.part.Position - d.torso.Position
			local spin = arm:Cross(dir) * speed * 0.12
			d.torso:ApplyAngularImpulse(spin * d.torso.AssemblyMass)
		end
	else
		RagdollService.stagger(model)
		d.staggerOn = true
		d.root:ApplyImpulse(dir * speed * 0.6 * d.root.AssemblyMass)
	end
end

-- The single entry point for damage. hit = { part, relVelocity, relSpeed, vehicleImpact, source, chain }
-- Returns the DamageModel record (or nil when ignored).
function DummyService.hit(id: number, hit)
	local d = DummyService.dummies[id]
	if not d then
		return nil
	end
	local now = os.clock()
	hit.partName = if hit.part then hit.part.Name else "UpperTorso"
	hit.region = DamageModel.regionOf(hit.partName)
	local record = DamageModel.applyHit(d.state, hit, now)
	if record.ignored then
		return nil
	end
	if not hit.chain then
		d.lastVehicleHit = now
	end
	applyKnock(d, hit, record)
	d.lastVel = d.torso.AssemblyLinearVelocity
	d.skipVelCheckUntil = now + 0.3
	publish(d, now)
	record.status = d.model:GetAttribute("Status")
	record.condition = d.model:GetAttribute("Condition")
	record.display = d.model:GetAttribute("Display")
	record.position = d.torso.Position
	for _, fn in DummyService.recordListeners do
		fn(record)
	end
	return record
end

local function valid(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude < 5000
end

function DummyService.update(dt: number)
	local now = os.clock()
	local bound = Config.Map.SIZE * 1.6
	local toReset = {}
	for id, d in DummyService.dummies do
		local s, model = d.state, d.model
		if not model.Parent or not d.torso.Parent then
			table.insert(toReset, id)
			continue
		end
		local pos, vel = d.torso.Position, d.torso.AssemblyLinearVelocity
		-- Safety net: fell out of the world, left the map or developed an invalid physics state.
		if not valid(pos) or not valid(vel) or pos.Y < -60 or math.abs(pos.X) > bound or math.abs(pos.Z) > bound then
			table.insert(toReset, id)
			continue
		end

		DamageModel.tick(s, dt, now)
		if s.ragdolled and not RagdollService.isRagdolled(model) then
			RagdollService.enable(model) -- passed out from blood loss
		end

		if s.ragdolled then
			-- Hard landings / secondary collisions while tumbling.
			local dv = (vel - d.lastVel).Magnitude
			if dv > 38 and now > (d.skipVelCheckUntil or 0) and not s.dead then
				DummyService.hit(id, { part = d.torso, relVelocity = d.lastVel, relSpeed = dv * 0.5,
					vehicleImpact = 0.8, source = "Hard Landing", chain = true })
			end
			if DamageModel.canRecover(s, now) and vel.Magnitude < 3 then
				if RagdollService.disable(model, d.hip) then
					s.ragdolled = false
					s.recoveringUntil = now + Config.Damage.RECOVER_TIME
				end
			elseif not s.dead and not DamageModel.isUnconscious(s, now) and not DamageModel.canStand(s)
				and now >= d.nextCrawl and vel.Magnitude < 6 then
				-- CRAWLING: drag the upper body forward in small physical pulls.
				d.nextCrawl = now + 0.9
				local fwd = d.torso.CFrame.UpVector * Vector3.new(1, 0, 1)
				if fwd.Magnitude > 0.2 then
					d.torso:ApplyImpulse((fwd.Unit * 7 + Vector3.new(0, 3, 0)) * d.torso.AssemblyMass)
				end
			end
		else
			-- Standing dummies knocked by flying bodies / props (chain reactions).
			local horiz = (d.root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
			if horiz > d.hum.WalkSpeed + 14 and now - d.lastVehicleHit > 0.5 and now > (d.skipVelCheckUntil or 0) then
				DummyService.hit(id, { part = d.torso, relVelocity = d.root.AssemblyLinearVelocity, relSpeed = horiz * 1.2,
					vehicleImpact = 1, source = "Collision", chain = true })
			end
			-- Knocked off a platform: go limp, the landing does the damage.
			local falling = d.hum:GetState() == Enum.HumanoidStateType.Freefall
			d.airTime = if falling then d.airTime + dt else 0
			if d.airTime > 0.55 or d.root.AssemblyLinearVelocity.Y < -55 then
				d.airTime = 0
				DummyService.knockDown(d, 2)
			end
			if d.staggerOn and now >= s.staggerUntil then
				d.staggerOn = false
				RagdollService.endStagger(model)
			end
			-- LIMPING dummies shuffle around their spot; healthy ones hold position for clean tests.
			local limping = (s.regions.LeftLeg < 0.5 or s.regions.RightLeg < 0.5) and now >= s.recoveringUntil
			d.hum.WalkSpeed = if limping then 4 else 8
			if limping and now >= d.nextWander then
				d.nextWander = now + rng:NextNumber(3, 6)
				local home = d.spawnCF.Position
				d.hum:MoveTo(home + Vector3.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8)))
			end
			local moving = d.hum.MoveDirection.Magnitude > 0.1
			if d.tracks.walk then
				if moving and not d.tracks.walk.IsPlaying then
					d.tracks.walk:Play(0.2, 1, 0.55)
				elseif not moving and d.tracks.walk.IsPlaying then
					d.tracks.walk:Stop(0.2)
				end
			end
		end
		d.lastVel = d.torso.AssemblyLinearVelocity
		publish(d, now)
	end
	for _, id in toReset do
		DummyService.reset(id)
	end
end

return DummyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ImpactService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Server-side vehicle -> dummy collision detection.
-- Every physics step each moving vehicle sweeps an oriented box (its bounds, padded and stretched
-- along its velocity so fast vehicles cannot tunnel past a dummy between frames) against the
-- Dummies folder only. A hit is registered once per contact: the contact has to break for
-- CONTACT_BREAK_TIME before the same vehicle can damage the same dummy again, so a car resting
-- on or pushing a dummy never deals damage every frame.
local RunService = game:GetService("RunService")
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.GameConfig)
local Specs = require(Shared.VehicleSpecs)
local DummyService = require(script.Parent.DummyService)

local ImpactService = {}
ImpactService.vehicleCrashListeners = {} :: { (Model, number, Vector3) -> () }

local contacts = {} :: { [Model]: { [number]: { seen: number, hit: number } } }
local lastVel = {} :: { [Model]: Vector3 }
local params = OverlapParams.new()
params.FilterType = Enum.RaycastFilterType.Include

-- Closest point on an oriented box to a world point.
local function closestOnBox(cf: CFrame, size: Vector3, point: Vector3): Vector3
	local l = cf:PointToObjectSpace(point)
	local h = size / 2
	return cf:PointToWorldSpace(Vector3.new(math.clamp(l.X, -h.X, h.X), math.clamp(l.Y, -h.Y, h.Y), math.clamp(l.Z, -h.Z, h.Z)))
end

local function processVehicle(vehicle: Model, dt: number, now: number, batch)
	local root = vehicle.PrimaryPart
	if not root then
		return
	end
	local key = vehicle:GetAttribute("VehicleKey")
	local spec = Specs.Vehicles[key]
	local vel = root.AssemblyLinearVelocity
	local speed = vel.Magnitude
	-- sanity clamp: a client-owned vehicle can never report more than 1.6x its top speed
	local maxSpeed = spec.phys.maxSpeed * 1.6 + 30
	if speed > maxSpeed then
		vel = vel.Unit * maxSpeed
		speed = maxSpeed
	end

	-- Vehicle-vs-world crash: a big velocity change in one step.
	local prev = lastVel[vehicle]
	lastVel[vehicle] = vel
	if prev then
		local dv = (vel - prev).Magnitude
		if dv > 22 and prev.Magnitude > vel.Magnitude then
			for _, fn in ImpactService.vehicleCrashListeners do
				fn(vehicle, dv, root.Position)
			end
		end
	end

	local vc = contacts[vehicle]
	if not vc then
		vc = {}
		contacts[vehicle] = vc
	end
	if speed < 2 and next(vc) == nil then
		return
	end

	local pad = Config.Impact.QUERY_PADDING
	local sweep = speed * dt
	local dirLocal = if speed > 0.5 then root.CFrame:VectorToObjectSpace(vel.Unit) else Vector3.zero
	local size = root.Size + Vector3.one * pad * 2
		+ Vector3.new(math.abs(dirLocal.X), math.abs(dirLocal.Y), math.abs(dirLocal.Z)) * sweep
	local cf = root.CFrame + vel * dt * 0.5
	local found = workspace:GetPartBoundsInBox(cf, size, params)

	-- group overlapping parts by dummy, keeping the part nearest the vehicle's main body
	local body = vehicle:FindFirstChild(spec.parts[1].name) :: BasePart? or root
	local nearest = {} :: { [number]: { part: BasePart, dist: number } }
	for _, part in found do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and model.Parent ~= DummyService.folder do
			model = model:FindFirstAncestorOfClass("Model")
		end
		local id = model and model:GetAttribute("DummyId")
		if id and part.Name ~= "HumanoidRootPart" then
			local dist = (part.Position - closestOnBox(body.CFrame, body.Size, part.Position)).Magnitude
			local cur = nearest[id]
			if not cur or dist < cur.dist then
				nearest[id] = { part = part, dist = dist }
			end
		end
	end

	for id, n in nearest do
		local d = DummyService.dummies[id]
		if not d then
			continue
		end
		local c = vc[id]
		local wasSeen = c and c.seen or -math.huge
		if not c then
			c = { seen = now, hit = -math.huge }
			vc[id] = c
		end
		c.seen = now
		local relVel = vel - n.part.AssemblyLinearVelocity
		local relSpeed = relVel.Magnitude
		local toDummy = n.part.Position - root.Position
		local closing = relVel:Dot(toDummy) > 0
		local fresh = (now - wasSeen) > Config.Impact.CONTACT_BREAK_TIME
		if closing and fresh and relSpeed >= Config.Impact.MIN_SPEED and (now - c.hit) >= Config.Impact.MIN_REHIT_TIME then
			c.hit = now
			local record = DummyService.hit(id, {
				part = n.part, relVelocity = relVel, relSpeed = relSpeed,
				vehicleImpact = spec.impact, source = spec.display, chain = false,
			})
			if record then
				record.vehicle = key
				table.insert(batch, record)
			end
		end
	end
	for id, c in vc do
		if now - c.seen > 3 then
			vc[id] = nil
		end
	end
end

function ImpactService.init(vehicleFolder: Folder)
	params.FilterDescendantsInstances = { DummyService.folder }
	vehicleFolder.ChildRemoved:Connect(function(v)
		contacts[v :: Model] = nil
		lastVel[v :: Model] = nil
	end)
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		local batch = {}
		for _, vehicle in vehicleFolder:GetChildren() do
			if vehicle:IsA("Model") then
				processVehicle(vehicle, dt, now, batch)
			end
		end
	end)
end

return ImpactService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Server bootstrap for RAGDOLL CRASH PHYSICS. Owns all authoritative state; the client can only
-- *request* things through one validated, rate-limited remote.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Specs = require(Shared.VehicleSpecs)

local MapService = require(script.Parent.MapService)
local DummyService = require(script.Parent.DummyService)
local RagdollService = require(script.Parent.RagdollService)
local ImpactService = require(script.Parent.ImpactService)
local VehicleService = require(script.Parent.VehicleService)
local CrashReportService = require(script.Parent.CrashReportService)
local ScenarioService = require(script.Parent.ScenarioService)
local SceneResetService = require(script.Parent.SceneResetService)
local Progression = require(script.Parent.ProgressionService)

-- Collision groups ---------------------------------------------------------
for _, g in { "Player", "Dummy", "Vehicle", "VehicleDecor", "Prop" } do
	PhysicsService:RegisterCollisionGroup(g)
end
PhysicsService:CollisionGroupSetCollidable("Vehicle", "VehicleDecor", false)
PhysicsService:CollisionGroupSetCollidable("VehicleDecor", "VehicleDecor", false)
PhysicsService:CollisionGroupSetCollidable("VehicleDecor", "Player", false)

-- Remotes ---------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in { "Request", "Impact", "Report", "VehicleCrash", "Notice", "Explosion" } do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end
remotes.Parent = ReplicatedStorage

-- World ---------------------------------------------------------------------------
local map, railAnchor = MapService.build()
local vehicles = Instance.new("Folder")
vehicles.Name = "Vehicles"
vehicles.Parent = workspace

DummyService.init()
VehicleService.init(vehicles, railAnchor)
ImpactService.init(vehicles)
CrashReportService.init(remotes)
CrashReportService.countDisturbedProps = SceneResetService.countDisturbed
SceneResetService.capture(map.Props)
ScenarioService.apply("Showcase")

-- A blast: real physics push (Explosion instance that breaks no joints) + damage to nearby dummies
-- through the normal hit pipeline + the fireball on every client.
local lastBlast = 0
local function blast(position: Vector3, scale: number, source: string)
	local now = os.clock()
	if now - lastBlast < 0.25 then
		return
	end
	lastBlast = now
	local radius = Config.Explosion.RADIUS * scale
	local e = Instance.new("Explosion")
	e.Position = position
	e.BlastRadius = radius
	e.BlastPressure = 180000 * scale
	e.DestroyJointRadiusPercent = 0
	e.ExplosionType = Enum.ExplosionType.NoCraters
	e.Visible = false
	e.Parent = workspace
	game:GetService("Debris"):AddItem(e, 2)
	for id, d in DummyService.dummies do
		local offset = d.torso.Position - position
		local dist = offset.Magnitude
		if dist < radius then
			local power = 1 - dist / radius
			local dir = if dist > 0.5 then offset.Unit else Vector3.yAxis
			DummyService.hit(id, { part = d.torso, relVelocity = (dir + Vector3.new(0, 0.45, 0)).Unit * (25 + 95 * power),
				relSpeed = 25 + 95 * power, vehicleImpact = 1.2 * scale, source = source, chain = true })
		end
	end
	remotes.Explosion:FireAllClients(position, scale)
end

table.insert(ImpactService.vehicleCrashListeners, function(vehicle: Model, dv: number, pos: Vector3)
	VehicleService.onCrash(vehicle, dv)
	remotes.VehicleCrash:FireAllClients(vehicle, dv, pos)
	-- hard enough hits (a wall for road vehicles, the ground for aircraft) end in an explosion
	local kind = vehicle:GetAttribute("Kind")
	local air = kind == "plane" or kind == "heli"
	local limit = if air then Config.Explosion.AIRCRAFT_DV else Config.Explosion.GROUND_DV
	if dv >= limit and not vehicle:GetAttribute("Exploded") and kind ~= "train" then
		vehicle:SetAttribute("Exploded", true)
		vehicle:SetAttribute("DamageLevel", 3)
		blast(pos, math.clamp((vehicle:GetAttribute("Impact") or 1) * 0.8, 0.8, 1.8), "Explosion")
	end
end)

-- Players ---------------------------------------------------------------------------
local starterGiven = false
local grabs = {} :: { [Player]: { id: number, align: AlignPosition, target: Attachment, att: Attachment } }

local function releaseGrab(player: Player)
	local g = grabs[player]
	if g then
		grabs[player] = nil
		g.align:Destroy()
		g.target:Destroy()
		g.att:Destroy()
	end
end

local function onCharacter(char: Model)
	do
		for _, p in char:GetDescendants() do
			if p:IsA("BasePart") then
				p.CollisionGroup = "Player"
			end
		end
		char.DescendantAdded:Connect(function(p)
			if p:IsA("BasePart") then
				p.CollisionGroup = "Player"
			end
		end)
	end
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
	if not starterGiven then
		starterGiven = true
		-- the bright yellow sports car, parked facing the first row of dummies
		VehicleService.spawn(player, "Sedan", false)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do
	onPlayer(p)
end
Players.PlayerRemoving:Connect(function(player)
	releaseGrab(player)
end)

local function notice(player: Player, text: string)
	remotes.Notice:FireClient(player, text)
end
Progression.notify = notice
Progression.init()
table.insert(CrashReportService.reportListeners, function(report)
	for _, p in Players:GetPlayers() do
		Progression.award(p, report)
	end
end)

-- every spawn path goes through here: locked vehicles are refused with the reason
local function trySpawn(player: Player, key: string): Model?
	if not Progression.canUse(player, key) then
		notice(player, string.format("%s is locked - %s", Specs.Vehicles[key].display, Progression.lockReason(player, key)))
		return nil
	end
	return VehicleService.spawn(player, key, true)
end

-- Stations on the plaza: walk onto a pad prompt to spawn that vehicle.
for _, st in MapService.stations do
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Spawn"
	prompt.ObjectText = Specs.Vehicles[st.key].display
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = st.part
	prompt.Triggered:Connect(function(player)
		trySpawn(player, st.key)
	end)
end

-- Requests ---------------------------------------------------------------------------
local lastCall = {} :: { [Player]: { [string]: number } }
local COOLDOWN = { Event = 1.5, LoadMap = 4, SetBody = 2, SpawnVehicle = 0.6, SpawnDummies = 0.4, Preset = 0.6, ResetScene = 0.6, ResetDummies = 0.5, GrabMove = 0 }

local function playerPos(player: Player): Vector3?
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end


local handlers = {}

function handlers.SpawnVehicle(player, key)
	if typeof(key) == "string" and Specs.Vehicles[key] then
		trySpawn(player, key)
	end
end

function handlers.ResetVehicle(player)
	local v = VehicleService.current(player)
	if v then
		VehicleService.reset(v)
	end
end

function handlers.DeleteVehicle(player)
	local v = VehicleService.current(player)
	if v then
		VehicleService.delete(v)
	end
end

function handlers.SpawnDummies(player, n, typeName)
	if typeof(n) ~= "number" or n ~= n then
		return
	end
	n = math.clamp(math.floor(n), 1, 10)
	typeName = if typeof(typeName) == "string" and Config.DummyTypes[typeName] then typeName else "Noob"
	local origin = playerPos(player)
	if not origin then
		return
	end
	local look = (player.Character :: Model):GetPivot().LookVector * Vector3.new(1, 0, 1)
	look = if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local made = 0
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { DummyService.folder, vehicles, player.Character }
	for i = 1, n do
		local col, row = (i - 1) % 5, math.floor((i - 1) / 5)
		local p = origin + look * (14 + row * 5) + right * (col - (math.min(n, 5) - 1) / 2) * 5
		local hit = workspace:Raycast(p + Vector3.new(0, 30, 0), Vector3.new(0, -120, 0), params)
		if hit then
			local cf = CFrame.lookAt(hit.Position, hit.Position - look)
			if DummyService.spawn(typeName, cf, "manual") then
				made += 1
			end
		end
	end
	if made < n then
		notice(player, string.format("Dummy limit reached (%d)", DummyService.limit))
	end
end

function handlers.Preset(player, name)
	if typeof(name) == "string" and ScenarioService.apply(name) then
		local p = ScenarioService.Presets[name][1]
		remotes.Notice:FireClient(player, "Preset: " .. name, Vector3.new(p[1], p[2], p[3]))
	end
end

function handlers.ResetDummies()
	DummyService.resetAll()
end

function handlers.ResetScene(player)
	releaseGrab(player)
	DummyService.resetAll()
	SceneResetService.resetProps()
	local v = VehicleService.current(player)
	if v then
		VehicleService.reset(v)
	end
end

function handlers.DummyAction(player, id, action)
	if typeof(id) ~= "number" or not DummyService.dummies[id] then
		return
	end
	if action == "Revive" then
		DummyService.revive(id)
	elseif action == "Reset" then
		DummyService.reset(id)
	elseif action == "Delete" then
		DummyService.remove(id)
	end
end

function handlers.Teleport(player, index)
	local zone = typeof(index) == "number" and Config.Map.Zones[index]
	local char = player.Character
	if zone and char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then
			hum.Sit = false
			task.wait(0.1)
		end
		char:PivotTo(CFrame.new(zone[2], 5, zone[3]))
	end
end

local gravityToken = 0
function handlers.Event(player, name)
	local origin = playerPos(player)
	if not origin then
		return
	end
	if name == "ReviveAll" then
		for id in DummyService.dummies do
			DummyService.revive(id)
		end
	elseif name == "DummyRain" then
		local rng = Random.new()
		for _ = 1, 8 do
			local p = origin + Vector3.new(rng:NextNumber(-40, 40), 70 + rng:NextNumber(0, 30), rng:NextNumber(-40, 40))
			if not DummyService.spawn("Noob", CFrame.new(p), "rain") then
				notice(player, string.format("Dummy limit reached (%d)", DummyService.limit))
				break
			end
		end
	elseif name == "ZeroG" then
		gravityToken += 1
		local my = gravityToken
		workspace.Gravity = 18
		notice(player, "Zero-G for 10 seconds")
		task.delay(10, function()
			if my == gravityToken then
				workspace.Gravity = 196.2
			end
		end)
	elseif name == "Blast" then
		local look = (player.Character :: Model):GetPivot().LookVector * Vector3.new(1, 0, 1)
		blast(origin + (if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)) * 34 + Vector3.new(0, -1, 0), 1.2, "Blast")
	end
end

function handlers.LoadMap(player, name)
	if typeof(name) ~= "string" or not table.find(Config.Map.Names, name) or name == MapService.current then
		return
	end
	releaseGrab(player)
	VehicleService.deleteAll()
	DummyService.clear()
	local newMap, anchor = MapService.build(name)
	VehicleService.setRailAnchor(anchor)
	SceneResetService.capture(newMap.Props)
	ScenarioService.apply("Showcase")
	local char = player.Character
	if char then
		char:PivotTo(CFrame.new(12, 5, 52))
	end
	VehicleService.spawn(player, "Sedan", false)
	notice(player, "Map: " .. name)
end

function handlers.SetBody(player, name)
	if typeof(name) == "string" and Config.Bodies[name] and Config.DummyBody ~= name then
		Config.DummyBody = name
		DummyService.resetAll()
	end
end

function handlers.SetDummyLimit(player, mode, mobile)
	if typeof(mode) == "string" and Config.DUMMY_LIMITS[mode] then
		DummyService.setLimit(mode, mobile == true)
	end
end

-- Grab tool: the server holds the dummy with a spring-like AlignPosition towards a point the
-- client steers, capped in range and force so nothing gets teleported through walls.
function handlers.Grab(player, id)
	releaseGrab(player)
	local d = typeof(id) == "number" and DummyService.dummies[id]
	local origin = playerPos(player)
	if not d or not origin or (d.torso.Position - origin).Magnitude > 90 then
		return
	end
	DummyService.knockDown(d, 1.5)
	if not d.state.ragdolled then
		RagdollService.enable(d.model)
		d.state.ragdolled = true
	end
	local att = Instance.new("Attachment")
	att.Parent = d.torso
	local target = Instance.new("Attachment")
	target.WorldPosition = d.torso.Position
	target.Parent = workspace.Terrain
	local align = Instance.new("AlignPosition")
	align.Attachment0, align.Attachment1 = att, target
	align.MaxForce = d.torso.AssemblyMass * 900 + 4000
	align.MaxVelocity = 70
	align.Responsiveness = 22
	align.Parent = d.torso
	grabs[player] = { id = id, align = align, target = target, att = att }
end

function handlers.GrabMove(player, pos)
	local g = grabs[player]
	local origin = playerPos(player)
	if not g or not origin or typeof(pos) ~= "Vector3" or pos ~= pos then
		return
	end
	local offset = pos - origin
	if offset.Magnitude > 70 then
		offset = offset.Unit * 70
	end
	local p = origin + offset
	g.target.WorldPosition = Vector3.new(p.X, math.clamp(p.Y, 1.5, 90), p.Z)
	local d = DummyService.dummies[g.id]
	if d then
		d.state.downUntil = os.clock() + 1.5 -- stays limp while held
		d.skipVelCheckUntil = os.clock() + 0.4
	else
		releaseGrab(player)
	end
end

function handlers.Release(player)
	releaseGrab(player)
end

remotes.Request.OnServerEvent:Connect(function(player, action, ...)
	if typeof(action) ~= "string" or not handlers[action] then
		return
	end
	local now = os.clock()
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local cd = COOLDOWN[action] or 0.15
	if calls[action] and now - calls[action] < cd then
		return
	end
	calls[action] = now
	local ok, err = pcall(handlers[action], player, ...)
	if not ok then
		warn("[RCP] request " .. action .. " failed: " .. tostring(err))
	end
end)
Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MapService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Builds the whole sandbox procedurally at server start: one continuous 700 x 700 stud test ground
-- (bright grass baseplate, flat tiled plaza, scaffolding, containers, ramps - the look shared by
-- the current top ragdoll sandboxes) with six connected crash-test zones.
-- Anchored geometry goes in workspace.Map.Static, knock-about props in workspace.Map.Props.
local Lighting = game:GetService("Lighting")
local Config = require(game.ReplicatedStorage.Shared.GameConfig)

local MapService = {}
local static: Folder, props: Folder

-- Three maps share the same test-zone layout (so every preset, spawn and zone teleport works on
-- all of them) and differ in ground, palette, lighting and scenery.
local THEMES = {
	-- ground = the tiled test-ground floor (warm concrete, like the reference sandboxes), tile = its seams,
	-- tile2 = the alternate checker tone, lawn = the few grass patches, outer = beyond the fence
	["Test Grounds"] = { ground = "#cfc8b8", tile = "#bdb5a3", tile2 = "#c7bfae", lawn = "#86a873", outer = "#9a9486", hill = "#8f9a7d",
		scenery = "trees", clock = 13.5, sky = { 199, 220, 255 } },
	Downtown = { ground = "#a9adb3", tile = "#969aa1", tile2 = "#a0a4aa", lawn = "#7f9a72", outer = "#868a90", hill = "#7d828a",
		scenery = "city", clock = 16.2, sky = { 214, 222, 235 } },
	["Desert Range"] = { ground = "#e0c896", tile = "#cdb37f", tile2 = "#d7bd89", lawn = "#a7a46a", outer = "#c9a96b", hill = "#c29a64",
		scenery = "desert", clock = 11.0, sky = { 255, 236, 200 } },
}
MapService.current = "Test Grounds"

local C = {
	grass = "#58c96a", grassDark = "#3fae55", concrete = "#b9bcc2", concreteDark = "#8f939b", asphalt = "#4a4d55",
	line = "#e9eaee", yellow = "#ffd21a", red = "#e2342b", blue = "#2f7fe0", dirt = "#a8835a", brick = "#b5533c",
	foam = "#ffb3d1", foamBlue = "#9ad7ff", white = "#f4f5f7", dark = "#30333a", steel = "#737a86", wood = "#b98a55",
}

local function block(name: string, size: Vector3, pos: Vector3, color: string, material: Enum.Material?, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(pos)
	p.Color = Color3.fromHex(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent or static
	return p
end

-- flat ground decal: top surface sits `lift` above y = 0
local function pad(name: string, sx: number, sz: number, x: number, z: number, color: string, lift: number?, material: Enum.Material?): Part
	local top = lift or 0.1
	return block(name, Vector3.new(sx, 0.4, sz), Vector3.new(x, top - 0.2, z), color, material)
end

local function mark(sx: number, sz: number, x: number, z: number, color: string, lift: number?)
	local p = pad("Marking", sx, sz, x, z, color, lift or 0.14)
	p.CanCollide, p.CanQuery, p.CastShadow = false, false, false
	return p
end

local function loose(name: string, size: Vector3, pos: Vector3, color: string, density: number, material: Enum.Material?): Part
	local p = block(name, size, pos, color, material, props)
	p.Anchored = false
	p.CustomPhysicalProperties = PhysicalProperties.new(density, 0.6, 0.1, 1, 1)
	p.CollisionGroup = "Prop"
	return p
end

-- ramp that rises towards -Z (the direction vehicles drive from the spawn)
local function ramp(name: string, width: number, height: number, length: number, x: number, zLowEdge: number, color: string): WedgePart
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Size = Vector3.new(width, height, length)
	w.CFrame = CFrame.new(x, height / 2, zLowEdge - length / 2) * CFrame.Angles(0, math.rad(180), 0)
	w.Color = Color3.fromHex(color)
	w.Material = Enum.Material.SmoothPlastic
	w.Anchored = true
	w.Parent = static
	return w
end

-- ramp rising along `dir` (unit vector in XZ) from its low edge at (x, z)
local function rampAt(name: string, width: number, height: number, length: number, x: number, z: number, dir: Vector3, color: string): WedgePart
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Size = Vector3.new(width, height, length)
	local centre = Vector3.new(x, height / 2, z) + dir * (length / 2)
	-- WedgePart: tall face is the back (+Z local), slope bottom at the front (-Z), so the back faces along dir
	w.CFrame = CFrame.lookAt(centre, centre - dir)
	w.Color = Color3.fromHex(color)
	w.Material = Enum.Material.SmoothPlastic
	w.Anchored = true
	w.Parent = static
	return w
end

-- asphalt road between two points on the ground, with kerb edges, white edge lines and a dashed
-- yellow centre line. Roads sit at 0.12 so they never z-fight with the 0.1 zone pads.
local function road(name: string, a: Vector2, b: Vector2, width: number)
	local d = b - a
	local len = d.Magnitude
	local mid = (a + b) / 2
	local along = Vector3.new(d.X, 0, d.Y).Unit
	local cf = CFrame.lookAt(Vector3.new(mid.X, 0, mid.Y), Vector3.new(mid.X, 0, mid.Y) + along)
	local function strip(n: string, w: number, l: number, offX: number, offZ: number, top: number, color: string, mat: Enum.Material?)
		local p = block(n, Vector3.new(w, 0.4, l), Vector3.zero, color, mat)
		p.CFrame = cf * CFrame.new(offX, top - 0.2, offZ)
		return p
	end
	strip(name, width, len, 0, 0, 0.12, C.asphalt, Enum.Material.Asphalt)
	for _, s in { -1, 1 } do
		strip("EdgeLine", 0.6, len - 2, s * (width / 2 - 1.4), 0, 0.15, C.line).CanCollide = false
		strip("Kerb", 1.2, len, s * (width / 2 + 0.6), 0, 0.32, C.concrete, Enum.Material.Concrete)
	end
	local dash = 0
	while dash + 6 < len - 4 do
		strip("CentreLine", 0.6, 6, 0, -len / 2 + 4 + dash + 3, 0.15, C.yellow).CanCollide = false
		dash += 12
	end
end

local function crosswalk(x: number, z: number, width: number, alongX: boolean)
	for k = -3, 3 do
		if alongX then
			mark(2, width - 4, x + k * 3.4, z, C.white, 0.16)
		else
			mark(width - 4, 2, x, z + k * 3.4, C.white, 0.16)
		end
	end
end

local function sign(text: string, pos: Vector3, size: Vector3, yaw: number?, bg: string?, fg: string?): Part
	local p = block("Sign", size, pos, bg or C.yellow)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local g = Instance.new("SurfaceGui")
		g.Face = face
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 20
		g.Parent = p
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Text = text
		t.TextScaled = true
		t.Font = Enum.Font.GothamBlack
		t.TextColor3 = Color3.fromHex(fg or "#15171c")
		t.Parent = g
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft, padding.PaddingRight = UDim.new(0.04, 0), UDim.new(0.04, 0)
		padding.PaddingTop, padding.PaddingBottom = UDim.new(0.08, 0), UDim.new(0.08, 0)
		padding.Parent = t
	end
	return p
end

local function signOnPosts(text: string, x: number, z: number, width: number, height: number, yaw: number?)
	local rad = math.rad(yaw or 0)
	local right = Vector3.new(math.cos(rad), 0, -math.sin(rad))
	for _, s in { -1, 1 } do
		block("Post", Vector3.new(1, height, 1), Vector3.new(x, height / 2, z) + right * s * (width / 2 - 1), C.dark, Enum.Material.Metal)
	end
	sign(text, Vector3.new(x, height + 2.5, z), Vector3.new(width, 5, 0.6), yaw)
end

local function brickWall(x: number, z: number, cols: number, rows: number, alongX: boolean)
	local bs = Vector3.new(4, 2, 2)
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local off = (c - (cols - 1) / 2) * 4 + (if r % 2 == 1 then 2 else 0)
			local pos = if alongX then Vector3.new(x + off, 1.2 + r * 2, z) else Vector3.new(x, 1.2 + r * 2, z + off)
			local b = loose("Brick", if alongX then bs else Vector3.new(2, 2, 4), pos, if (r + c) % 2 == 0 then C.brick else "#a34a35", 0.9, Enum.Material.Brick)
			b:SetAttribute("Breakable", true)
		end
	end
end

local function foamCubes(x: number, z: number, cols: number, rows: number, size: number, alongX: boolean)
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local off = (c - (cols - 1) / 2) * size
			local pos = if alongX then Vector3.new(x + off, size / 2 + 0.2 + r * size, z) else Vector3.new(x, size / 2 + 0.2 + r * size, z + off)
			loose("FoamCube", Vector3.one * size, pos, if (r + c) % 2 == 0 then C.foam else C.foamBlue, 0.06)
		end
	end
end

-- open scaffold tower, the landmark every reference sandbox has
local function scaffold(x: number, z: number, levels: number)
	for l = 0, levels - 1 do
		local y = l * 12
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				block("ScaffoldLeg", Vector3.new(1, 12, 1), Vector3.new(x + sx * 7, y + 6, z + sz * 7), C.yellow, Enum.Material.Metal)
			end
			local brace = block("ScaffoldBrace", Vector3.new(0.6, 18, 0.6), Vector3.new(x + sx * 7, y + 6, z), C.dark, Enum.Material.Metal)
			brace.CFrame = CFrame.new(x + sx * 7, y + 6, z) * CFrame.Angles(math.rad(50 * sx), 0, 0)
			brace.CanCollide = false
		end
		block("ScaffoldDeck", Vector3.new(15, 0.6, 15), Vector3.new(x, y + 12, z), C.wood, Enum.Material.WoodPlanks)
	end
end

local function lighting(theme)
	Lighting.ClockTime = theme.clock
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(110, 115, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 155, 165)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 250, 235)
	Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 0.6, 0.4
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0
	for _, e in Lighting:GetChildren() do
		if e:IsA("PostEffect") or e:IsA("Atmosphere") or e:IsA("Sky") then
			e:Destroy()
		end
	end
	local atmo = Instance.new("Atmosphere")
	atmo.Density, atmo.Offset, atmo.Haze, atmo.Glare = 0.22, 0.1, 0.6, 0
	atmo.Color, atmo.Decay = Color3.fromRGB(theme.sky[1], theme.sky[2], theme.sky[3]), Color3.fromRGB(180, 205, 240)
	atmo.Parent = Lighting
	local oldClouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if oldClouds then
		oldClouds:Destroy()
	end
	local clouds = Instance.new("Clouds")
	clouds.Cover, clouds.Density, clouds.Color = 0.55, 0.35, Color3.new(1, 1, 1)
	clouds.Parent = workspace.Terrain
end

-- Free strips between the test zones where scenery may go: { x0, x1, z0, z1 }
local FREE = { { -100, -30, -160, -20 }, { 25, 65, -200, -70 }, { -125, -18, 95, 230 }, { 18, 40, 100, 230 }, { -300, 250, 324, 342 }, { -300, -20, -285, -240 }, { 20, 100, -285, -240 }, { 220, 258, -170, 12 } }

local function scatter(count: number, gap: number, seed: number): { Vector3 }
	local rng = Random.new(seed)
	local out = {}
	local tries = 0
	while #out < count and tries < count * 30 do
		tries += 1
		local r = FREE[rng:NextInteger(1, #FREE)]
		local p = Vector3.new(rng:NextNumber(r[1], r[2]), 0, rng:NextNumber(r[3], r[4]))
		local ok = true
		for _, o in out do
			if (o - p).Magnitude < gap then
				ok = false
				break
			end
		end
		if ok then
			table.insert(out, p)
		end
	end
	return out
end

function MapService.scenery(kind: string)
	local rng = Random.new(11)
	if kind == "trees" then
		for _, p in scatter(44, 16, 5) do -- low-poly trees: trunk + two leaf blocks
			local h = rng:NextNumber(9, 15)
			block("Trunk", Vector3.new(2, h, 2), p + Vector3.new(0, h / 2, 0), "#7a5230", Enum.Material.Wood)
			local a = block("Leaves", Vector3.new(9, 6, 9), p + Vector3.new(0, h + 2, 0), "#3fae55")
			a.CFrame = CFrame.new(p + Vector3.new(0, h + 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0)
			local b = block("Leaves", Vector3.new(6, 5, 6), p + Vector3.new(0, h + 6.5, 0), "#58c96a")
			b.CFrame = CFrame.new(p + Vector3.new(0, h + 6.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0)
			a.CanCollide, b.CanCollide = false, false
		end
		for _, p in scatter(10, 40, 9) do -- grey concrete blocks and crates, as in the reference maps
			block("ConcreteBlock", Vector3.new(14, 10, 14), p + Vector3.new(0, 5, 0), C.concrete, Enum.Material.Concrete)
			loose("Crate", Vector3.new(5, 5, 5), p + Vector3.new(11, 2.7, 0), C.wood, 0.3, Enum.Material.WoodPlanks)
		end
	elseif kind == "city" then
		local cols = { "#c9ced6", "#b7a99a", "#9db1c4", "#d6c9b0", "#a8adb5" }
		for i, p in scatter(22, 34, 21) do -- office blocks with window bands and roof plant
			local w, d, h = rng:NextNumber(20, 30), rng:NextNumber(20, 30), rng:NextNumber(28, 70)
			block("Building", Vector3.new(w, h, d), p + Vector3.new(0, h / 2, 0), cols[i % #cols + 1], Enum.Material.Concrete)
			for y = 8, h - 4, 8 do
				block("Windows", Vector3.new(w + 0.3, 3.2, d + 0.3), p + Vector3.new(0, y, 0), "#2b3a4d", Enum.Material.Glass).CanCollide = false
			end
			block("RoofPlant", Vector3.new(w * 0.4, 3, d * 0.4), p + Vector3.new(0, h + 1.5, 0), C.steel, Enum.Material.Metal).CanCollide = false
		end
		for _, p in scatter(24, 22, 33) do -- street lamps
			block("LampPost", Vector3.new(0.6, 16, 0.6), p + Vector3.new(0, 8, 0), C.dark, Enum.Material.Metal)
			block("LampHead", Vector3.new(3.4, 0.5, 1.2), p + Vector3.new(1.4, 16, 0), "#fff3c4", Enum.Material.Neon).CanCollide = false
		end
		for _, p in scatter(18, 12, 44) do
			loose("Cone", Vector3.new(1.6, 2.4, 1.6), p + Vector3.new(0, 1.3, 0), "#ff7a1a", 0.2)
		end
	else -- desert
		for _, p in scatter(26, 22, 51) do -- sandstone outcrops
			local sz = rng:NextNumber(10, 26)
			local rock = block("Rock", Vector3.new(sz, sz * rng:NextNumber(0.6, 1.3), sz * rng:NextNumber(0.7, 1.2)), p + Vector3.new(0, sz * 0.25, 0), "#b98a5a", Enum.Material.Sandstone)
			rock.CFrame = CFrame.new(p + Vector3.new(0, sz * 0.25, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 3), rng:NextNumber(-0.2, 0.2))
		end
		for _, p in scatter(30, 14, 63) do -- saguaro cacti
			local h = rng:NextNumber(7, 12)
			local trunk = block("Cactus", Vector3.new(h, 1.8, 1.8), p + Vector3.new(0, h / 2, 0), "#4f8f4a")
			trunk.Shape = Enum.PartType.Cylinder
			trunk.CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
			local arm = block("CactusArm", Vector3.new(3.4, 1.2, 1.2), p + Vector3.new(1.6, h * 0.55, 0), "#4f8f4a")
			arm.Shape = Enum.PartType.Cylinder
			arm.CanCollide = false
		end
		for _, p in scatter(6, 60, 71) do -- timber shacks
			block("Shack", Vector3.new(16, 9, 12), p + Vector3.new(0, 4.5, 0), "#9a7146", Enum.Material.WoodPlanks)
			block("ShackRoof", Vector3.new(18, 0.8, 14), p + Vector3.new(0, 9.4, 0), "#6b4a2c", Enum.Material.WoodPlanks).CanCollide = false
		end
	end
end

function MapService.build(name: string?): (Folder, BasePart)
	local theme = THEMES[name or ""] or THEMES["Test Grounds"]
	MapService.current = if THEMES[name or ""] then name :: string else "Test Grounds"
	C.grass, C.grassDark = theme.lawn, theme.outer
	local previous = workspace:FindFirstChild("Map")
	if previous and previous:GetAttribute("Prebuilt") == MapService.current and previous:FindFirstChild("Static") then
		-- the place file ships with this map already built (tools/bake_place.luau): reuse it as-is,
		-- so anything you change in Studio's editor is what players get
		static = previous.Static :: Folder
		props = previous:FindFirstChild("Props") :: Folder
		lighting(theme)
		MapService.stations = {}
		for _, key in { "Sedan", "PickupTruck", "PoliceCar", "SmallPlane" } do
			local st = static:FindFirstChild("Station" .. key)
			if st then
				table.insert(MapService.stations, { part = st, key = key })
			end
		end
		previous:SetAttribute("Prebuilt", nil)
		return previous, static:FindFirstChild("RailAnchor") :: BasePart
	end
	if previous then
		previous:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	static = Instance.new("Folder")
	static.Name = "Static"
	static.Parent = map
	props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = map
	lighting(theme)
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	local HALF = Config.Map.SIZE / 2

	-- Ground ------------------------------------------------------------
	block("Baseplate", Vector3.new(2048, 8, 2048), Vector3.new(0, -4, 0), theme.outer, Enum.Material.Ground)
	local field = pad("Sandbox", Config.Map.SIZE, Config.Map.SIZE, 0, 0, theme.ground, 0.02, Enum.Material.SmoothPlastic)
	field.CanCollide = false
	for _, s in { -1, 1 } do -- low concrete wall + invisible fence so ground vehicles cannot get lost
		block("Berm", Vector3.new(Config.Map.SIZE + 24, 4, 3), Vector3.new(0, 2, s * (HALF + 6)), C.concreteDark, Enum.Material.Concrete)
		block("Berm", Vector3.new(3, 4, Config.Map.SIZE + 24), Vector3.new(s * (HALF + 6), 2, 0), C.concreteDark, Enum.Material.Concrete)
		local w1 = block("Boundary", Vector3.new(Config.Map.SIZE + 24, 34, 2), Vector3.new(0, 17, s * (HALF + 11)), C.white)
		local w2 = block("Boundary", Vector3.new(2, 34, Config.Map.SIZE + 24), Vector3.new(s * (HALF + 11), 17, 0), C.white)
		w1.Transparency, w2.Transparency = 1, 1
	end
	-- 48-stud floor tiles: a soft two-tone checker (one part per dark tile row-run) plus thin seams
	local T = 48
	local n = math.floor(Config.Map.SIZE / T / 2)
	for i = -n, n - 1 do
		for j = -n, n - 1 do
			if (i + j) % 2 == 0 then
				local t = pad("Tile", T, T, (i + 0.5) * T, (j + 0.5) * T, theme.tile2, 0.035)
				t.CanCollide, t.CanQuery = false, false
			end
		end
	end
	for k = -n, n do
		mark(0.4, Config.Map.SIZE, k * T, 0, theme.tile, 0.05)
		mark(Config.Map.SIZE, 0.4, 0, k * T, theme.tile, 0.05)
	end
	-- a few lawns, so the ground is mostly concrete with green accents rather than a green field
	for _, l in { { -90, -190, 60, 50 }, { 60, -250, 70, 50 }, { -60, 160, 60, 110 }, { 80, -110, 30, 60 }, { 200, -40, 30, 60 } } do
		local lawn = pad("Lawn", l[3], l[4], l[1], l[2], theme.lawn, 0.06, Enum.Material.Grass)
		lawn.CanCollide = false
		mark(l[3] + 1.2, 0.6, l[1], l[2] - l[4] / 2, C.concrete, 0.07)
		mark(l[3] + 1.2, 0.6, l[1], l[2] + l[4] / 2, C.concrete, 0.07)
		mark(0.6, l[4], l[1] - l[3] / 2, l[2], C.concrete, 0.07)
		mark(0.6, l[4], l[1] + l[3] / 2, l[2], C.concrete, 0.07)
	end
	local rng = Random.new(3)
	for i = 1, 14 do -- distant decorative hills
		local a = i / 14 * math.pi * 2
		local r, size = rng:NextNumber(620, 900), rng:NextNumber(160, 320)
		local hill = block("Hill", Vector3.one * size, Vector3.new(math.cos(a) * r, -size * 0.28, math.sin(a) * r), theme.hill, Enum.Material.Ground)
		hill.Shape = Enum.PartType.Ball
	end

	-- Central spawn area --------------------------------------------------
	pad("Plaza", 130, 80, 0, 40, C.concrete, 0.1, Enum.Material.Concrete)
	pad("SpawnDeck", 34, 26, 12, 58, C.wood, 0.16, Enum.Material.WoodPlanks) -- wooden spawn deck
	for i = -3, 3 do -- tile seams, like the tiled floors of the reference sandboxes
		mark(0.3, 80, i * 16, 40, C.concreteDark, 0.13)
	end
	pad("TestLane", 30, 150, 0, -75, C.asphalt, 0.1, Enum.Material.Asphalt)
	for z = -10, -140, -20 do
		mark(1, 10, 0, z, C.line)
	end
	mark(30, 2, 0, -2, C.yellow)
	mark(30, 1.5, 0, -32, C.white)
	signOnPosts("CRASH TESTING", 0, -158, 46, 14)
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.Anchored = true
	spawn.Color = Color3.fromHex(C.blue)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.CFrame = CFrame.new(12, 0.3, 52) -- player faces -Z: the car, then the dummies
	spawn.Parent = static
	-- equipment-testing building (open front)
	block("LabFloor", Vector3.new(30, 0.4, 22), Vector3.new(-45, 0.3, 58), C.white)
	block("LabWall", Vector3.new(30, 12, 1), Vector3.new(-45, 6, 69), C.concreteDark, Enum.Material.Concrete)
	block("LabWall", Vector3.new(1, 12, 22), Vector3.new(-60, 6, 58), C.concreteDark, Enum.Material.Concrete)
	block("LabWall", Vector3.new(1, 12, 22), Vector3.new(-30, 6, 58), C.concreteDark, Enum.Material.Concrete)
	block("LabRoof", Vector3.new(32, 1, 24), Vector3.new(-45, 12.5, 58), C.blue)
	sign("TEST LAB", Vector3.new(-45, 10, 46.6), Vector3.new(16, 3, 0.4), 0, C.blue, C.white)
	scaffold(52, 62, 2)
	-- quick-spawn pads
	MapService.stations = {}
	for i, key in { "Sedan", "PickupTruck", "PoliceCar", "SmallPlane" } do
		local p = block("Station" .. key, Vector3.new(8, 0.5, 8), Vector3.new(38 + (i - 1) * 0, 0.35, 12 + (i - 1) * 10), C.blue)
		p.Material = Enum.Material.Neon
		p.Transparency = 0.25
		local post = sign(string.upper(key), Vector3.new(44, 4, 12 + (i - 1) * 10), Vector3.new(0.4, 2.2, 8), 0, C.dark, C.white)
		post.CFrame = CFrame.new(44, 4, 12 + (i - 1) * 10) * CFrame.Angles(0, math.rad(90), 0)
		post.Size = Vector3.new(8, 2.2, 0.4)
		table.insert(MapService.stations, { part = p, key = key })
	end

	-- Zone A: dummy testing field ------------------------------------------
	pad("DummyFieldPad", 70, 60, -230, -70, C.concrete, 0.1, Enum.Material.Concrete)
	pad("BowlingLane", 18, 170, -150, -105, C.asphalt, 0.1, Enum.Material.Asphalt)
	mark(18, 1.5, -150, -30, C.yellow)
	for z = -40, -130, -18 do
		mark(0.8, 8, -150, z, C.line)
	end
	signOnPosts("DUMMY FIELD", -190, -18, 40, 12)
	-- dummy wall: slab on two knock-out supports
	loose("WallSupport", Vector3.new(4, 8.5, 6), Vector3.new(-250, 4.35, -150), C.concreteDark, 1.2, Enum.Material.Concrete)
	loose("WallSupport", Vector3.new(4, 8.5, 6), Vector3.new(-220, 4.35, -150), C.concreteDark, 1.2, Enum.Material.Concrete)
	loose("WallSlab", Vector3.new(40, 1, 8), Vector3.new(-235, 9.1, -150), C.yellow, 0.5)
	-- dummy tower: three loose levels
	for l = 0, 2 do
		local y = l * 9
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				loose("TowerPillar", Vector3.new(2, 8, 2), Vector3.new(-200 + sx * 7, y + 4.2, -160 + sz * 5), C.steel, 1.0, Enum.Material.Metal)
			end
		end
		loose("TowerSlab", Vector3.new(18, 1, 14), Vector3.new(-200, y + 8.7, -160), if l % 2 == 0 then C.red else C.white, 0.6)
	end

	-- Zone B: high-speed crash track -----------------------------------------
	pad("CrashTrack", 340, 32, 0, 260, C.asphalt, 0.1, Enum.Material.Asphalt)
	for x = -150, 150, 24 do
		mark(12, 1, x, 260, C.line)
	end
	for i = 0, 7 do -- chequered start line
		mark(2, 4, -160 + (i % 2) * 2, 246 + i * 4, if i % 2 == 0 then C.white else "#15171c")
	end
	signOnPosts("HIGH-SPEED TRACK  >>>", -150, 238, 44, 12)
	block("CrashBarrier", Vector3.new(6, 12, 40), Vector3.new(175, 6, 260), C.concreteDark, Enum.Material.Concrete)
	for i = 0, 4 do
		block("BarrierStripe", Vector3.new(0.2, 2, 4), Vector3.new(171.9, 3, 244 + i * 8), if i % 2 == 0 then C.yellow else "#15171c")
	end
	brickWall(110, 260, 6, 4, false)
	foamCubes(150, 260, 4, 2, 7, false)

	-- Zone C: giant ramps -----------------------------------------------------
	pad("RampApron", 150, 60, 150, -30, C.concrete, 0.1, Enum.Material.Concrete)
	signOnPosts("RAMPS", 150, -4, 30, 12)
	ramp("BeginnerRamp", 20, 6, 26, 105, -60, C.yellow)
	ramp("LongRamp", 28, 25, 100, 150, -60, C.red)
	block("LongRampDeck", Vector3.new(28, 1, 8), Vector3.new(150, 24.5, -164), C.red)
	block("LongRampSupport", Vector3.new(24, 24, 6), Vector3.new(150, 12, -165), C.concreteDark, Enum.Material.Concrete)
	ramp("LaunchRamp", 22, 30, 46, 198, -60, C.blue)
	block("LaunchSupport", Vector3.new(20, 30, 3), Vector3.new(198, 15, -107.5), C.concreteDark, Enum.Material.Concrete)
	block("TargetPlatform", Vector3.new(60, 1, 34), Vector3.new(150, 24.5, -205), C.concrete, Enum.Material.Concrete)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			block("PlatformLeg", Vector3.new(4, 24, 4), Vector3.new(150 + sx * 26, 12, -205 + sz * 13), C.concreteDark, Enum.Material.Concrete)
		end
	end
	foamCubes(150, -216, 5, 2, 6, true)

	-- Zone D: airfield ----------------------------------------------------------
	pad("Runway", 44, 620, 290, 0, "#3f4249", 0.1, Enum.Material.Asphalt)
	for z = -290, 290, 30 do
		mark(1.4, 14, 290, z, C.line)
	end
	for _, z in { 300, -300 } do
		for i = -3, 3 do
			mark(3, 12, 290 + i * 5.5, z, C.line)
		end
	end
	pad("Apron", 60, 150, 240, 215, C.concrete, 0.1, Enum.Material.Concrete)
	for i, z in { 240, 190 } do
		block("HangarBack", Vector3.new(2, 20, 40), Vector3.new(214, 10, z), C.steel, Enum.Material.Metal)
		block("HangarSide", Vector3.new(44, 20, 2), Vector3.new(235, 10, z - 20), C.steel, Enum.Material.Metal)
		block("HangarSide", Vector3.new(44, 20, 2), Vector3.new(235, 10, z + 20), C.steel, Enum.Material.Metal)
		block("HangarRoof", Vector3.new(46, 2, 44), Vector3.new(236, 21, z), if i == 1 then C.blue else C.red)
	end
	block("TowerShaft", Vector3.new(8, 34, 8), Vector3.new(246, 17, 96), C.white, Enum.Material.Concrete)
	local cab = block("TowerCab", Vector3.new(14, 7, 14), Vector3.new(246, 37.5, 96), "#9fd3ee", Enum.Material.Glass)
	cab.Transparency = 0.4
	block("TowerRoof", Vector3.new(16, 1, 16), Vector3.new(246, 41.5, 96), C.red)
	local helipad = pad("Helipad", 30, 30, 236, 150, C.dark, 0.14)
	helipad.Shape = Enum.PartType.Block
	mark(3, 16, 231, 150, C.yellow, 0.18)
	mark(3, 16, 241, 150, C.yellow, 0.18)
	mark(10, 3, 236, 150, C.yellow, 0.18)
	signOnPosts("AIRFIELD", 262, 318, 30, 12)
	-- aircraft crash target: padded wall + dummy deck near the far end of the runway
	foamCubes(232, -270, 5, 3, 8, true)
	block("TargetDeck", Vector3.new(40, 1, 12), Vector3.new(232, 11.5, -252), C.yellow)
	block("TargetDeckLeg", Vector3.new(3, 11, 3), Vector3.new(214, 5.5, -252), C.dark, Enum.Material.Metal)
	block("TargetDeckLeg", Vector3.new(3, 11, 3), Vector3.new(250, 5.5, -252), C.dark, Enum.Material.Metal)
	scaffold(205, -215, 3)

	-- Zone E: tank / heavy vehicle field ----------------------------------------
	pad("TankField", 160, 150, -220, 120, C.dirt, 0.1, Enum.Material.Ground)
	signOnPosts("HEAVY VEHICLES", -220, 200, 44, 12)
	for i, z in { 150, 110, 70 } do
		block("Barrier", Vector3.new(14, 4, 3), Vector3.new(-260 + i * 14, 2, z), C.concreteDark, Enum.Material.Concrete)
	end
	brickWall(-220, 140, 6, 4, true)
	brickWall(-190, 95, 5, 3, true)
	foamCubes(-250, 95, 3, 3, 7, true)
	for i, x in { -270, -240, -180 } do -- bumps
		ramp("Bump", 18, 3, 12, x, 70 - i * 3, C.dirt).Material = Enum.Material.Ground
	end
	loose("Crate", Vector3.new(6, 6, 6), Vector3.new(-160, 3.2, 150), C.wood, 0.3, Enum.Material.WoodPlanks)
	loose("Crate", Vector3.new(6, 6, 6), Vector3.new(-160, 9.3, 150), C.wood, 0.3, Enum.Material.WoodPlanks)
	loose("Crate", Vector3.new(6, 6, 6), Vector3.new(-167, 3.2, 150), C.wood, 0.3, Enum.Material.WoodPlanks)

	-- Zone F: destruction yard ----------------------------------------------------
	pad("Yard", 140, 110, 120, 130, C.concreteDark, 0.1, Enum.Material.Concrete)
	signOnPosts("DESTRUCTION YARD", 120, 70, 48, 12)
	for i, c in { C.red, C.blue, C.yellow, "#3d8f4a" } do
		block("Container", Vector3.new(10, 10, 26), Vector3.new(70 + i * 12, 5.2, 170), c, Enum.Material.Metal)
	end
	block("Container", Vector3.new(10, 10, 26), Vector3.new(88, 15.2, 170), C.white, Enum.Material.Metal)
	block("Container", Vector3.new(10, 10, 26), Vector3.new(106, 15.2, 170), C.red, Enum.Material.Metal)
	loose("LooseContainer", Vector3.new(10, 10, 22), Vector3.new(150, 5.3, 165), C.blue, 0.25, Enum.Material.Metal)
	brickWall(100, 110, 6, 4, true)
	foamCubes(150, 110, 3, 2, 12, true)
	for i = 0, 3 do
		block("JerseyBarrier", Vector3.new(12, 4, 3), Vector3.new(70 + i * 14, 2, 90), C.concrete, Enum.Material.Concrete)
	end
	-- suspended collision targets on a gantry
	block("GantryLeg", Vector3.new(2, 26, 2), Vector3.new(150, 13, 140), C.yellow, Enum.Material.Metal)
	block("GantryLeg", Vector3.new(2, 26, 2), Vector3.new(180, 13, 140), C.yellow, Enum.Material.Metal)
	local beam = block("GantryBeam", Vector3.new(34, 2, 2), Vector3.new(165, 27, 140), C.yellow, Enum.Material.Metal)
	for _, dx in { -7, 7 } do
		local ball = loose("WreckingTarget", Vector3.one * 7, Vector3.new(165 + dx, 9, 140), C.red, 0.4)
		ball.Shape = Enum.PartType.Ball
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position = Vector3.new(dx, -1, 0)
		a0.Parent = beam
		a1.Position = Vector3.new(0, 3.5, 0)
		a1.Parent = ball
		local rope = Instance.new("RopeConstraint")
		rope.Attachment0, rope.Attachment1 = a0, a1
		rope.Length = 13.5
		rope.Visible = true
		rope.Thickness = 0.3
		rope.Parent = beam
	end

	-- Railway: ballasted track that runs the length of the map and ENDS in a buffer stop ----------
	local RX = -330
	pad("BallastBase", 19, 640, RX, 0, "#77705f", 0.22, Enum.Material.Slate)
	pad("BallastTop", 14, 640, RX, 0, "#8a8372", 0.5, Enum.Material.Slate)
	for z = -316, 316, 4 do -- timber sleepers
		local s = block("Sleeper", Vector3.new(11.5, 0.5, 1.5), Vector3.new(RX, 0.55, z), "#4d3a28", Enum.Material.Wood)
		s.CanCollide = false
	end
	for _, dx in { -4.2, 4.2 } do -- flat-bottom rail: foot, web, head
		for _, r in { { 1.2, 0.14, 0.87, "#5d6169" }, { 0.3, 0.55, 1.2, "#5d6169" }, { 0.62, 0.3, 1.6, "#b9bec6" } } do
			local rail = block("Rail", Vector3.new(r[1], r[2], 640), Vector3.new(RX + dx, r[3], 0), r[4], Enum.Material.Metal)
			rail.CanCollide = false
		end
		for z = -300, 300, 40 do -- fishplates at the rail joints
			block("Fishplate", Vector3.new(0.5, 0.4, 3), Vector3.new(RX + dx, 1.2, z), "#3a3d43", Enum.Material.Metal).CanCollide = false
		end
	end
	-- dead end: buffer stop built from rail, with a sand drag in front of it
	local END = -318
	for _, dx in { -4.2, 4.2 } do
		for _, a in { { 0, 0 }, { 28, 2.2 } } do
			local leg = block("BufferLeg", Vector3.new(0.7, 6.5, 0.7), Vector3.new(RX + dx, 3.6, END + a[2]), "#8b1a16", Enum.Material.Metal)
			leg.CFrame = CFrame.new(RX + dx, 3.6, END + a[2] + (if a[1] > 0 then 1.4 else 0)) * CFrame.Angles(math.rad(a[1]), 0, 0)
		end
	end
	block("BufferBeam", Vector3.new(12, 1.6, 1.2), Vector3.new(RX, 5.6, END), C.red, Enum.Material.Metal)
	for k = -2, 2 do
		block("BufferStripe", Vector3.new(1.2, 1.62, 1.22), Vector3.new(RX + k * 2.4, 5.6, END), C.white, Enum.Material.Metal).CanCollide = false
	end
	local lamp = block("BufferLamp", Vector3.new(0.9, 0.9, 0.6), Vector3.new(RX, 7.0, END + 0.4), "#ff2b2b", Enum.Material.Neon)
	lamp.Shape = Enum.PartType.Cylinder
	lamp.CFrame = CFrame.new(RX, 7.0, END + 0.4) * CFrame.Angles(0, math.rad(90), 0)
	block("SandDrag", Vector3.new(13, 1.4, 16), Vector3.new(RX, 0.9, END + 12), "#d9c08a", Enum.Material.Sand).CanCollide = false
	block("EndWall", Vector3.new(16, 9, 2), Vector3.new(RX, 4.5, END - 3), C.concreteDark, Enum.Material.Concrete)
	sign("END OF TRACK", Vector3.new(RX + 9.5, 6, END + 6), Vector3.new(7, 2.4, 0.4), 0, C.red, C.white)
	block("SignPost", Vector3.new(0.5, 6, 0.5), Vector3.new(RX + 9.5, 3, END + 6), C.dark, Enum.Material.Metal)
	-- level crossing: road deck, crossbucks, warning lights, raised barrier arms
	pad("Crossing", 60, 20, RX + 14, 0, C.asphalt, 0.62, Enum.Material.Asphalt)
	for _, dx in { -1.4, 1.4 } do
		mark(1.0, 20, RX + dx * 3, 0, C.yellow, 0.66)
	end
	for _, sz in { -1, 1 } do
		local px, pz = RX + sz * 9, sz * 12
		block("CrossPost", Vector3.new(0.6, 13, 0.6), Vector3.new(px, 6.5, pz), C.white, Enum.Material.Metal)
		for _, rot in { 35, -35 } do
			local arm = block("Crossbuck", Vector3.new(7, 1.1, 0.25), Vector3.new(px, 11.5, pz), C.white)
			arm.CFrame = CFrame.new(px, 11.5, pz) * CFrame.Angles(0, math.rad(90), math.rad(rot))
			arm.CanCollide = false
		end
		for _, dz in { -1.3, 1.3 } do
			local l = block("CrossLight", Vector3.new(0.4, 1.3, 1.3), Vector3.new(px, 8.6, pz + dz), "#ff2b2b", Enum.Material.Neon)
			l.Shape = Enum.PartType.Cylinder
			l.CanCollide = false
		end
		block("GateBase", Vector3.new(1.6, 4, 1.6), Vector3.new(px + sz * 3, 2, pz), C.dark, Enum.Material.Metal)
		local gate = block("GateArm", Vector3.new(0.5, 22, 0.5), Vector3.new(px + sz * 3, 14, pz), C.red)
		gate.CanCollide = false
		for k = 0, 4 do
			block("GateStripe", Vector3.new(0.52, 2.2, 0.52), Vector3.new(px + sz * 3, 5.5 + k * 4.4, pz), C.white).CanCollide = false
		end
