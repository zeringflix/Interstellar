	end
	for z = -280, 280, 80 do
		block("TelegraphPole", Vector3.new(0.7, 20, 0.7), Vector3.new(RX - 11, 10, z), "#5c4630", Enum.Material.Wood)
		block("Crossarm", Vector3.new(5, 0.4, 0.4), Vector3.new(RX - 11, 18.5, z), "#5c4630", Enum.Material.Wood).CanCollide = false
	end
	for _, dx in { -2, 2 } do
		block("Wire", Vector3.new(0.08, 0.08, 560), Vector3.new(RX - 11 + dx, 18.8, 0), "#22252b").CanCollide = false
	end
	local anchor = block("RailAnchor", Vector3.new(1, 1, 1), Vector3.new(RX, 8, 285), C.dark)
	anchor.Transparency, anchor.CanCollide, anchor.CanQuery = 1, false, false

	-- Rocket sled track ------------------------------------------------------------------
	pad("SledTrack", 12, 620, 335, 0, C.steel, 0.1, Enum.Material.Metal)
	for z = -300, 300, 40 do
		mark(12, 1, 335, z, C.yellow)
	end
	foamCubes(335, -306, 2, 3, 6, true)

	-- Road network linking every zone ------------------------------------------------------------
	road("NorthRoad", Vector2.new(-310, -300), Vector2.new(258, -300), 22)
	road("SouthRoad", Vector2.new(-310, 306), Vector2.new(258, 306), 22)
	road("WestAvenue", Vector2.new(-286, 0), Vector2.new(-66, 0), 20)
	road("EastAvenue", Vector2.new(66, 30), Vector2.new(266, 30), 20)
	road("NorthLink", Vector2.new(0, -166), Vector2.new(0, -289), 20)
	road("SouthLink", Vector2.new(0, 81), Vector2.new(0, 295), 20)
	crosswalk(-80, 0, 20, true)
	crosswalk(80, 30, 20, true)
	crosswalk(0, 95, 20, false)
	crosswalk(0, -180, 20, false)
	-- stunt jump on the north road: kicker, a 40-stud gap over parked containers, landing ramp
	rampAt("JumpKicker", 18, 9, 30, -190, -300, Vector3.new(1, 0, 0), C.yellow)
	rampAt("JumpLanding", 18, 7, 34, -86, -300, Vector3.new(-1, 0, 0), C.yellow)
	for k = 0, 2 do
		block("GapContainer", Vector3.new(10, 6, 20), Vector3.new(-148 + k * 12, 3, -300), ({ C.red, C.blue, "#3d8f4a" })[k + 1], Enum.Material.Metal)
	end
	sign("JUMP!", Vector3.new(-200, 8, -315), Vector3.new(12, 3, 0.5), 0)
	-- road ramps on the south road: two small kickers to launch into the high-speed track run-off
	rampAt("SouthKicker", 16, 4, 20, 120, 306, Vector3.new(1, 0, 0), C.red)
	rampAt("SouthKicker2", 16, 6, 24, -120, 306, Vector3.new(-1, 0, 0), C.red)
	-- traffic props along the avenues
	for _, p in { { -200, 12 }, { -140, 12 }, { 120, 42 }, { 200, 42 } } do
		block("LampPost", Vector3.new(0.6, 16, 0.6), Vector3.new(p[1], 8, p[2]), C.dark, Enum.Material.Metal)
		block("LampHead", Vector3.new(3.4, 0.5, 1.2), Vector3.new(p[1], 16, p[2] - 1.4), "#fff3c4", Enum.Material.Neon).CanCollide = false
	end

	MapService.scenery(theme.scenery)

	-- Performance pass: nothing on the map needs Touched; flat / tiny / non-solid parts skip shadows
	-- and spatial queries. (Dummies, vehicles and props are the only things that move.)
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanTouch = false
			local sz = d.Size
			if not d.CanCollide then
				d.CanQuery = false
				d.CastShadow = false
			elseif sz.Y < 1.2 or math.max(sz.X, sz.Y, sz.Z) < 3 then
				d.CastShadow = false
			end
			if d.Anchored then
				d.Massless = true
			end
		end
	end
	map.Parent = workspace
	return map, anchor
end

return MapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Crash points, the unlock ladder and the Robux vehicles. Server-authoritative: the client only
-- ever sees the result as two Player attributes:
--   CrashPoints  (number)  lifetime points
--   Unlocked     (string)  comma-separated vehicle keys the player may spawn
-- Saving: one DataStore key per player, written with UpdateAsync that keeps the larger point total,
-- so a failed or out-of-order save can never lose progress. If DataStores are unavailable (Studio
-- without API access, an outage) the game keeps running with session-only progress and says so.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Config = require(game.ReplicatedStorage.Shared.GameConfig)

local P = Config.Progression
local Progression = {}
Progression.notify = nil :: ((Player, string) -> ())?

local sessions = {} :: { [Player]: { points: number, passes: { [string]: boolean }, loaded: boolean, persistent: boolean, dirty: boolean } }
local store = nil
do
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore(P.DATASTORE)
	end)
	store = if ok then s else nil
end

local PAID = {}
for _, p in P.Paid do
	PAID[p.vehicle] = p
end
local LADDER = {}
for i, step in P.Ladder do
	LADDER[step[1]] = { index = i, cost = step[2] }
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function retry(fn, tries: number)
	local delay = 1
	local ok, result
	for attempt = 1, tries do
		ok, result = pcall(fn)
		if ok then
			return true, result
		end
		if attempt < tries then
			task.wait(delay)
			delay *= 2
		end
	end
	return false, result
end

function Progression.canUse(player: Player, vehicle: string): boolean
	local s = sessions[player]
	if not s then
		return vehicle == P.Ladder[1][1]
	end
	if P.StudioUnlockAll and RunService:IsStudio() then
		return true
	end
	if PAID[vehicle] then
		return s.passes[vehicle] == true
	end
	local step = LADDER[vehicle]
	return step ~= nil and s.points >= step.cost
end

-- Why a vehicle is locked, for the message the player sees.
function Progression.lockReason(player: Player, vehicle: string): string
	if PAID[vehicle] then
		return if PAID[vehicle].passId > 0 then "Buy it in the Shop" else "Coming soon to the Shop"
	end
	local step = LADDER[vehicle]
	if step then
		local s = sessions[player]
		return string.format("Unlocks at %d crash points (you have %d)", step.cost, if s then math.floor(s.points) else 0)
	end
	return "Not available"
end

local function publish(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	local list = {}
	for _, step in P.Ladder do
		if Progression.canUse(player, step[1]) then
			table.insert(list, step[1])
		end
	end
	for _, p in P.Paid do
		if Progression.canUse(player, p.vehicle) then
			table.insert(list, p.vehicle)
		end
	end
	player:SetAttribute("CrashPoints", math.floor(s.points))
	player:SetAttribute("Unlocked", table.concat(list, ","))
	player:SetAttribute("ProgressSaved", s.persistent)
end

local function checkPasses(player: Player)
	local s = sessions[player]
	for _, p in P.Paid do
		if p.passId > 0 and not s.passes[p.vehicle] then
			local ok, owns = retry(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.passId)
			end, 2)
			if ok and owns then
				s.passes[p.vehicle] = true
			end
		end
	end
end

function Progression.load(player: Player)
	local s = { points = 0, passes = {}, loaded = false, persistent = false, dirty = false }
	sessions[player] = s
	if store then
		local ok, data = retry(function()
			return store:GetAsync(key(player))
		end, 3)
		if ok then
			if typeof(data) == "table" and typeof(data.points) == "number" and data.points == data.points then
				s.points = math.max(0, data.points)
			end
			s.persistent = true
		end
	end
	if not sessions[player] then
		return -- left while loading
	end
	s.loaded = true
	checkPasses(player)
	publish(player)
	if not s.persistent and Progression.notify then
		Progression.notify(player, "Progress can't be saved right now - it will last this session only")
	end
end

function Progression.save(player: Player)
	local s = sessions[player]
	if not (s and s.loaded and s.persistent and s.dirty and store) then
		return
	end
	local points = s.points
	local ok = retry(function()
		store:UpdateAsync(key(player), function(old)
			local prev = if typeof(old) == "table" and typeof(old.points) == "number" then old.points else 0
			return { points = math.max(prev, points), version = 1 }
		end)
	end, 3)
	if ok then
		s.dirty = false
	end
end

-- Called with every finished crash report. Only reports started by a vehicle count.
function Progression.award(player: Player, report)
	local s = sessions[player]
	if not (s and s.loaded) or typeof(report) ~= "table" or not report.byVehicle then
		return
	end
	local gain = math.clamp(math.floor(tonumber(report.score) or 0), 0, P.MAX_POINTS_PER_CRASH)
	if gain <= 0 then
		return
	end
	local before = {}
	for _, step in P.Ladder do
		before[step[1]] = Progression.canUse(player, step[1])
	end
	s.points += gain
	s.dirty = true
	publish(player)
	for _, step in P.Ladder do
		if not before[step[1]] and Progression.canUse(player, step[1]) and Progression.notify then
			Progression.notify(player, "UNLOCKED: " .. string.upper(step[1]) .. "!")
		end
	end
end

function Progression.grantPass(player: Player, passId: number)
	local s = sessions[player]
	if not s then
		return
	end
	for _, p in P.Paid do
		if p.passId > 0 and p.passId == passId then
			s.passes[p.vehicle] = true
			publish(player)
			if Progression.notify then
				Progression.notify(player, "UNLOCKED: " .. string.upper(p.vehicle) .. "! Thanks for the support")
			end
		end
	end
end

function Progression.points(player: Player): number
	local s = sessions[player]
	return if s then s.points else 0
end

function Progression.init()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(Progression.load, player)
	end)
	for _, player in Players:GetPlayers() do
		if not sessions[player] then
			task.spawn(Progression.load, player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		Progression.save(player)
		sessions[player] = nil
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			Progression.grantPass(player, passId)
		end
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			Progression.save(player)
		end
	end)
	task.spawn(function()
		while task.wait(P.AUTOSAVE_SECONDS) do
			for _, player in Players:GetPlayers() do
				task.spawn(Progression.save, player)
			end
		end
	end)
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RagdollService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Swaps a dummy between animated (Motor6D) and physical (BallSocket / Hinge) joints.
local RagdollService = {}

local UPPER_BODY = { Neck = true, LeftShoulder = true, LeftElbow = true, LeftWrist = true,
	RightShoulder = true, RightElbow = true, RightWrist = true }

local function eachJoint(model: Model, fn: (Motor6D, Constraint, BasePart) -> ())
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Name ~= "Root" then
			local c = (d.Parent :: Instance):FindFirstChild(d.Name .. "Ragdoll")
			if c then
				fn(d, c :: Constraint, d.Parent :: BasePart)
			end
		end
	end
end

local function serverOwn(model: Model)
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and not p.Anchored then
			pcall(function()
				p:SetNetworkOwner(nil)
			end)
		end
	end
end
RagdollService.serverOwn = serverOwn

function RagdollService.isRagdolled(model: Model): boolean
	return model:GetAttribute("Ragdoll") == true
end

-- Full ragdoll: every limb becomes its own physics body.
function RagdollService.enable(model: Model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	model:SetAttribute("Ragdoll", true)
	model:SetAttribute("Stagger", false)
	hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
	hum.PlatformStand = true
	hum.AutoRotate = false
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	eachJoint(model, function(motor, constraint, part)
		constraint.Enabled = true
		motor.Enabled = false
		part.CanCollide = true
	end)
	local lower = model:FindFirstChild("LowerTorso") :: BasePart?
	if lower then
		lower.CanCollide = true
	end
	serverOwn(model)
end

-- Stagger: arms and head go physical while the legs keep balancing.
function RagdollService.stagger(model: Model)
	if RagdollService.isRagdolled(model) then
		return
	end
	model:SetAttribute("Stagger", true)
	eachJoint(model, function(motor, constraint)
		if UPPER_BODY[motor.Name] then
			constraint.Enabled = true
			motor.Enabled = false
		end
	end)
end

function RagdollService.endStagger(model: Model)
	if model:GetAttribute("Stagger") ~= true or RagdollService.isRagdolled(model) then
		return
	end
	model:SetAttribute("Stagger", false)
	eachJoint(model, function(motor, constraint)
		motor.Enabled = true
		constraint.Enabled = false
	end)
end

-- Stand the dummy back up where its torso currently lies. Returns false if no ground was found.
function RagdollService.disable(model: Model, hipHeight: number): boolean
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local lower = model:FindFirstChild("LowerTorso") :: BasePart?
	if not (hum and root and lower) then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model }
	local origin = lower.Position + Vector3.new(0, 3, 0)
	local hit = workspace:Raycast(origin, Vector3.new(0, -40, 0), params)
	if not hit then
		return false
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.1 then
		look = Vector3.new(0, 0, -1)
	end
	local pos = hit.Position + Vector3.new(0, hipHeight + root.Size.Y / 2 + 0.2, 0)
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			p.AssemblyLinearVelocity, p.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		end
	end
	root.CFrame = CFrame.lookAt(pos, pos + look.Unit)
	eachJoint(model, function(motor, constraint)
		motor.Enabled = true
		constraint.Enabled = false
	end)
	model:SetAttribute("Ragdoll", false)
	model:SetAttribute("Stagger", false)
	hum.PlatformStand = false
	hum.AutoRotate = true
	hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
	hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	serverOwn(model)
	return true
end

return RagdollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ScenarioService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Prepared dummy arrangements. Each preset is a list of { x, y, z, yawDegrees, type? } ground points.
local DummyService = require(script.Parent.DummyService)

local ScenarioService = {}
ScenarioService.current = "Showcase"

local function line(n: number, x0: number, dx: number, y: number, z: number, yaw: number?, typeName: string?)
	local t = {}
	for i = 0, n - 1 do
		table.insert(t, { x0 + i * dx, y, z, yaw or 180, typeName })
	end
	return t
end

local function pins(cx: number, y: number, z: number, gap: number)
	local t = {}
	for row = 0, 3 do
		for i = 0, row do
			table.insert(t, { cx + (i - row / 2) * gap, y, z - row * gap * 0.9, 180 })
		end
	end
	return t
end

local function join(...)
	local out = {}
	for _, list in { ... } do
		for _, v in list do
			table.insert(out, v)
		end
	end
	return out
end

local function crowd(cx: number, cz: number, n: number)
	local t, rng = {}, Random.new(7) -- fixed seed: the same crowd every time, so tests are repeatable
	local types = { "Noob", "Noob", "Noob", "Crash", "Light", "Heavy" }
	local tries = 0
	while #t < n and tries < 400 do
		tries += 1
		local a, r = rng:NextNumber(0, math.pi * 2), 3 + rng:NextNumber(0, 1) ^ 0.5 * 13
		local x, z = cx + math.cos(a) * r, cz + math.sin(a) * r
		local free = true
		for _, o in t do -- keep at least 3.2 studs between dummies so nobody spawns inside a neighbour
			if (o[1] - x) ^ 2 + (o[3] - z) ^ 2 < 3.2 ^ 2 then
				free = false
				break
			end
		end
		if free then
			table.insert(t, { x, 0.1, z, rng:NextInteger(0, 359), types[rng:NextInteger(1, #types)] })
		end
	end
	return t
end

ScenarioService.Presets = {
	-- what the player sees on joining: something to hit in every zone
	Showcase = join(
		line(6, -15, 6, 0.1, -40),                 -- central row
		pins(-150, 0.1, -150, 4.5),                -- bowling lane in the dummy field
		line(4, 138, 8, 25.1, -200, 180, "Crash")  -- on the platform past the long ramp
	),
	Line = line(6, -15, 6, 0.1, -40),
	Bowling = pins(0, 0.1, -60, 4.5),
	Crowd = crowd(0, -62, 15),
	Tower = join(
		line(3, -206, 6, 9.1, -160, 180), line(3, -206, 6, 18.1, -160, 180), line(2, -203, 6, 27.1, -160, 180),
		line(4, -244, 6, 9.6, -150, 180, "Light")
	),
	Crossing = join(line(6, -342, 4.8, 0.5, 0, 90, "Crash"), line(3, -336, 6, 0.5, -14, 90)),
	Types = { { -12, 0.1, -40, 180, "Noob" }, { -6, 0.1, -40, 180, "Crash" }, { 0, 0.1, -40, 180, "Heavy" },
		{ 6, 0.1, -40, 180, "Light" }, { 12, 0.1, -40, 180, "Armored" } },
}
ScenarioService.Order = { "Line", "Bowling", "Crowd", "Tower", "Crossing", "Types", "Showcase" }

function ScenarioService.apply(name: string): boolean
	local preset = ScenarioService.Presets[name]
	if not preset then
		return false
	end
	ScenarioService.current = name
	DummyService.clear()
	for _, p in preset do
		DummyService.spawn(p[5] or "Noob", CFrame.new(p[1], p[2], p[3]) * CFrame.Angles(0, math.rad(p[4]), 0), "preset")
	end
	return true
end

return ScenarioService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SceneResetService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Remembers where every loose prop started and puts the whole scene back on request.
local SceneResetService = {}
local props = {} :: { { part: BasePart, cf: CFrame } }

function SceneResetService.capture(folder: Instance)
	table.clear(props)
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") and not d.Anchored then
			table.insert(props, { part = d, cf = d.CFrame })
		end
	end
end

function SceneResetService.resetProps()
	for _, p in props do
		if p.part.Parent then
			p.part.AssemblyLinearVelocity, p.part.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			p.part.CFrame = p.cf
		end
	end
end

-- Props knocked more than 4 studs from where they started (used by the crash report).
function SceneResetService.countDisturbed(): number
	local n = 0
	for _, p in props do
		if p.part.Parent and (p.part.Position - p.cf.Position).Magnitude > 4 then
			n += 1
		end
	end
	return n
end

return SceneResetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">VehicleService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Spawning, replacing, resetting and deleting vehicles, plus cosmetic crash damage.
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.GameConfig)
local Specs = require(Shared.VehicleSpecs)
local VehicleBuilder = require(Shared.VehicleBuilder)

local VehicleService = {}
local folder: Folder
local railAnchor: BasePart
local order = {} :: { Model } -- oldest first

local function spawnCFrame(spec, slot: number): CFrame
	local s = Config.Map.Spawns[spec.spawn] or Config.Map.Spawns.Road
	return CFrame.new(s[1] + slot, s[2] + 0.3, s[3]) * CFrame.Angles(0, math.rad(s[4]), 0)
end

local function clearSpot(model: Model, spec): CFrame
	-- slide sideways until the spawn box is free of other vehicles
	local size = model.PrimaryPart.Size
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local step = size.X + 5
	for i = 0, 4 do
		local offset = if spec.phys.kind == "train" then 0 else (if i % 2 == 0 then 1 else -1) * math.ceil(i / 2) * step
		local cf = spawnCFrame(spec, offset)
		if spec.phys.kind == "train" or #workspace:GetPartBoundsInBox(cf * CFrame.new(0, size.Y / 2, 0), size, params) == 0 then
			return cf
		end
	end
	return spawnCFrame(spec, 0)
end

local function attachTrain(model: Model)
	local root = model.PrimaryPart
	local along = CFrame.Angles(0, math.rad(90), 0) -- attachment X axis -> world -Z (down the track)
	local a0 = Instance.new("Attachment")
	a0.CFrame = railAnchor.CFrame:ToObjectSpace(CFrame.new(root.Position) * along)
	a0.Parent = railAnchor
	local a1 = Instance.new("Attachment")
	a1.CFrame = root.CFrame:ToObjectSpace(CFrame.new(root.Position) * along)
	a1.Parent = root
	local rail = Instance.new("PrismaticConstraint")
	rail.Name = "Rail"
	rail.Attachment0, rail.Attachment1 = a0, a1
	rail.LimitsEnabled, rail.LowerLimit, rail.UpperLimit = true, -4, 566
	rail.Parent = root
	model.Destroying:Connect(function()
		a0:Destroy()
	end)
end

function VehicleService.init(vehicleFolder: Folder, anchor: BasePart)
	folder = vehicleFolder
	railAnchor = anchor
	task.spawn(function()
		while task.wait(1) do
			for _, v in folder:GetChildren() do
				local root = (v :: Model).PrimaryPart
				if root then
					local p = root.Position
					if p ~= p or p.Y < -60 or p.Magnitude > 1600 then
						VehicleService.reset(v :: Model)
					end
				end
			end
		end
	end)
end

function VehicleService.setRailAnchor(anchor: BasePart)
	railAnchor = anchor
end

function VehicleService.current(player: Player): Model?
	for i = #order, 1, -1 do
		if order[i].Parent and order[i]:GetAttribute("Owner") == player.UserId then
			return order[i]
		end
	end
	return nil
end

function VehicleService.delete(model: Model)
	local i = table.find(order, model)
	if i then
		table.remove(order, i)
	end
	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat?
	if seat and seat.Occupant then
		seat.Occupant.Sit = false
	end
	task.defer(model.Destroy, model)
end

function VehicleService.spawn(player: Player, key: string, seatPlayer: boolean?): Model?
	local spec = Specs.Vehicles[key]
	if not spec then
		return nil
	end
	while #order >= Config.MAX_VEHICLES do
		VehicleService.delete(order[1])
	end
	local model = VehicleBuilder.build(key)
	local cf = clearSpot(model, spec)
	model:PivotTo(cf)
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("DamageLevel", 0)
	model:SetAttribute("SpawnId", os.clock())
	model.Parent = folder
	table.insert(order, model)
	local root = model.PrimaryPart
	if spec.phys.kind == "train" then
		attachTrain(model)
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Drive"
	prompt.ObjectText = spec.display
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = math.max(14, root.Size.Magnitude * 0.6)
	prompt.HoldDuration = 0
	prompt.Parent = root
	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat
	prompt.Triggered:Connect(function(who)
		local hum = who.Character and who.Character:FindFirstChildOfClass("Humanoid")
		if hum and not seat.Occupant then
			seat:Sit(hum)
		end
	end)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		prompt.Enabled = seat.Occupant == nil
	end)

	-- single-player sandbox: the player simulates their vehicle for latency-free driving
	pcall(function()
		root:SetNetworkOwner(player)
	end)
	if seatPlayer then
		task.delay(0.15, function()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and model.Parent and hum.Health > 0 then
				if hum.SeatPart then
					hum.Sit = false
					task.wait(0.1)
				end
				seat:Sit(hum)
			end
		end)
	end
	return model
end

-- Fresh copy at the spawn point: restores position, velocity, parts and cosmetic damage in one go.
function VehicleService.reset(model: Model): Model?
	local key = model:GetAttribute("VehicleKey")
	local player = game.Players:GetPlayerByUserId(model:GetAttribute("Owner") or 0)
	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat?
	local wasSeated = seat ~= nil and seat.Occupant ~= nil
	local i = table.find(order, model)
	if i then
		table.remove(order, i)
	end
	if seat and seat.Occupant then
		seat.Occupant.Sit = false
	end
	model:Destroy()
	if player then
		return VehicleService.spawn(player, key, wasSeated)
	end
	return nil
end

function VehicleService.deleteAll()
	for i = #order, 1, -1 do
		VehicleService.delete(order[i])
	end
end

-- Cosmetic crash damage, driven by real collision severity (dv = velocity lost in one step).
local function retilt(part: BasePart?, offset: CFrame)
	if not part then
		return
	end
	local w = part:FindFirstChildOfClass("WeldConstraint")
	if w then
		w.Enabled = false
		part.CFrame = part.CFrame * offset
		w.Enabled = true
	end
end

function VehicleService.onCrash(model: Model, dv: number)
	local level = model:GetAttribute("DamageLevel") or 0
	local target = if dv > 90 then 3 elseif dv > 55 then 2 else 1
	if target <= level then
		return
	end
	model:SetAttribute("DamageLevel", target)
	if level < 1 then
		retilt(model:FindFirstChild("BumperF") :: BasePart?, CFrame.Angles(0, 0, math.rad(7)))
		for _, n in { "HeadlightL", "HeadlightR" } do
			local l = model:FindFirstChild(n) :: BasePart?
			if l and math.random() < 0.5 then
				l.Material = Enum.Material.SmoothPlastic
				l.Color = Color3.fromHex("#55585f")
				local s = l:FindFirstChildOfClass("SpotLight")
				if s then
					s.Enabled = false
				end
			end
		end
	end
	if target >= 2 and level < 2 then
		local hood = model:FindFirstChild("Hood") :: BasePart?
		if hood then -- pop the hood open about its rear edge
			local half = hood.Size.Z / 2
			retilt(hood, CFrame.new(0, 0, half) * CFrame.Angles(math.rad(32), 0, 0) * CFrame.new(0, 0, -half))
		end
	end
	if target >= 3 and level < 3 then
		for _, n in { "BumperF", "Spoiler" } do
			local part = model:FindFirstChild(n) :: BasePart?
			local w = part and part:FindFirstChildOfClass("WeldConstraint")
			if part and w then
				w:Destroy()
				part.Massless = false
				part.CanCollide = true
				part.CollisionGroup = "Prop"
				part.Parent = workspace
				game:GetService("Debris"):AddItem(part, 10)
			end
		end
	end
end

return VehicleService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="25">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">120</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- All sound. IDs come from Shared/AudioIds (Creator Store assets). Handles engine loops whose pitch
-- follows speed, variation picking, distance roll-off and a hard cap on overlapping impact sounds.
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local AudioIds = require(Shared.AudioIds)
local Specs = require(Shared.VehicleSpecs)
local Settings = require(script.Parent.Settings)

local Audio = {}
local master, sfx, music, ui
local rng = Random.new()
local recent = {} :: { number } -- timestamps of recent 3D one-shots (spam limiter)
local lastByName = {} :: { [string]: number }
local MAX_PER_WINDOW, WINDOW = 6, 0.35

local function group(name: string, parent: Instance): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = name
	g.Parent = parent
	return g
end

local function applyVolumes()
	master.Volume = Settings.get("MasterVolume")
	local on = if Settings.get("SoundEffects") then 1 else 0
	sfx.Volume = Settings.get("SfxVolume") * on
	ui.Volume = Settings.get("SfxVolume") * on
	music.Volume = Settings.get("MusicVolume")
end

local function pick(name: string): string?
	local list = AudioIds.OneShot[name]
	return list and list[rng:NextInteger(1, #list)]
end

-- 2D interface sound
function Audio.ui(name: string, volume: number?)
	local id = pick(name)
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.SoundGroup = ui
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 6)
end

-- 3D one-shot at a world position, rate limited so a 15-dummy pile-up is punchy, not deafening
function Audio.at(name: string, position: Vector3, volume: number?, pitch: number?, minGap: number?)
	local now = os.clock()
	if minGap and lastByName[name] and now - lastByName[name] < minGap then
		return
	end
	for i = #recent, 1, -1 do
		if now - recent[i] > WINDOW then
			table.remove(recent, i)
		end
	end
	if #recent >= MAX_PER_WINDOW then
		return
	end
	local id = pick(name)
	if not id then
		return
	end
	table.insert(recent, now)
	lastByName[name] = now
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = (pitch or 1) * rng:NextNumber(0.93, 1.07)
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance, s.RollOffMaxDistance = 18, 420
	s.SoundGroup = sfx
	s.Parent = att
	s:Play()
	Debris:AddItem(att, 8)
end

-- Engine loops ------------------------------------------------------------------
local engines = {} :: { [Model]: { engine: Sound, layer: Sound?, skid: Sound?, cfg: any, max: number } }

local function loop(parent: Instance, id: string, volume: number): Sound
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance, s.RollOffMaxDistance = 25, 600
	s.SoundGroup = sfx
	s:SetAttribute("BaseVolume", volume)
	s.Parent = parent
	s:Play()
	return s
end

local function addVehicle(model: Model)
	local root = model:WaitForChild("Root", 5) :: BasePart?
	local key = model:GetAttribute("VehicleKey")
	local map = AudioIds.Vehicle[key]
	if not root or not map then
		return
	end
	local cfg = AudioIds.Engine[map.engine]
	local e = { engine = loop(root, cfg.id, cfg.volume), cfg = cfg, max = Specs.Vehicles[key].phys.maxSpeed }
	if map.layer then
		e.layer = loop(root, AudioIds.Layer[map.layer].id, AudioIds.Layer[map.layer].volume)
	end
	if #Specs.Vehicles[key].wheels > 0 then
		e.skid = loop(root, AudioIds.Layer.skid.id, AudioIds.Layer.skid.volume)
	end
	engines[model] = e
	Audio.at("spawnVehicle", root.Position, 0.5)
end

function Audio.horn(model: Model)
	local map = AudioIds.Vehicle[model:GetAttribute("VehicleKey")]
	if map and map.horn and model.PrimaryPart then
		Audio.at(map.horn, model.PrimaryPart.Position, 0.8, 1, 0.6)
	end
end

function Audio.init()
	master = group("RCP_Master", SoundService)
	sfx, music, ui = group("SFX", master), group("Music", master), group("UI", master)
	applyVolumes()
	Settings.Changed:Connect(applyVolumes)
	local bgm = Instance.new("Sound")
	bgm.Name = "Music"
	bgm.SoundId = AudioIds.Music
	bgm.Looped = true
	bgm.Volume = 0.35
	bgm.SoundGroup = music
	bgm.Parent = SoundService
	bgm:Play()
	local folder = workspace:WaitForChild("Vehicles")
	folder.ChildAdded:Connect(function(m)
		task.spawn(addVehicle, m :: Model)
	end)
	folder.ChildRemoved:Connect(function(m)
		engines[m :: Model] = nil
	end)
	for _, m in folder:GetChildren() do
		task.spawn(addVehicle, m :: Model)
	end
	RunService.Heartbeat:Connect(function(dt)
		for model, e in engines do
			local root = model.PrimaryPart
			if not root then
				continue
			end
			local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat?
			local on = seat ~= nil and seat.Occupant ~= nil
			local power = model:GetAttribute("ClientPower") or 0
			local v = root.AssemblyLinearVelocity
			local speedF = math.clamp(v.Magnitude / e.max, 0, 1)
			local rev = math.clamp(speedF * 0.75 + power * 0.25, 0, 1)
			local k = math.min(1, dt * 8)
			local targetVol = if on then e.engine:GetAttribute("BaseVolume") * (0.55 + 0.45 * rev) else 0
			e.engine.Volume += (targetVol - e.engine.Volume) * k
			e.engine.PlaybackSpeed = e.cfg.pitch[1] + (e.cfg.pitch[2] - e.cfg.pitch[1]) * rev
			if e.layer then
				e.layer.Volume += (e.layer:GetAttribute("BaseVolume") * speedF - e.layer.Volume) * k
				e.layer.PlaybackSpeed = 0.8 + 0.5 * speedF
			end
			if e.skid then
				local lat = math.abs(v:Dot(root.CFrame.RightVector))
				local skidding = lat > 14 and v.Magnitude > 20
				e.skid.Volume += ((if skidding then e.skid:GetAttribute("BaseVolume") else 0) - e.skid.Volume) * k
			end
		end
	end)
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Camera modes (Follow Vehicle / Follow Dummy / Free) and a short, decaying impact shake.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Settings = require(script.Parent.Settings)

local Camera = {}
Camera.mode = "Vehicle"
local player = Players.LocalPlayer
local shake = 0
local freePart: Part? = nil
local rng = Random.new()

local function controls()
	local ok, module = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
	end)
	return if ok then module else nil
end

local function humanoid(): Humanoid?
	return player.Character and player.Character:FindFirstChildOfClass("Humanoid")
end

function Camera.shake(amount: number)
	if Settings.get("CameraShake") then
		shake = math.min(1.2, math.max(shake, amount))
	end
end

-- Push the default camera out so a whole bus / plane fits on screen.
function Camera.frameVehicle(model: Model)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local d = math.clamp(root.Size.Magnitude * 0.9 + 12, 22, 110)
	player.CameraMaxZoomDistance = 260
	player.CameraMinZoomDistance = d
	task.delay(0.1, function()
		player.CameraMinZoomDistance = 0.5
	end)
end

function Camera.setMode(mode: string, target: Instance?)
	local cam = workspace.CurrentCamera
	if freePart then
		freePart:Destroy()
		freePart = nil
		local c = controls()
		if c then
			c:Enable()
		end
	end
	Camera.mode = mode
	cam.CameraType = Enum.CameraType.Custom
	if mode == "Dummy" and target then
		cam.CameraSubject = target
	elseif mode == "Free" then
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.Transparency = true, false, false, 1
		p.Size = Vector3.one
		p.CFrame = CFrame.new(cam.Focus.Position)
		p.Parent = cam
		freePart = p
		cam.CameraSubject = p
		local c = controls()
		if c then
			c:Disable()
		end
	else
		Camera.mode = "Vehicle"
		cam.CameraSubject = humanoid()
	end
end

function Camera.init()
	player.CameraMaxZoomDistance = 260
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		if Camera.mode == "Vehicle" then
			Camera.setMode("Vehicle")
		end
	end)
	RunService:BindToRenderStep("RCP_Camera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		if freePart then
			local m = Vector3.zero
			local function key(k: Enum.KeyCode): number
				return if UserInputService:IsKeyDown(k) then 1 else 0
			end
			m += cam.CFrame.LookVector * (key(Enum.KeyCode.W) - key(Enum.KeyCode.S))
			m += cam.CFrame.RightVector * (key(Enum.KeyCode.D) - key(Enum.KeyCode.A))
			m += Vector3.yAxis * (key(Enum.KeyCode.E) - key(Enum.KeyCode.Q))
			local speed = if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then 160 else 60
			freePart.CFrame += m * speed * dt
		elseif Camera.mode == "Dummy" and (not cam.CameraSubject or not cam.CameraSubject.Parent) then
			Camera.setMode("Vehicle")
		end
		if shake > 0.01 then
			local a = shake * 0.035
			cam.CFrame *= CFrame.Angles(rng:NextNumber(-a, a), rng:NextNumber(-a, a), rng:NextNumber(-a, a) * 0.5)
			shake *= math.exp(-dt * 7) -- gone in about half a second
		end
	end)
end

return Camera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DummyInspectionController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Click / tap a dummy to inspect it. Everything shown is read from attributes that only the
-- server writes (DummyService.publish), so the panel can never disagree with the simulation.
local RunService = game:GetService("RunService")
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local DamageModel = require(Shared.DamageModel)
local Gui = require(script.Parent.Gui)
local Visuals = require(script.Parent.DummyVisuals)
local Camera = require(script.Parent.CameraController)
local Audio = require(script.Parent.AudioController)

local Inspect = {}
local panel: Frame
local title, statusL, healthL, lastL: TextLabel
local healthFill: Frame
local rows = {} :: { [string]: TextLabel }
local scan = {} :: { [string]: Frame }
local request: RemoteEvent

local function condColor(cond: number): Color3
	if cond >= 85 then
		return Color3.fromHex("#4cd787")
	elseif cond >= 60 then
		return Color3.fromHex("#d6e04a")
	elseif cond >= 35 then
		return Color3.fromHex("#ffb84d")
	elseif cond > 10 then
		return Color3.fromHex("#ff7a45")
	end
	return Color3.fromHex("#b03a3a")
end

local function refresh()
	local m = Visuals.selected
	if not m or not m.Parent then
		panel.Visible = false
		return
	end
	panel.Visible = true
	local t = Config.DummyTypes[m:GetAttribute("DummyType")] or Config.DummyTypes.Noob
	local status = m:GetAttribute("Status") or "HEALTHY"
	title.Text = string.format("%s #%02d", m:GetAttribute("Display") or "DUMMY", m:GetAttribute("DummyId") or 0)
	statusL.Text = "Status: " .. status
	statusL.TextColor3 = Color3.fromHex(Config.StatusColors[m:GetAttribute("StatusPrimary") or "HEALTHY"] or "#ffffff")
	local hp = m:GetAttribute("Health") or 0
	healthL.Text = string.format("Health: %d / %d", hp, t.health)
	healthFill.Size = UDim2.fromScale(math.clamp(hp / t.health, 0, 1), 1)
	healthFill.BackgroundColor3 = condColor(hp / t.health * 100)
	for _, r in DamageModel.REGIONS do
		local cond = m:GetAttribute("Cond" .. r) or 100
		rows[r].Text = string.format("%s: %s", string.gsub(DamageModel.REGION_LABEL[r], "(%a)(%a*)", function(a, b)
			return a .. string.lower(b)
		end), DamageModel.regionLabel(cond / 100))
		rows[r].TextColor3 = if cond >= 85 then Gui.T.dim else condColor(cond)
		scan[r].BackgroundColor3 = condColor(cond)
	end
	local src = m:GetAttribute("LastSource")
	lastL.Text = if src and src ~= "" then string.format("Last Impact: %s\nLast Impact Speed: %d MPH", src, m:GetAttribute("LastSpeedMph") or 0)
		else "Last Impact: none"
end

function Inspect.select(model: Model?)
	Visuals.select(model)
	if model then
		Audio.ui("uiSelect", 0.4)
	end
	refresh()
end

function Inspect.init(screen: ScreenGui, mobile: boolean, remotes: Instance)
	request = remotes:WaitForChild("Request") :: RemoteEvent
	local w = if mobile then 210 else 250
	panel = Gui.panel({ Name = "Inspection", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, if mobile then -150 else -16),
		Size = UDim2.fromOffset(w, 372), Visible = false, Parent = screen }, { Gui.padding(12) })
	title = Gui.label("DUMMY", 17, { Font = Gui.T.black, Parent = panel })
	Gui.button("✕", { Size = UDim2.fromOffset(26, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, -2), Parent = panel }, function()
		Inspect.select(nil)
	end)
	statusL = Gui.label("", 14, { Position = UDim2.fromOffset(0, 26), Font = Gui.T.bold, Parent = panel })
	healthL = Gui.label("", 13, { Position = UDim2.fromOffset(0, 48), Parent = panel })
	local bar = Gui.make("Frame", { Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = Gui.T.panel2, Parent = panel }, { Gui.corner(4) })
	healthFill = Gui.make("Frame", { Size = UDim2.fromScale(1, 1), Parent = bar }, { Gui.corner(4) })

	-- Body scan: a tiny blocky dummy whose parts take the colour of each region's condition.
	local body = Gui.make("Frame", { Position = UDim2.fromOffset(0, 88), Size = UDim2.fromOffset(74, 118), BackgroundTransparency = 1, Parent = panel })
	local function blockPart(name: string, x: number, y: number, sx: number, sy: number)
		scan[name] = Gui.make("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(sx, sy), Parent = body }, { Gui.corner(3), Gui.stroke(Gui.T.panel, 1) })
	end
	blockPart("Head", 24, 0, 26, 24)
	blockPart("Torso", 18, 26, 38, 42)
	blockPart("RightArm", 0, 26, 16, 42) -- the dummy faces the viewer, so its right arm is on our left
	blockPart("LeftArm", 58, 26, 16, 42)
	blockPart("RightLeg", 18, 70, 18, 44)
	blockPart("LeftLeg", 38, 70, 18, 44)
	local list = Gui.make("Frame", { Position = UDim2.fromOffset(84, 88), Size = UDim2.new(1, -84, 0, 118), BackgroundTransparency = 1, Parent = panel }, { Gui.list(1) })
	for _, r in DamageModel.REGIONS do
		rows[r] = Gui.label("", 11, { Size = UDim2.new(1, 0, 0, 18), TextWrapped = true, Parent = list })
	end
	lastL = Gui.label("", 12, { Position = UDim2.fromOffset(0, 212), Size = UDim2.new(1, 0, 0, 34), TextColor3 = Gui.T.dim,
		TextYAlignment = Enum.TextYAlignment.Top, Parent = panel })

	local grid = Gui.make("Frame", { Position = UDim2.fromOffset(0, 254), Size = UDim2.new(1, 0, 0, 92), BackgroundTransparency = 1, Parent = panel },
		{ Gui.make("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 42), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local function action(text: string, color: Color3, i: number, fn: () -> ())
		Gui.button(text, { LayoutOrder = i, TextSize = 13, BackgroundColor3 = color, Parent = grid }, function()
			Audio.ui("uiClick")
			fn()
		end)
	end
	local function send(what: string)
		local m = Visuals.selected
		if m then
			request:FireServer("DummyAction", m:GetAttribute("DummyId"), what)
		end
	end
	action("REVIVE", Color3.fromHex("#1f7a4d"), 1, function()
		send("Revive")
	end)
	action("RESET", Gui.T.panel2, 2, function()
		send("Reset")
		Inspect.select(nil)
	end)
	action("DELETE", Color3.fromHex("#7a2b2b"), 3, function()
		Audio.ui("uiDelete")
		send("Delete")
		Inspect.select(nil)
	end)
	action("FOLLOW CAMERA", Color3.fromHex("#245a9c"), 4, function()
		local m = Visuals.selected
		if Camera.mode == "Dummy" then
			Camera.setMode("Vehicle")
		elseif m and m:FindFirstChild("UpperTorso") then
			Camera.setMode("Dummy", m.UpperTorso)
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 0.15 then
			acc = 0
			if panel.Visible or Visuals.selected then
				refresh()
			end
		end
	end)
end

return Inspect
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DummyVisuals</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client-side dummy presentation: the animated face and the floating status label.
--
-- FACE: every dummy wears a procedurally drawn face in the style of Roblox's "Man" face
-- (flat heavy brows, half-lidded eyes, long smirk with a cheek line). It is built from Frames on a
-- SurfaceGui so it can be ANIMATED: it blinks while healthy and morphs between expressions as the
-- server-side damage state changes (attribute "Face", written only by DummyService):
--   Normal -> Surprised (the instant it is hit) -> Dizzy (staggering / tumbling) -> Hurt (damaged)
--   -> Unconscious (eyes shut) -> Dead (X eyes).
-- LABEL: BillboardGui showing "DUMMY #04 / DOWN · BLEEDING", coloured by the primary status.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Settings = require(script.Parent.Settings)

local Visuals = {}
Visuals.selected = nil :: Model?
local faces = {} :: { [Model]: any }
local INK = Color3.fromHex("#111111")
local rng = Random.new()

-- Expression parameters on a 200 x 200 canvas.
-- brow = { y, tilt (deg, + = inner end lower -> stern), raise }, lid = fraction of the eye covered,
-- pupil = scale, mouth = three control points of a quadratic curve, open = size of an open mouth.
local EXPR = {
	Normal = { browY = 62, tilt = 7, lid = 0.38, pupil = 1, mouth = { 56, 152, 112, 162, 150, 134 }, open = 0, cheek = 1 },
	Surprised = { browY = 44, tilt = -9, lid = 0, pupil = 0.6, mouth = { 84, 152, 100, 152, 116, 152 }, open = 34, cheek = 0 },
	Dizzy = { browY = 54, tilt = -14, lid = 0.15, pupil = 0.8, mouth = { 62, 150, 100, 166, 140, 146 }, open = 0, cheek = 0, spin = true, wobble = true },
	Hurt = { browY = 58, tilt = -16, lid = 0.5, pupil = 0.9, mouth = { 62, 156, 100, 138, 140, 156 }, open = 0, cheek = 0 },
	Unconscious = { browY = 60, tilt = -6, lid = 1, pupil = 1, mouth = { 78, 150, 100, 153, 122, 150 }, open = 0, cheek = 0 },
	Dead = { browY = 56, tilt = -4, lid = 0, pupil = 0, mouth = { 70, 152, 100, 150, 130, 152 }, open = 0, cheek = 0, x = true },
}
local EYE_X = { 62, 138 }
local EYE_Y, EYE_W, EYE_H = 90, 46, 22
local SEGMENTS = 8

local draw

local function frame(parent: Instance, color: Color3, round: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(round, 0)
		c.Parent = f
	end
	f.Parent = parent
	return f
end

-- FACS targets for the animatable Man head (FaceControls). 0 = neutral Man smirk.
local FACS = {
	Normal = {},
	Surprised = { JawDrop = 0.75, LeftEyeUpperLidRaiser = 1, RightEyeUpperLidRaiser = 1, LeftInnerBrowRaiser = 1, RightInnerBrowRaiser = 1,
		LeftOuterBrowRaiser = 0.8, RightOuterBrowRaiser = 0.8, Funneler = 0.3 },
	Dizzy = { JawDrop = 0.3, LeftEyeClosed = 0.35, RightEyeClosed = 0.15, LeftBrowLowerer = 0.5, RightOuterBrowRaiser = 0.6, MouthLeft = 0.3 },
	Hurt = { Corrugator = 1, LeftBrowLowerer = 0.8, RightBrowLowerer = 0.8, LeftCheekRaiser = 0.7, RightCheekRaiser = 0.7, LeftLipCornerDown = 0.8,
		RightLipCornerDown = 0.8, LeftEyeClosed = 0.3, RightEyeClosed = 0.3, LeftLipStretcher = 0.4, RightLipStretcher = 0.4 },
	Unconscious = { LeftEyeClosed = 1, RightEyeClosed = 1, JawDrop = 0.2, LeftLipCornerDown = 0.3, RightLipCornerDown = 0.3 },
	Dead = { LeftEyeClosed = 1, RightEyeClosed = 1, JawDrop = 0.45, TongueOut = 0.6, TongueDown = 0.3, JawLeft = 0.3 },
}
local FACS_KEYS = {}
do
	local seen = { EyesLookLeft = true, EyesLookRight = true, EyesLookUp = true, EyesLookDown = true }
	for _, set in FACS do
		for k in set do
			seen[k] = true
		end
	end
	for k in seen do
		table.insert(FACS_KEYS, k)
	end
end

local function stepFacs(f, dt: number, now: number)
	local target = FACS[f.target] or FACS.Normal
	local fc = f.facs
	local k = math.min(1, dt * (if f.target == "Surprised" then 22 else 7))
	local busy = false
	for _, key in FACS_KEYS do
		local want = target[key] or 0
		if f.target == "Dizzy" then -- eyes roll around
			if key == "EyesLookLeft" then
				want = math.max(0, math.sin(now * 7))
			elseif key == "EyesLookRight" then
				want = math.max(0, -math.sin(now * 7))
			elseif key == "EyesLookUp" then
				want = math.max(0, math.cos(now * 7))
			elseif key == "EyesLookDown" then
				want = math.max(0, -math.cos(now * 7))
			end
		end
		if (key == "LeftEyeClosed" or key == "RightEyeClosed") and f.blink > want then
			want = f.blink
		end
		local cur = f.vals[key] or 0
		if math.abs(cur - want) > 0.004 then
			cur += (want - cur) * k
			f.vals[key] = cur
			fc[key] = cur
			busy = true
		end
	end
	if f.target == "Normal" or f.target == "Hurt" then
		if now >= f.nextBlink then
			local phase = (now - f.nextBlink) / 0.16
			if phase >= 1 then
				f.blink = 0
				f.nextBlink = now + rng:NextNumber(2, 6)
			else
				f.blink = math.sin(phase * math.pi)
			end
		end
	else
		f.blink = 0
	end
	return busy
end

local function buildFace(model: Model)
	local head = model:WaitForChild("Head", 5) :: BasePart?
	if not head then
		return
	end
	local facs = head:FindFirstChildOfClass("FaceControls")
	if facs then
		local f = { facs = facs, head = head, target = model:GetAttribute("Face") or "Normal", vals = {}, t = 1, blink = 0,
			nextBlink = os.clock() + rng:NextNumber(1, 5) }
		faces[model] = f
		model:GetAttributeChangedSignal("Face"):Connect(function()
			f.target = model:GetAttribute("Face") or "Normal"
		end)
		return f
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Face"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(200, 200)
	gui.LightInfluence = 1
	gui.Parent = head
	local f = { gui = gui, head = head, brows = {}, eyes = {}, mouth = {}, cur = table.clone(EXPR.Normal), from = nil,
		target = "Normal", t = 1, nextBlink = os.clock() + rng:NextNumber(1, 5), blink = 0 }
	f.cur.mouth = table.clone(EXPR.Normal.mouth)
	for i = 1, 2 do
		f.brows[i] = frame(gui, INK, 0.5)
		f.brows[i].Size = UDim2.fromOffset(58, 10)
		local eye = frame(gui, Color3.new(1, 1, 1), 0.45)
		eye.Size = UDim2.fromOffset(EYE_W, EYE_H)
		eye.Position = UDim2.fromOffset(EYE_X[i], EYE_Y)
		eye.ClipsDescendants = true
		local pupil = frame(eye, INK, 1)
		local lid = frame(eye, head.Color) -- upper eyelid in skin colour: this is what makes the stare half-lidded
		lid.AnchorPoint = Vector2.new(0.5, 0)
		lid.Position = UDim2.fromScale(0.5, 0)
		local line = frame(gui, INK, 0.5) -- lash line that rides the lid's lower edge
		line.Size = UDim2.fromOffset(EYE_W + 6, 5)
		local x1, x2 = frame(gui, INK, 0.5), frame(gui, INK, 0.5)
		for _, x in { x1, x2 } do
			x.Size = UDim2.fromOffset(36, 7)
			x.Position = UDim2.fromOffset(EYE_X[i], EYE_Y)
			x.Visible = false
		end
		x1.Rotation, x2.Rotation = 45, -45
		f.eyes[i] = { eye = eye, pupil = pupil, lid = lid, line = line, x = { x1, x2 } }
	end
	for i = 1, SEGMENTS do
		f.mouth[i] = frame(gui, INK, 0.5)
	end
	f.open = frame(gui, INK, 0.5)
	f.cheek = frame(gui, INK, 0.5)
	f.cheek.Size = UDim2.fromOffset(5, 44)
	f.cheek.Position = UDim2.fromOffset(166, 138)
	f.cheek.Rotation = 14
	faces[model] = f
	draw(f, os.clock())
	Visuals.setFace(model, model:GetAttribute("Face") or "Normal")
	model:GetAttributeChangedSignal("Face"):Connect(function()
		Visuals.setFace(model, model:GetAttribute("Face") or "Normal")
	end)
	return f
end

function Visuals.setFace(model: Model, name: string)
	local f = faces[model]
	if not f or f.facs or not EXPR[name] or f.target == name then
		return
	end
	f.target = name
	f.from = table.clone(f.cur)
	f.from.mouth = table.clone(f.cur.mouth)
	f.t = 0
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function draw(f, now: number)
	local c, e = f.cur, EXPR[f.target]
	local lidNow = math.max(c.lid, f.blink)
	for i = 1, 2 do
		local side = if i == 1 then 1 else -1
		local brow, eye = f.brows[i], f.eyes[i]
		local wob = if e.wobble then math.sin(now * 7 + i * 2) * 3 else 0
		brow.Position = UDim2.fromOffset(EYE_X[i], c.browY + wob)
		brow.Rotation = c.tilt * side
		eye.lid.Size = UDim2.new(1, 0, lidNow, 0)
		eye.line.Position = UDim2.fromOffset(EYE_X[i], EYE_Y - EYE_H / 2 + EYE_H * lidNow)
		eye.line.Visible = not e.x or f.t < 1
		local ps = 18 * c.pupil
		eye.pupil.Size = UDim2.fromOffset(ps, ps)
		local ox, oy = 0, 2
		if e.spin then
			ox, oy = math.cos(now * 9 + i) * 9, math.sin(now * 9 + i) * 4 + 2
		end
		eye.pupil.Position = UDim2.new(0.5, ox, 0.5, oy)
		local showX = e.x == true and f.t >= 0.5
		eye.eye.Visible = not showX
		eye.line.Visible = not showX
		eye.x[1].Visible, eye.x[2].Visible = showX, showX
	end
	local m = c.mouth
	local wave = if e.wobble then math.sin(now * 6) * 5 else 0
	local px, py
	for i = 0, SEGMENTS do
		local t = i / SEGMENTS
		local a, b = (1 - t) * (1 - t), 2 * (1 - t) * t
		local x = a * m[1] + b * m[3] + t * t * m[5]
		local y = a * m[2] + b * (m[4] + wave) + t * t * m[6]
		if i > 0 then
			local seg = f.mouth[i]
			local dx, dy = x - px, y - py
			seg.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 5, 6)
			seg.Position = UDim2.fromOffset((x + px) / 2, (y + py) / 2)
			seg.Rotation = math.deg(math.atan2(dy, dx))
			seg.Visible = c.open < 12
		end
		px, py = x, y
	end
	f.open.Visible = c.open >= 4
	f.open.Size = UDim2.fromOffset(c.open * 0.85, c.open)
	f.open.Position = UDim2.fromOffset(100, 152)
	f.cheek.BackgroundTransparency = 1 - c.cheek
end

local function stepFace(f, dt: number, now: number)
	local e = EXPR[f.target]
	local animating = false
	if f.t < 1 then
		f.t = math.min(1, f.t + dt / (if f.target == "Surprised" then 0.08 else 0.28))
		local k = 1 - (1 - f.t) ^ 3
		for _, key in { "browY", "tilt", "lid", "pupil", "open", "cheek" } do
			f.cur[key] = lerp(f.from[key], e[key], k)
		end
		for i = 1, 6 do
			f.cur.mouth[i] = lerp(f.from.mouth[i], e.mouth[i], k)
		end
		animating = true
	end
	-- blinking only while the eyes are open and the dummy is calm
	if f.target == "Normal" or f.target == "Hurt" then
		if now >= f.nextBlink then
			local phase = (now - f.nextBlink) / 0.16
			if phase >= 1 then
				f.blink = 0
				f.nextBlink = now + rng:NextNumber(2, 6)
			else
				f.blink = math.sin(phase * math.pi)
			end
			animating = true
		end
	else
		f.blink = 0
	end
	if animating or e.spin or e.wobble then
		draw(f, now)
	end
end

-- Labels ---------------------------------------------------------------------------
local labels = {} :: { [Model]: { gui: BillboardGui, name: TextLabel, status: TextLabel } }

local function buildLabel(model: Model)
	local head = model:WaitForChild("Head", 5) :: BasePart?
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "StatusLabel"
	gui.Adornee = head
	gui.Size = UDim2.fromScale(9, 2.1)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.3, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Parent = head
	local function text(y: number, h: number, bold: boolean): TextLabel
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, h)
		t.Position = UDim2.fromScale(0, y)
		t.TextScaled = true
		t.Font = if bold then Enum.Font.GothamBlack else Enum.Font.GothamBold
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.15
		t.TextStrokeColor3 = Color3.fromHex("#15171c")
		t.Parent = gui
		return t
	end
	local l = { gui = gui, name = text(0, 0.42, false), status = text(0.42, 0.58, true) }
	labels[model] = l
	local function refresh()
		l.name.Text = string.format("%s #%02d", model:GetAttribute("Display") or "DUMMY", model:GetAttribute("DummyId") or 0)
		l.status.Text = model:GetAttribute("Status") or "HEALTHY"
		l.status.TextColor3 = Color3.fromHex(Config.StatusColors[model:GetAttribute("StatusPrimary") or "HEALTHY"] or "#ffffff")
	end
	refresh()
	model:GetAttributeChangedSignal("Status"):Connect(refresh)
end

local function declutter()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local show = Settings.get("StatusText")
	local range = if Settings.get("Graphics") == "Low" then 90 else 150
	local list = {}
	for model, l in labels do
		l.gui.MaxDistance = range
		local head = l.gui.Adornee :: BasePart?
		if not show or not head then
			l.gui.Enabled = false
			continue
		end
		local sp, onScreen = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 2.3, 0))
		if onScreen then
			table.insert(list, { l = l, x = sp.X, y = sp.Y, d = if model == Visuals.selected then -1 else sp.Z })
		end
	end
	table.sort(list, function(a, b)
		return a.d < b.d
	end)
	local kept = {}
	for _, it in list do
		local ok = true
		for _, k in kept do
			if math.abs(k.x - it.x) < 70 and math.abs(k.y - it.y) < 30 then
				ok = false
				break
			end
		end
		it.l.gui.Enabled = ok
		if ok then
			table.insert(kept, it)
		end
	end
end

-- Selection highlight -------------------------------------------------------------------
local highlight: Highlight
function Visuals.select(model: Model?)
	Visuals.selected = model
	if model then
		highlight.Adornee = model
	end
	highlight.Enabled = model ~= nil
end

function Visuals.init()
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromHex("#3b8cff")
	highlight.Enabled = false
	highlight.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local folder = workspace:WaitForChild("Dummies")
	local function add(model: Instance)
		if model:IsA("Model") then
			task.spawn(buildFace, model)
			task.spawn(buildLabel, model)
		end
	end
	folder.ChildAdded:Connect(add)
	folder.ChildRemoved:Connect(function(model)
		faces[model :: Model] = nil
		labels[model :: Model] = nil
		if Visuals.selected == model then
			Visuals.select(nil)
		end
	end)
	for _, m in folder:GetChildren() do
		add(m)
	end
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		for _, f in faces do
			-- faces far from the camera are not worth animating
			if f.facs then
				if (f.head.Position - camPos).Magnitude < 200 then
					stepFacs(f, dt, now)
				end
			elseif f.t < 1 or (f.head.Position - camPos).Magnitude < 160 then
				stepFace(f, dt, now)
			end
		end
		acc += dt
		if acc > 0.2 then
			acc = 0
			declutter()
		end
	end)
end

return Visuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Visual + audio feedback for verified events sent by the server. Kid-friendly by design:
-- cartoon stars, dust puffs and sparks only - no blood, wounds or gore of any kind.
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local Settings = require(script.Parent.Settings)
local Audio = require(script.Parent.AudioController)
local Camera = require(script.Parent.CameraController)

local Effects = {}
local STAR = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function density(): number
	local g = Settings.get("Graphics")
	return if not Settings.get("ImpactEffects") then 0 elseif g == "Low" then 0.4 elseif g == "Medium" then 0.7 else 1
end

local function burst(position: Vector3, texture: string, color: Color3, count: number, speed: number, size: number, life: number)
	local n = math.floor(count * density() + 0.5)
	if n <= 0 then
		return
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.2) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 3
	e.Rate = 0
	e.LightEmission = if texture == STAR then 0.8 else 0
	e.Parent = att
	e:Emit(n)
	game:GetService("Debris"):AddItem(att, life + 0.5)
end

local SEV = { LIGHT = 1, MEDIUM = 2, HEAVY = 3, CRITICAL = 4 }

function Effects.onImpacts(records)
	for i, r in records do
		if i > 8 then
			break
		end
		local s = SEV[r.severity] or 1
		if r.source == "Hard Landing" then
			Audio.at("bodyFall", r.position, 0.5)
			burst(r.position, SMOKE, Color3.fromRGB(215, 205, 190), 6, 8, 2.5, 0.7)
		else
			Audio.at(if s >= 3 then "bodyHeavy" elseif s == 2 then "bodyMedium" else "bodyLight", r.position, 0.45 + s * 0.12)
			burst(r.position, STAR, Color3.fromRGB(255, 226, 90), 4 + s * 5, 14 + s * 6, 1.6, 0.55)
			if s >= 2 then
				burst(r.position, SMOKE, Color3.fromRGB(225, 220, 210), 4 + s * 2, 9, 3, 0.8)
			end
			if s >= 3 and not r.chain then
				Camera.shake(0.25 + (s - 3) * 0.3)
			end
		end
	end
end

function Effects.onVehicleCrash(vehicle: Model, dv: number, position: Vector3)
	local name = if dv > 80 then "crashHeavy" elseif dv > 45 then "crashMedium" else "crashLight"
	Audio.at(name, position, math.clamp(0.45 + dv / 160, 0.45, 1), 1, 0.15)
	if dv > 60 then
		Audio.at("glass", position, 0.5, 1, 0.5)
	end
	if dv > 95 then
		Audio.at("debris", position, 0.5, 1, 1)
	end
	burst(position, STAR, Color3.fromRGB(255, 190, 80), math.clamp(dv / 5, 4, 30), 30, 1.2, 0.4) -- cartoon sparks
	burst(position, SMOKE, Color3.fromRGB(200, 200, 200), math.clamp(dv / 10, 2, 12), 12, 4, 1)
	Camera.shake(math.clamp(dv / 110, 0.15, 1))
end

local FIRE = "rbxasset://textures/particles/fire_main.dds"

-- Layered fireball: white flash, rolling fire, black smoke column, sparks, shockwave ring, light.
function Effects.explosion(position: Vector3, scale: number)
	Audio.at("explosion", position, 1, 1, 0.2)
	Camera.shake(math.clamp(1.1 * scale, 0.6, 1.2))
	if density() <= 0 then
		return
	end
	local s = scale
	burst(position, STAR, Color3.fromRGB(255, 244, 200), 26, 70 * s, 5 * s, 0.25)                 -- flash
	burst(position + Vector3.new(0, 2, 0), FIRE, Color3.fromRGB(255, 170, 60), 46, 34 * s, 9 * s, 0.9)   -- fireball
	burst(position + Vector3.new(0, 3, 0), FIRE, Color3.fromRGB(255, 96, 30), 26, 16 * s, 12 * s, 1.3)
	burst(position + Vector3.new(0, 5, 0), SMOKE, Color3.fromRGB(45, 45, 48), 34, 20 * s, 14 * s, 3.2)   -- smoke
	burst(position, STAR, Color3.fromRGB(255, 200, 90), 60, 110 * s, 0.9, 0.9)                     -- sparks
	local att = Instance.new("Attachment")
	att.WorldPosition = position + Vector3.new(0, 3, 0)
	att.Parent = workspace.Terrain
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = Color3.fromRGB(255, 170, 80), 60 * s, 8
	light.Parent = att
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.CastShadow = true, false, false, false, false
	ring.Material, ring.Color, ring.Transparency = Enum.Material.Neon, Color3.fromRGB(255, 226, 170), 0.35
	ring.Size = Vector3.new(0.4, 4, 4)
	ring.CFrame = CFrame.new(position + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace.Terrain
	local TweenService = game:GetService("TweenService")
	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, 70 * s, 70 * s), Transparency = 1 }):Play()
	TweenService:Create(light, TweenInfo.new(0.7), { Brightness = 0 }):Play()
	game:GetService("Debris"):AddItem(ring, 0.6)
	game:GetService("Debris"):AddItem(att, 1)
end

local function burn(model: Model)
	local host = model:FindFirstChild("Hood") or model.PrimaryPart
	if not host or host:FindFirstChild("WreckFire") or density() <= 0 then
		return
	end
	for _, def in { { "WreckFire", FIRE, Color3.fromRGB(255, 150, 50), 3, 14, 1.0 }, { "WreckSmoke", SMOKE, Color3.fromRGB(40, 40, 44), 6, 10, 3.5 } } do
		local e = Instance.new("ParticleEmitter")
		e.Name = def[1]
		e.Texture = def[2]
		e.Color = ColorSequence.new(def[3])
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, def[4]), NumberSequenceKeypoint.new(1, def[4] * 2.5) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		e.Lifetime = NumberRange.new(def[6] * 0.6, def[6])
		e.Speed = NumberRange.new(6, 12)
		e.Rate = def[5] * density()
		e.EmissionDirection = Enum.NormalId.Top
		e.LightEmission = if def[2] == FIRE then 0.7 else 0
		e.Parent = host
	end
end

local WEATHER = {
	Sunny = { clock = 13.5, density = 0.22, haze = 0.6, cover = 0.55, color = Color3.fromRGB(199, 220, 255) },
	Sunset = { clock = 17.7, density = 0.3, haze = 1.4, cover = 0.6, color = Color3.fromRGB(255, 196, 150) },
	Foggy = { clock = 12, density = 0.55, haze = 2.4, cover = 0.9, color = Color3.fromRGB(205, 210, 216) },
	Night = { clock = 23.5, density = 0.3, haze = 0.8, cover = 0.4, color = Color3.fromRGB(70, 80, 110) },
}
local function applyWeather()
	local w = WEATHER[Settings.get("Weather")] or WEATHER.Sunny
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = w.clock
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		atmo.Density, atmo.Haze, atmo.Color = w.density, w.haze, w.color
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Cover = w.cover
	end
end

local function watchVehicle(model: Model)
	model:GetAttributeChangedSignal("Exploded"):Connect(function()
		burn(model)
	end)
	model:GetAttributeChangedSignal("DamageLevel"):Connect(function()
		local level = model:GetAttribute("DamageLevel") or 0
		local hood = model:FindFirstChild("Hood") or model.PrimaryPart
		if level >= 2 and hood and not hood:FindFirstChild("DamageSmoke") and density() > 0 then
			local e = Instance.new("ParticleEmitter")
			e.Name = "DamageSmoke"
			e.Texture = SMOKE
			e.Color = ColorSequence.new(Color3.fromRGB(90, 90, 95))
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 6) })
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
			e.Lifetime = NumberRange.new(1.2, 2)
			e.Speed = NumberRange.new(5, 9)
			e.Rate = 8 * density()
			e.EmissionDirection = Enum.NormalId.Top
			e.Parent = hood
		end
	end)
end

local STATE_SOUND = { DOWN = "stateDown", UNCONSCIOUS = "stateUnconscious", DEAD = "stateDead", RECOVERING = "stateRecover" }

local function watchDummy(model: Model)
	local last = model:GetAttribute("StatusPrimary")
	model:GetAttributeChangedSignal("StatusPrimary"):Connect(function()
		local now = model:GetAttribute("StatusPrimary")
		local torso = model:FindFirstChild("UpperTorso") :: BasePart?
		if torso and STATE_SOUND[now] and now ~= last then
			local low = now == "UNCONSCIOUS" or now == "DEAD"
			Audio.at(STATE_SOUND[now], torso.Position, if low then 0.3 else 0.4, if now == "DEAD" then 0.55 elseif low then 0.7 else 1, 0.25)
		end
		last = now
	end)
	model:GetAttributeChangedSignal("ReviveFx"):Connect(function()
		local torso = model:FindFirstChild("UpperTorso") :: BasePart?
		if torso then
			Audio.at("revive", torso.Position, 0.6)
			burst(torso.Position, STAR, Color3.fromRGB(110, 255, 190), 24, 16, 1.8, 0.9)
		end
	end)
end

local ready = false

function Effects.init()
	task.delay(4, function()
		ready = true -- no spawn pops for the dummies that exist at join
	end)
	local function applyGraphics()
		game:GetService("Lighting").GlobalShadows = Settings.get("Graphics") ~= "Low"
	end
	applyGraphics()
	Settings.Changed:Connect(function(key)
		applyGraphics()
		if key == "Weather" then
			applyWeather()
		end
	end)
	local remotes = game.ReplicatedStorage:WaitForChild("Remotes")
	remotes:WaitForChild("Explosion").OnClientEvent:Connect(function(position, scale)
		if typeof(position) == "Vector3" then
			Effects.explosion(position, tonumber(scale) or 1)
		end
	end)
	remotes.VehicleCrash.OnClientEvent:Connect(function(vehicle, dv, position)
		if typeof(position) == "Vector3" then
			Effects.onVehicleCrash(vehicle, dv, position)
		end
	end)
	for _, pair in { { "Vehicles", watchVehicle }, { "Dummies", watchDummy } } do
		local folder = workspace:WaitForChild(pair[1])
		folder.ChildAdded:Connect(function(m)
			pair[2](m)
			if pair[1] == "Dummies" then
				local torso = m:WaitForChild("UpperTorso", 3)
				if torso and ready then
					Audio.at("spawnDummy", torso.Position, 0.35, 1, 0.1)
				end
			end
		end)
		for _, m in folder:GetChildren() do
			pair[2](m)
		end
	end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Gui</string>
            <string name="Source"><![CDATA[--!nonstrict
-- UI toolkit + theme. The look follows the reference sandbox UI the game is modelled on: chunky
-- dark panels with a thick navy outline, a coloured gradient header with a red X, rounded bold
-- white lettering with a black outline, green ON / red OFF pills.
-- Icons: every icon is looked up in UIAssets first (image ids from your uploaded icon pack);
-- when a slot is empty a simple vector glyph drawn from Frames is used instead, so the UI is
-- complete out of the box and upgrades itself the moment ids are filled in.
local UIAssets = require(script.Parent.UIAssets)

local Gui = {}

Gui.T = {
	panel = Color3.fromHex("#1a2130"), panel2 = Color3.fromHex("#2a3346"), stroke = Color3.fromHex("#0c111c"),
	text = Color3.fromHex("#ffffff"), dim = Color3.fromHex("#b9c2d3"), accent = Color3.fromHex("#2f9bff"),
	good = Color3.fromHex("#35d24a"), warn = Color3.fromHex("#ffb52e"), bad = Color3.fromHex("#f0333d"),
	font = Enum.Font.FredokaOne, bold = Enum.Font.FredokaOne, black = Enum.Font.FredokaOne,
	headers = { green = { "#3cff55", "#12b53a" }, red = { "#ff3d74", "#d41247" }, blue = { "#48c6ff", "#1f8fe8" },
		purple = { "#b06bff", "#7a2de0" }, orange = { "#ffb02e", "#f07a12" }, grey = { "#5b6578", "#3a4254" } },
}
local T = Gui.T

function Gui.make(class: string, props: { [any]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then
		(inst :: any).BorderSizePixel = 0
	end
	local parent
	for k, v in props or {} do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Gui.corner(r: number): UICorner
	return Gui.make("UICorner", { CornerRadius = UDim.new(0, r) })
end

function Gui.stroke(color: Color3?, thickness: number?): UIStroke
	return Gui.make("UIStroke", { Color = color or T.stroke, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Gui.padding(p: number): UIPadding
	local u = UDim.new(0, p)
	return Gui.make("UIPadding", { PaddingLeft = u, PaddingRight = u, PaddingTop = u, PaddingBottom = u })
end

function Gui.list(gap: number, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return Gui.make("UIListLayout", {
		Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function Gui.gradient(top: string, bottom: string): UIGradient
	return Gui.make("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromHex(top), Color3.fromHex(bottom)) })
end

-- outlined game lettering
function Gui.label(text: string, size: number, props: { [any]: any }?): TextLabel
	local l = Gui.make("TextLabel", {
		Text = text, TextSize = size, Font = T.font, TextColor3 = T.text, BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, size + 6), TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local outline = Gui.make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = math.clamp(size / 9, 1, 3), Parent = l })
	for k, v in props or {} do
		if k == "NoOutline" then
			outline:Destroy()
		else
			(l :: any)[k] = v
		end
	end
	return l
end

function Gui.button(text: string, props: { [any]: any }?, onClick: (() -> ())?): TextButton
	local b = Gui.make("TextButton", {
		Text = "", BackgroundColor3 = T.panel2, Size = UDim2.new(1, 0, 0, 40), AutoButtonColor = true,
	}, { Gui.corner(8), Gui.stroke(T.stroke, 3) })
	local caption = Gui.label(text, 15, { Name = "Caption", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
	for k, v in props or {} do
		if k == "TextSize" or k == "TextColor3" or k == "Font" then
			(caption :: any)[k] = v
		elseif k == "Text" then
			caption.Text = v
		else
			(b :: any)[k] = v
		end
	end
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

function Gui.setText(button: TextButton, text: string)
	local c = button:FindFirstChild("Caption")
	if c then
		(c :: TextLabel).Text = text
	end
end

-- green / red pill used for every ON / OFF and action button
function Gui.pill(text: string, color: string, props: { [any]: any }?, onClick: (() -> ())?): TextButton
	local g = T.headers[color] or T.headers.grey
	local b = Gui.button(text, props, onClick)
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	Gui.gradient(g[1], g[2]).Parent = b
	b:SetAttribute("Pill", color)
	return b
end

function Gui.recolor(pill: TextButton, color: string)
	local g = T.headers[color] or T.headers.grey
	local grad = pill:FindFirstChildOfClass("UIGradient")
	if grad then
		grad.Color = ColorSequence.new(Color3.fromHex(g[1]), Color3.fromHex(g[2]))
	end
end

function Gui.panel(props: { [any]: any }?, children: { Instance }?): Frame
	local f = Gui.make("Frame", { BackgroundColor3 = T.panel, BackgroundTransparency = 0.22 }, { Gui.corner(6), Gui.stroke(T.stroke, 4) })
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	for _, c in children or {} do
		c.Parent = f
	end
	return f
end

-- Vector glyphs drawn from Frames on a 24 x 24 grid: { x, y, w, h, corner, rotation? }
local GLYPHS = {
	shop = { { 2, 5, 4, 2, 1 }, { 5, 6, 3, 9, 1, -14 }, { 6, 8, 15, 8, 2 }, { 8, 19, 4, 4, 2 }, { 16, 19, 4, 4, 2 } },
	car = { { 2, 11, 20, 6, 2 }, { 6, 6, 11, 6, 2 }, { 4, 15, 5, 5, 3 }, { 15, 15, 5, 5, 3 } },
	sandbox = { { 3, 3, 8, 8, 2 }, { 13, 3, 8, 8, 2 }, { 3, 13, 8, 8, 2 }, { 13, 13, 8, 8, 2 } },
	gear = { { 6, 6, 12, 12, 6 }, { 10, 2, 4, 20, 1 }, { 2, 10, 20, 4, 1 }, { 10, 2, 4, 20, 1, 45 }, { 10, 2, 4, 20, 1, -45 } },
	dummy = { { 7, 2, 10, 9, 3 }, { 5, 12, 14, 10, 2 } },
	pad = { { 2, 8, 20, 10, 5 }, { 3, 14, 6, 7, 3 }, { 15, 14, 6, 7, 3 } },
	replay = { { 5, 4, 4, 16, 1 }, { 10, 8, 8, 8, 1, 45 } },
	revive = { { 10, 3, 4, 18, 1 }, { 3, 10, 18, 4, 1 } },
	reset = { { 4, 4, 16, 16, 8 }, { 14, 2, 8, 8, 1 } },
}
local HOLES = { gear = { 9, 9, 6, 6, 3 }, reset = { 8, 8, 8, 8, 4 } }

function Gui.icon(name: string, size: number, color: Color3?, parent: Instance?): GuiObject
	local id = UIAssets.Icons[name]
	if id and id ~= "" then
		return Gui.make("ImageLabel", { Name = "Icon", Image = id, BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), ScaleType = Enum.ScaleType.Fit, Parent = parent })
	end
	local holder = Gui.make("Frame", { Name = "Icon", BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Parent = parent })
	local k = size / 24
	local function piece(g, c: Color3)
		local f = Gui.make("Frame", { BackgroundColor3 = c, AnchorPoint = Vector2.new(0.5, 0.5), Rotation = g[6] or 0,
			Position = UDim2.fromOffset((g[1] + g[3] / 2) * k, (g[2] + g[4] / 2) * k), Size = UDim2.fromOffset(g[3] * k, g[4] * k), Parent = holder })
		Gui.corner(g[5] * k).Parent = f
	end
	for _, g in GLYPHS[name] or GLYPHS.sandbox do
		piece(g, color or T.text)
	end
	if HOLES[name] then
		piece(HOLES[name], T.panel)
	end
	return holder
end

-- window with coloured header + red X. Returns (window, scrolling body).
function Gui.window(title: string, color: string, iconName: string?, onClose: (() -> ())?): (Frame, ScrollingFrame)
	local g = T.headers[color] or T.headers.grey
	local w = Gui.panel({ ClipsDescendants = false })
	local header = Gui.make("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Color3.new(1, 1, 1), Parent = w },
		{ Gui.gradient(g[1], g[2]), Gui.corner(6), Gui.stroke(T.stroke, 4) })
	local x = 12
	if iconName then
		local ic = Gui.icon(iconName, 28, nil, header)
		ic.Position = UDim2.fromOffset(10, 8)
		x = 46
	end
	Gui.label(title, 24, { Name = "Title", Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 56, 1, 0), Parent = header })
	local close = Gui.pill("X", "red", { Size = UDim2.fromOffset(44, 44), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), TextSize = 24, Parent = header }, onClose)
	close.Name = "Close"
	local body = Gui.make("ScrollingFrame", { Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 54), Size = UDim2.new(1, -24, 1, -64),
		ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarImageColor3 = T.dim, Parent = w })
	return w, body
end

return Gui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">HitNotificationController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The damage read-out: ONE small two-line text bar at the bottom of the screen (no cards, no stack).
--   line 1 (small, coloured):  where the dummy was hit            e.g.  Left Knee
--   line 2 (white):            at most THREE facts joined by " · "  e.g.  Leg broken · Down · 82% blood left
-- A pile-up collapses to "7 dummies hit" / "3 down · 2 knocked out · 1 dead".
-- Every individual record still goes to Feed.log (shown in the Crash Report window).
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Gui = require(script.Parent.Gui)
local Settings = require(script.Parent.Settings)
local Audio = require(script.Parent.AudioController)
local Visuals = require(script.Parent.DummyVisuals)

local Feed = {}
Feed.log = {} :: { any } -- newest first, max 60
local bar: Frame
local top, bottom: TextLabel
local shownUntil = 0
local SEV_COLOR = { LIGHT = "#ffe08a", MEDIUM = "#ffb36b", HEAVY = "#ff8a8a", CRITICAL = "#ff5a5a" }

local function bloodText(blood: number?): string?
	if blood and Settings.get("BloodText") then
		return string.format("%d%% blood left", blood)
	end
	return nil
end

local function present(line1: string, color: string, items: { string })
	if not Settings.get("Notifications") then
		return
	end
	while #items > 3 do -- never more than three things on the bar
		table.remove(items)
	end
	top.Text = line1
	top.TextColor3 = Color3.fromHex(color)
	bottom.Text = table.concat(items, " · ")
	bar.Visible = true
	shownUntil = os.clock() + 4.5
	local scale = bar:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.86
	TweenService:Create(scale, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function Feed.show(records, replay: boolean?)
	if not replay then
		for _, r in records do
			table.insert(Feed.log, 1, r)
		end
		while #Feed.log > 60 do
			table.remove(Feed.log)
		end
	end
	local ids, count, last = {}, 0, nil
	for _, r in records do
		if not ids[r.id] then
			count += 1
		end
		ids[r.id] = r
		last = r
	end
	if not last then
		return
	end
	Audio.ui("hitNotify", 0.22)
	local prefix = if replay then "REPLAY · " else ""
	if count > 1 then
		local tally, order = {}, {}
		for _, r in ids do
			local c = string.lower(r.condition or "hit")
			if not tally[c] then
				tally[c] = 0
				table.insert(order, c)
			end
			tally[c] += 1
		end
		table.sort(order, function(a, b)
			return tally[a] > tally[b]
		end)
		local items = {}
		for _, c in order do
			table.insert(items, string.format("%d %s", tally[c], c))
		end
		present(string.format("%s%d dummies hit", prefix, count), "#ffd24a", items)
		return
	end
	local r = last
	local items = { r.injury or (r.region .. " hit"), r.condition or r.status }
	if not r.dead then
		table.insert(items, if r.bleeding or (r.blood or 100) < 100 then (bloodText(r.blood) or string.format("-%d health", r.damage))
			else string.format("-%d health", r.damage))
	end
	present(prefix .. (r.part or r.region), SEV_COLOR[r.severity] or "#ff8a8a", items)
end

function Feed.init(screen: ScreenGui, mobile: boolean)
	bar = Gui.make("Frame", { Name = "DamageBar", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if mobile then -64 else -104), Size = UDim2.fromOffset(if mobile then 430 else 620, 46), Visible = false, Parent = screen },
		{ Gui.make("UIScale", {}) })
	top = Gui.label("", if mobile then 14 else 17, { Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Parent = bar })
	bottom = Gui.label("", if mobile then 16 else 21, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center, Parent = bar })
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		if os.clock() < shownUntil then
			return
		end
		-- idle: show the selected dummy's live condition, otherwise hide
		local m = Visuals.selected
		if m and m.Parent and Settings.get("Notifications") then
			top.Text = string.format("%s #%02d", m:GetAttribute("Display") or "DUMMY", m:GetAttribute("DummyId") or 0)
			top.TextColor3 = Color3.fromHex("#9fd0ff")
			local items = { m:GetAttribute("Condition") or "Unhurt", string.format("%d health", m:GetAttribute("Health") or 0) }
			local b = bloodText(m:GetAttribute("Blood"))
			if b then
				table.insert(items, b)
			end
			bottom.Text = table.concat(items, " · ")
			bar.Visible = true
		else
			bar.Visible = false
		end
	end)
end

return Feed
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="36">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client bootstrap: builds the ScreenGui, starts every controller and wires server events to them.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local Settings = require(script.Parent.Settings)
local Audio = require(script.Parent.AudioController)
local Camera = require(script.Parent.CameraController)
local VehicleInput = require(script.Parent.VehicleInputController)
local Visuals = require(script.Parent.DummyVisuals)
local Effects = require(script.Parent.EffectsController)
local Replay = require(script.Parent.ReplayController)
local Feed = require(script.Parent.HitNotificationController)
local Inspect = require(script.Parent.DummyInspectionController)
local UI = require(script.Parent.UIController)

local screen = Instance.new("ScreenGui")
screen.Name = "RagdollCrashPhysics"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.DisplayOrder = 5
screen.Parent = player:WaitForChild("PlayerGui")
if mobile then
	local scale = Instance.new("UIScale")
	scale.Scale = math.clamp(workspace.CurrentCamera.ViewportSize.Y / 420, 0.75, 1)
	scale.Parent = screen
end

Audio.init()
Camera.init()
VehicleInput.init()
Visuals.init()
Effects.init()
Replay.init()
Feed.init(screen, mobile)
Inspect.init(screen, mobile, remotes)
UI.init(screen, mobile, remotes)

VehicleInput.onHorn = function()
	if VehicleInput.current then
		Audio.horn(VehicleInput.current.model)
	end
end

remotes.Impact.OnClientEvent:Connect(function(records)
	if typeof(records) ~= "table" then
		return
	end
	Feed.show(records)
	Effects.onImpacts(records)
	Replay.addEvents(records)
end)
remotes.Report.OnClientEvent:Connect(function(report)
	UI.showReport(report)
end)
Replay.onEvent = function(record)
	Feed.show({ record }, true)
end

-- Selecting and grabbing dummies -------------------------------------------------------------
local dummies = workspace:WaitForChild("Dummies")
local grabbing = false
local grabDistance = 20
local pressPos: Vector2? = nil
local pressTime = 0
local lastPointer = Vector2.zero

local function dummyAt(screenPos: Vector2): (Model?, number)
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { dummies }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
	if hit then
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		while model and model.Parent ~= dummies do
			model = model:FindFirstAncestorOfClass("Model")
		end
		return model, hit.Distance
	end
	return nil, 0
end

local function isPointer(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not isPointer(input) or Replay.playing then
		return
	end
	local pos = UserInputService:GetMouseLocation()
	if input.UserInputType == Enum.UserInputType.Touch then
		pos = Vector2.new(input.Position.X, input.Position.Y) + game:GetService("GuiService"):GetGuiInset()
	end
	pressPos, pressTime, lastPointer = pos, os.clock(), pos
	if UI.grabMode then
		local model, dist = dummyAt(pos)
		if model then
			grabbing = true
			grabDistance = math.clamp(dist, 8, 60)
			Inspect.select(model)
			remotes.Request:FireServer("Grab", model:GetAttribute("DummyId"))
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		lastPointer = UserInputService:GetMouseLocation()
	elseif input.UserInputType == Enum.UserInputType.Touch then
		lastPointer = Vector2.new(input.Position.X, input.Position.Y) + game:GetService("GuiService"):GetGuiInset()
	elseif input.UserInputType == Enum.UserInputType.MouseWheel and grabbing then
		grabDistance = math.clamp(grabDistance + input.Position.Z * 3, 8, 60)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if not isPointer(input) then
		return
	end
	if grabbing then
		grabbing = false
		remotes.Request:FireServer("Release")
	elseif pressPos and not UI.grabMode and os.clock() - pressTime < 0.4 and (lastPointer - pressPos).Magnitude < 12 then
		local model = dummyAt(pressPos)
		if model then
			Inspect.select(model)
		end
	end
	pressPos = nil
end)

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	if not grabbing then
		return
	end
	acc += dt
	if acc >= 1 / 15 then
		acc = 0
		local ray = workspace.CurrentCamera:ViewportPointToRay(lastPointer.X, lastPointer.Y)
		remotes.Request:FireServer("GrabMove", ray.Origin + ray.Direction * grabDistance)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ReplayController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Slow-motion instant replay.
-- Roblox has no global physics time scale, so nothing here touches the simulation. Instead the
-- client keeps a rolling buffer (last ~10 s) of the CFrames of every visible vehicle / dummy part
-- plus the impact events that happened. REPLAY plays those transforms back on anchored, non-colliding
-- local "ghost" copies at 0.25x-1x while the real objects are hidden. Ghosts cannot touch anything,
-- so playback can never deal damage or score points.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Settings = require(script.Parent.Settings)
local VehicleInput = require(script.Parent.VehicleInputController)

local Replay = {}
Replay.playing = false
Replay.speed = Config.Replay.SPEED
Replay.onEvent = nil :: ((any) -> ())?   -- UI hook: an impact record re-shown during playback
Replay.onState = nil :: ((boolean, number, number) -> ())? -- playing, time, duration

local frames = {} :: { { t: number, cf: { [BasePart]: CFrame } } }
local events = {} :: { { t: number, record: any } }
local protos = {} :: { [BasePart]: BasePart } -- visual prototype captured the first time a part is seen
local tracked = {} :: { BasePart }
local dirty = true
local KEEP = { SurfaceGui = true, Decal = true, Texture = true, SpecialMesh = true, Frame = true, UICorner = true, TextLabel = true, UIPadding = true }

local function makeProto(part: BasePart): BasePart?
	local ok, clone = pcall(function()
		return part:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	for _, d in clone:GetDescendants() do
		if not KEEP[d.ClassName] then
			d:Destroy()
		end
	end
	clone.Anchored, clone.CanCollide, clone.CanQuery, clone.CanTouch = true, false, false, false
	clone.LocalTransparencyModifier = 0
	return clone
end

local function refreshTracked()
	table.clear(tracked)
	for _, name in { "Vehicles", "Dummies" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			for _, d in folder:GetDescendants() do
				if d:IsA("BasePart") and (d.Transparency < 1 or d.Name == "Root") and d.Name ~= "WheelCollider" then
					table.insert(tracked, d)
					local proto = protos[d]
					-- (re)capture once the head has its face, so ghosts are not faceless
					if not proto or (d.Name == "Head" and d:FindFirstChild("Face") and not proto:FindFirstChild("Face")) then
						protos[d] = makeProto(d) :: BasePart
					end
				end
			end
		end
	end
	dirty = false
end

local function record(now: number)
	if dirty then
		refreshTracked()
	end
	local cf = {}
	for _, p in tracked do
		if p.Parent then
			cf[p] = p.CFrame
		end
	end
	table.insert(frames, { t = now, cf = cf })
	local cutoff = now - Config.Replay.SECONDS
	while frames[1] and frames[1].t < cutoff do
		table.remove(frames, 1)
	end
	while events[1] and events[1].t < cutoff do
		table.remove(events, 1)
	end
	-- forget prototypes of parts that left the buffer entirely
	if #frames % 60 == 0 then
		for part in protos do
			if not part.Parent and not frames[1].cf[part] then
				protos[part] = nil
			end
		end
	end
end

function Replay.addEvents(records)
	local now = os.clock()
	for _, r in records do
		table.insert(events, { t = now, record = r })
	end
end

function Replay.available(): number
	return if #frames > 1 then frames[#frames].t - frames[1].t else 0
end

function Replay.stop()
	Replay.playing = false
end

function Replay.play()
	if Replay.playing or #frames < 10 then
		return
	end
	Replay.playing = true
	VehicleInput.suspended = true
	local clip, clipEvents = frames, events
	frames, events = {}, {} -- recording restarts cleanly after playback
	local t0, t1 = clip[1].t, clip[#clip].t
	local cam = workspace.CurrentCamera
	local oldSubject = cam.CameraSubject

	local ghostFolder = Instance.new("Folder")
	ghostFolder.Name = "ReplayGhosts"
	ghostFolder.Parent = cam
	local ghosts = {} :: { [BasePart]: BasePart }
	local focus: BasePart? = nil
	for part, proto in protos do
		local seen = false
		for i = 1, #clip, 8 do
			if clip[i].cf[part] then
				seen = true
				break
			end
		end
		if seen then
			local g = proto:Clone()
			g.Parent = ghostFolder
			ghosts[part] = g
			if part.Name == "Root" and (not focus or (VehicleInput.current and VehicleInput.current.model == part.Parent)) then
				focus = g
			end
		end
	end
	if not focus then
		for part, g in ghosts do
			if part.Name == "UpperTorso" then
				focus = g
				break
			end
		end
	end
	-- hide the live objects locally
	local hidden = {} :: { BasePart }
	local guis = {} :: { any }
	for _, name in { "Vehicles", "Dummies" } do
		local folder = workspace:FindFirstChild(name)
		for _, d in (if folder then folder:GetDescendants() else {}) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
				table.insert(hidden, d)
			elseif (d:IsA("SurfaceGui") or d:IsA("BillboardGui") or d:IsA("ParticleEmitter")) and d.Enabled then
				d.Enabled = false
				table.insert(guis, d)
			end
		end
	end
	if focus then
		cam.CameraSubject = focus
	end

	local t = t0
	local idx, evIdx = 1, 1
	while Replay.playing and t < t1 do
		local dt = RunService.RenderStepped:Wait()
		t += dt * Replay.speed
		while clip[idx + 1] and clip[idx + 1].t < t do
			idx += 1
		end
		local a, b = clip[idx], clip[idx + 1] or clip[idx]
		local k = if b.t > a.t then math.clamp((t - a.t) / (b.t - a.t), 0, 1) else 0
		for part, g in ghosts do
			local ca, cb = a.cf[part], b.cf[part]
			if ca and cb then
				g.CFrame = ca:Lerp(cb, k)
				g.LocalTransparencyModifier = 0
			else
				g.LocalTransparencyModifier = 1 -- did not exist at this moment
			end
		end
		while clipEvents[evIdx] and clipEvents[evIdx].t <= t do
			if Replay.onEvent then
				Replay.onEvent(clipEvents[evIdx].record)
			end
			evIdx += 1
		end
		if Replay.onState then
			Replay.onState(true, t - t0, t1 - t0)
		end
	end

	ghostFolder:Destroy()
	for _, p in hidden do
		if p.Parent then
			p.LocalTransparencyModifier = 0
		end
	end
	for _, g in guis do
		if g.Parent then
			g.Enabled = true
		end
	end
	local hum = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	cam.CameraSubject = if oldSubject and oldSubject.Parent then oldSubject else hum
	VehicleInput.suspended = false
	Replay.playing = false
	dirty = true
	if Replay.onState then
		Replay.onState(false, 0, 0)
	end
end

function Replay.init()
	for _, name in { "Vehicles", "Dummies" } do
		local folder = workspace:WaitForChild(name)
		folder.DescendantAdded:Connect(function()
			dirty = true
		end)
		folder.DescendantRemoving:Connect(function()
			dirty = true
		end)
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		if Replay.playing then
			return
		end
		acc += dt
		local hz = if Settings.get("ReplayQuality") == "High" then Config.Replay.HZ_HIGH else Config.Replay.HZ_LOW
		if acc >= 1 / hz then
			acc = 0
			record(os.clock())
		end
	end)
end

return Replay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client settings store. Every entry here is read by a controller; nothing is decorative.
local Settings = {}
Settings.values = {
	Graphics = "High",          -- Low / Medium / High: particles, shadows on props, label range
	ImpactEffects = true,       -- EffectsController
	StatusText = true,          -- floating dummy labels
	Notifications = true,       -- "Damage Indicators": the bottom damage text bar
	BloodText = true,           -- "Blood": show bleeding / blood % wording
	Weather = "Sunny",          -- EffectsController: client-side sky + lighting preset
	SoundEffects = true,        -- AudioController master SFX switch
	CameraShake = true,         -- CameraController
	MasterVolume = 0.8, SfxVolume = 1, MusicVolume = 0.4, -- AudioController SoundGroups
	ReplayQuality = "High",     -- ReplayController sample rate
	DummyLimit = "Automatic",   -- sent to the server
}
Settings.options = {
	Graphics = { "Low", "Medium", "High" }, Weather = { "Sunny", "Sunset", "Foggy", "Night" }, ReplayQuality = { "Low", "High" }, DummyLimit = { "Automatic", "Low", "High" },
}
local changed = Instance.new("BindableEvent")
Settings.Changed = changed.Event

function Settings.get(key: string)
	return Settings.values[key]
end

function Settings.set(key: string, value)
	if Settings.values[key] ~= value then
		Settings.values[key] = value
		changed:Fire(key, value)
	end
end

return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">UIAssets</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Image slots for the UI. Leave a slot as "" to use the built-in vector glyph / flat colours.
-- To skin the UI with a kit (e.g. the Folk UI kit) and an icon pack you have the licence for:
-- upload the PNGs to Roblox (Asset Manager > Images), then paste "rbxassetid://<id>" below.
-- Nothing else needs changing - Gui.icon() and the panels pick these up automatically.
return {
	Icons = {
		shop = "", car = "", sandbox = "", gear = "", dummy = "", pad = "", replay = "", revive = "", reset = "",
	},
	Textures = {
		stud = "", -- optional tiled stud texture laid over headers and buttons
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- HUD + windows, laid out like the reference sandbox UI:
--   left column      SHOP / VEHICLES / SANDBOX tiles
--   top row          round buttons: Settings, Dummy customisation, Controls help
--   right column     pack tiles + round REVIVE / RESET buttons
--   bottom centre    the damage text bar (HitNotificationController)
--   bottom right     driving key binds while in a vehicle (phones / tablets: a slim strip under the top row)
-- Works with mouse, touch and gamepad (every control is a real button; B closes the open window).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Specs = require(Shared.VehicleSpecs)
local VehicleBuilder = require(Shared.VehicleBuilder)
local Gui = require(script.Parent.Gui)
local Settings = require(script.Parent.Settings)
local Audio = require(script.Parent.AudioController)
local Camera = require(script.Parent.CameraController)
local Replay = require(script.Parent.ReplayController)
local Feed = require(script.Parent.HitNotificationController)
local Visuals = require(script.Parent.DummyVisuals)
local VehicleInput = require(script.Parent.VehicleInputController)

local UI = {}
UI.grabMode = false
local T = Gui.T
local player = Players.LocalPlayer
local screen: ScreenGui
local request: RemoteEvent
local mobile = false
local windows = {} :: { [string]: Frame }
local openName: string? = nil
local lastReport = nil
local reportBody: ScrollingFrame
local dummyType = "Noob"

local function send(...)
	request:FireServer(...)
end

-- unlock state, read from the attributes ProgressionService writes on the Player
local PAID, COST, LADDER_ORDER = {}, {}, {}
for _, p in Config.Progression.Paid do
	PAID[p.vehicle] = p
end
for i, step in Config.Progression.Ladder do
	COST[step[1]] = step[2]
	LADDER_ORDER[i] = step[1]
end
local function unlocked(key: string): boolean
	local list = player:GetAttribute("Unlocked")
	if typeof(list) ~= "string" then
		return key == LADDER_ORDER[1]
	end
	return table.find(string.split(list, ","), key) ~= nil
end
local function points(): number
	return player:GetAttribute("CrashPoints") or 0
end
local function comma(n: number): string
	local str = tostring(math.floor(n))
	return (str:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end
local function buyPass(key: string)
	local p = PAID[key]
	if p and p.passId > 0 then
		MarketplaceService:PromptGamePassPurchase(player, p.passId)
	else
		UI.toast("Coming soon to the Shop")
	end
end

local function toggle(name: string?)
	local target = if openName == name then nil else name
	for n, p in windows do
		p.Visible = n == target
	end
	openName = target
	if target == "Vehicles" and UI.refreshVehiclesIfDirty then
		UI.refreshVehiclesIfDirty()
	end
	Audio.ui(if target then "uiOpen" else "uiClick", 0.4)
	if target and UserInputService.GamepadEnabled and not mobile then
		GuiService:Select(windows[target]) -- lets a controller move through the window
	end
end

local function window(name: string, title: string, color: string, icon: string, w: number, h: number): ScrollingFrame
	local win, body = Gui.window(title, color, icon, function()
		toggle(nil)
	end)
	win.Name = name
	win.Visible = false
	win.AnchorPoint = Vector2.new(0.5, 0.5)
	win.Position = UDim2.fromScale(0.5, 0.5)
	win.Size = if mobile then UDim2.new(0, math.min(w, 520), 0.84, 0) else UDim2.fromOffset(w, h)
	win.Parent = screen
	windows[name] = win
	return body
end

local function section(parent: Instance, text: string, order: number)
	Gui.label(text, 14, { TextColor3 = T.dim, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 22), Parent = parent })
end

-- row with a caption on the left and a control on the right (Settings / Sandbox style)
local function row(parent: Instance, text: string, order: number, sub: string?): Frame
	local r = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, if sub then 62 else 46), LayoutOrder = order, Parent = parent })
	Gui.label(text, 20, { Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -150, 0, 44), TextWrapped = true, Parent = r })
	if sub then
		Gui.label(sub, 12, { Position = UDim2.fromOffset(4, 40), Size = UDim2.new(1, -150, 0, 18), TextColor3 = T.dim, Parent = r })
	end
	return r
end

local function onOff(parent: Instance, text: string, key: string, order: number, sub: string?)
	local r = row(parent, text, order, sub)
	local b: TextButton
	local function paint()
		Gui.setText(b, if Settings.get(key) then "ON" else "OFF")
		Gui.recolor(b, if Settings.get(key) then "green" else "red")
	end
	b = Gui.pill("", "green", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), Size = UDim2.fromOffset(120, 40), TextSize = 20, Parent = r }, function()
		Settings.set(key, not Settings.get(key))
		paint()
		Audio.ui("uiClick")
	end)
	paint()
end

local function cycle(parent: Instance, text: string, key: string, order: number, color: string, after: ((any) -> ())?)
	local r = row(parent, text, order)
	local b: TextButton
	b = Gui.pill(string.upper(tostring(Settings.get(key))), color, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), Size = UDim2.fromOffset(140, 40), TextSize = 18, Parent = r }, function()
		local opts = Settings.options[key]
		local v = opts[(table.find(opts, Settings.get(key)) :: number) % #opts + 1]
		Settings.set(key, v)
		Gui.setText(b, string.upper(v))
		Audio.ui("uiClick")
		if after then
			after(v)
		end
	end)
end

local function volume(parent: Instance, text: string, key: string, order: number)
	local r = row(parent, text, order)
	local value = Gui.label("", 18, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 3), Size = UDim2.fromOffset(56, 40), TextXAlignment = Enum.TextXAlignment.Center, Parent = r })
	local function paint()
		value.Text = string.format("%d%%", math.floor(Settings.get(key) * 100 + 0.5))
	end
	for _, def in { { "-", -0.1, -112 }, { "+", 0.1, -4 } } do
		Gui.pill(def[1], "grey", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, def[3], 0, 3), Size = UDim2.fromOffset(44, 40), TextSize = 22, Parent = r }, function()
			Settings.set(key, math.clamp(math.floor((Settings.get(key) + def[2]) * 10 + 0.5) / 10, 0, 1))
			paint()
			Audio.ui("uiClick")
		end)
	end
	paint()
end

-- Vehicles ("Weapons" in the reference: category list on the left, cards on the right) ------------
local function vehicleCard(parent: Instance, key: string, order: number)
	local spec = Specs.Vehicles[key]
	local card = Gui.make("Frame", { BackgroundColor3 = T.panel2, BackgroundTransparency = 0.15, LayoutOrder = order, Parent = parent }, { Gui.corner(6), Gui.stroke(T.stroke, 3) })
	Gui.label(spec.display, 17, { Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	-- the real in-game model in a ViewportFrame, so the picture always matches what spawns
	local vp = Gui.make("ViewportFrame", { Size = UDim2.new(1, -12, 0, 84), Position = UDim2.fromOffset(6, 28), BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 200), LightDirection = Vector3.new(-1, -2, -1), Parent = card })
	task.spawn(function()
		local model = VehicleBuilder.build(key, true)
		model.Parent = vp
		local size = model:GetExtentsSize()
		local centre = model:GetBoundingBox().Position
		local cam = Instance.new("Camera")
		cam.FieldOfView = 30
		cam.CFrame = CFrame.lookAt(centre + Vector3.new(-0.8, 0.45, -1).Unit * (size.Magnitude * 1.05 / (2 * math.tan(math.rad(15)))), centre)
		cam.Parent = vp
		vp.CurrentCamera = cam
	end)
	Gui.label(spec.klass, 11, { Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 16), TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
	local btnProps = { Size = UDim2.new(1, -14, 0, 38), Position = UDim2.new(0, 7, 1, -45), TextSize = 20, Parent = card }
	if unlocked(key) then
		Gui.pill("SPAWN", "green", btnProps, function()
			send("SpawnVehicle", key)
			toggle(nil)
		end)
	elseif PAID[key] then
		vp.ImageColor3 = Color3.fromRGB(150, 150, 160)
		Gui.pill(if PAID[key].passId > 0 then "R$ " .. PAID[key].price else "SOON", if PAID[key].passId > 0 then "purple" else "grey", btnProps, function()
			buyPass(key)
		end)
		Gui.label("ROBUX", 13, { Position = UDim2.fromOffset(10, 28), Size = UDim2.fromOffset(60, 16), TextColor3 = Color3.fromHex("#c89bff"), Parent = card })
	else
		vp.ImageColor3 = Color3.fromRGB(70, 70, 80) -- locked: darkened silhouette
		local need = COST[key] or 0
		local bar = Gui.make("Frame", { Position = UDim2.new(0, 7, 1, -58), Size = UDim2.new(1, -14, 0, 8), BackgroundColor3 = T.panel, Parent = card }, { Gui.corner(4) })
		Gui.make("Frame", { Size = UDim2.fromScale(math.clamp(points() / math.max(need, 1), 0, 1), 1), BackgroundColor3 = T.warn, Parent = bar }, { Gui.corner(4) })
		Gui.pill("LOCKED  " .. comma(need), "grey", btnProps, function()
			UI.toast(string.format("Unlocks at %s crash points - crash into dummies to earn them", comma(need)))
		end)
	end
end

local function buildVehicles()
	local body = window("Vehicles", "Vehicles", "red", "car", 760, 520)
	body.ScrollingEnabled = false
	body.AutomaticCanvasSize = Enum.AutomaticSize.None
	local tabW = if mobile then 108 else 150
	local tabs = Gui.panel({ Size = UDim2.new(0, tabW, 1, 0), Parent = body }, { Gui.list(4), Gui.padding(4) })
	local heading = Gui.label("CARS", 26, { Position = UDim2.fromOffset(tabW + 16, 0), Size = UDim2.new(1, -tabW - 16, 0, 32), Parent = body })
	local gridHolder = Gui.make("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(tabW + 12, 38), Size = UDim2.new(1, -tabW - 12, 1, -38),
		ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = body },
		{ Gui.make("UIGridLayout", { CellSize = UDim2.fromOffset(if mobile then 132 else 172, 196), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
			Gui.padding(4) })
	local buttons = {}
	local show
	show = function(cat: string)
		for _, c in gridHolder:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		for i, key in Specs.Order do
			if Specs.Vehicles[key].category == cat then
				vehicleCard(gridHolder, key, i)
			end
		end
		heading.Text = string.upper(cat)
		for c, b in buttons do
			Gui.recolor(b, if c == cat then "orange" else "grey")
		end
	end
	for i, cat in { "Cars", "Heavy", "Military", "Aircraft", "Special" } do
		buttons[cat] = Gui.pill(cat, "grey", { Size = UDim2.new(1, 0, 0, 46), TextSize = if mobile then 17 else 22, LayoutOrder = i, Parent = tabs }, function()
			Audio.ui("uiClick")
			show(cat)
		end)
	end
	local current, dirty = "Cars", false
	local plain = show
	show = function(cat: string)
		current, dirty = cat, false
		plain(cat)
	end
	show("Cars")
	local function refresh()
		if windows.Vehicles and windows.Vehicles.Visible then
			show(current)
		else
			dirty = true
		end
	end
	player:GetAttributeChangedSignal("Unlocked"):Connect(refresh)
	player:GetAttributeChangedSignal("CrashPoints"):Connect(refresh)
	UI.refreshVehiclesIfDirty = function()
		if dirty then
			show(current)
		end
	end
end

-- Sandbox ------------------------------------------------------------------------------------------
local function buildSandbox()
	local body = window("Sandbox", "Sandbox", "green", "sandbox", 520, 520)
	Gui.list(6).Parent = body
	local function action(text: string, color: string, order: number, fn: () -> ())
		return Gui.pill(text, color, { Size = UDim2.new(1, -8, 0, 42), TextSize = 18, LayoutOrder = order, Parent = body }, fn)
	end
	local r = row(body, "Slow motion replay", 1, "Watch the last 10 seconds at 0.25x")
	Gui.pill("PLAY", "green", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), Size = UDim2.fromOffset(120, 40), TextSize = 20, Parent = r }, function()
		if Replay.available() < 1.5 then
			UI.toast("Nothing to replay yet")
		else
			toggle(nil)
			task.spawn(Replay.play)
		end
	end)
	r = row(body, "Grab tool", 2, "Hold a dummy and drag it around")
	local grab: TextButton
	grab = Gui.pill("OFF", "red", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), Size = UDim2.fromOffset(120, 40), TextSize = 20, Parent = r }, function()
		UI.grabMode = not UI.grabMode
		Gui.setText(grab, if UI.grabMode then "ON" else "OFF")
		Gui.recolor(grab, if UI.grabMode then "green" else "red")
		Audio.ui("uiSelect")
	end)
	section(body, "DUMMIES", 10)
	local spawnRow = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 42), LayoutOrder = 11, Parent = body }, { Gui.list(6, true) })
	for i, n in { 1, 5, 10 } do
		Gui.pill("SPAWN " .. n, "blue", { Size = UDim2.new(1 / 3, -4, 1, 0), TextSize = 17, LayoutOrder = i, Parent = spawnRow }, function()
			send("SpawnDummies", n, dummyType)
		end)
	end
	action("RESET ALL DUMMIES", "orange", 12, function()
		Audio.ui("resetScene")
		send("ResetDummies")
	end)
	action("REMOVE SELECTED DUMMY", "grey", 13, function()
		local m = Visuals.selected
		if m then
			Audio.ui("uiDelete")
			send("DummyAction", m:GetAttribute("DummyId"), "Delete")
		else
			UI.toast("Click a dummy first")
		end
	end)
	section(body, "PRESETS", 20)
	local grid = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 138), LayoutOrder = 21, Parent = body },
		{ Gui.make("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	for i, def in { { "Line", "Dummy Line" }, { "Bowling", "Bowling" }, { "Crowd", "Crowd" }, { "Tower", "Tower" }, { "Crossing", "Rail Crossing" }, { "Showcase", "Whole Map" } } do
		Gui.pill(def[2], "purple", { TextSize = 16, LayoutOrder = i, Parent = grid }, function()
			Audio.ui("uiSelect")
			send("Preset", def[1])
			toggle(nil)
		end)
	end
	section(body, "EVENTS", 30)
	local events = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 90), LayoutOrder = 31, Parent = body },
		{ Gui.make("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 40), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	for i, def in { { "DummyRain", "Dummy Rain" }, { "ZeroG", "Zero-G" }, { "Blast", "Blast" }, { "ReviveAll", "Revive All" } } do
		Gui.pill(def[2], "orange", { TextSize = 16, LayoutOrder = i, Parent = events }, function()
			Audio.ui("uiSelect")
			send("Event", def[1])
		end)
	end
	section(body, "MAP", 40)
	local maps = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 42), LayoutOrder = 41, Parent = body }, { Gui.list(6, true) })
	for i, name in Config.Map.Names do
		Gui.pill(name, "blue", { Size = UDim2.new(1 / #Config.Map.Names, -4, 1, 0), TextSize = 15, LayoutOrder = i, Parent = maps }, function()
			Audio.ui("uiSelect")
			send("LoadMap", name)
			toggle(nil)
		end)
	end
	section(body, "TELEPORT", 50)
	for i, zone in Config.Map.Zones do
		action(zone[1], "grey", 50 + i, function()
			send("Teleport", i)
			toggle(nil)
		end)
	end
	section(body, "SCENE", 70)
	action("RESET SCENE", "red", 71, function()
		Audio.ui("resetScene")
		send("ResetScene")
		UI.toast("Scene reset")
	end)
	action("CRASH REPORT", "blue", 72, function()
		toggle("Report")
		UI.fillReport()
	end)
	action("CAMERA: FOLLOW SELECTED DUMMY", "grey", 73, function()
		local m = Visuals.selected
		if Camera.mode == "Dummy" or not m then
			Camera.setMode("Vehicle")
		elseif m:FindFirstChild("UpperTorso") then
			Camera.setMode("Dummy", m.UpperTorso)
		end
	end)
	if not mobile then
		action("CAMERA: FREE FLY (WASD + Q/E)", "grey", 74, function()
			Camera.setMode(if Camera.mode == "Free" then "Vehicle" else "Free")
			toggle(nil)
		end)
	end
end

-- Shop ------------------------------------------------------------------------------------------------
local function buildShop()
	local body = window("Shop", "Shop", "red", "shop", 620, 500)
	Gui.list(8).Parent = body
	Gui.label("ROBUX VEHICLES", 16, { LayoutOrder = 0, TextColor3 = T.dim, Parent = body })
	for i, item in Config.Shop do
		local spec = Specs.Vehicles[item.vehicle]
		local card = Gui.panel({ Size = UDim2.new(1, -8, 0, 110), LayoutOrder = i, Parent = body })
		local vp = Gui.make("ViewportFrame", { Size = UDim2.fromOffset(150, 96), Position = UDim2.fromOffset(6, 7), BackgroundTransparency = 1,
			Ambient = Color3.fromRGB(200, 200, 200), LightDirection = Vector3.new(-1, -2, -1), Parent = card })
		task.spawn(function()
			local model = VehicleBuilder.build(item.vehicle, true)
			model.Parent = vp
			local size = model:GetExtentsSize()
			local centre = model:GetBoundingBox().Position
			local cam = Instance.new("Camera")
			cam.FieldOfView = 30
			cam.CFrame = CFrame.lookAt(centre + Vector3.new(-0.8, 0.45, -1).Unit * (size.Magnitude * 1.05 / (2 * math.tan(math.rad(15)))), centre)
			cam.Parent = vp
			vp.CurrentCamera = cam
		end)
		Gui.label(string.upper(spec.display), 22, { Position = UDim2.fromOffset(166, 8), Size = UDim2.new(1, -320, 0, 28), TextColor3 = Color3.fromHex("#ffb02e"), Parent = card })
		Gui.label(spec.klass .. "  -  yours forever, on every map", 13, { Position = UDim2.fromOffset(166, 40), Size = UDim2.new(1, -320, 0, 52),
			TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
		local owned = unlocked(item.vehicle)
		local btn = Gui.pill(if owned then "OWNED" elseif item.id > 0 then "R$ " .. item.price else "SOON", if owned then "green" elseif item.id > 0 then "purple" else "grey",
			{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(134, 46), TextSize = 20, Parent = card }, function()
				if unlocked(item.vehicle) then
					send("SpawnVehicle", item.vehicle)
					toggle(nil)
				else
					buyPass(item.vehicle)
				end
			end)
		player:GetAttributeChangedSignal("Unlocked"):Connect(function()
			if unlocked(item.vehicle) then
				Gui.setText(btn, "SPAWN")
				Gui.recolor(btn, "green")
			end
		end)
	end
end

-- Settings ---------------------------------------------------------------------------------------------
local function buildSettings()
	local body = window("Settings", "Settings", "blue", "gear", 520, 500)
	Gui.list(4).Parent = body
	cycle(body, "Weather", "Weather", 1, "orange")
	onOff(body, "Sound Effects", "SoundEffects", 2)
	onOff(body, "Blood", "BloodText", 3, "Bleeding and blood % wording")
	onOff(body, "Damage Indicators", "Notifications", 4, "The text bar at the bottom")
	onOff(body, "Dummy Name Tags", "StatusText", 5)
	onOff(body, "Impact Effects", "ImpactEffects", 6, "Explosions, sparks, dust")
	onOff(body, "Camera Shake", "CameraShake", 7)
	cycle(body, "Graphics", "Graphics", 8, "blue")
	volume(body, "Master Volume", "MasterVolume", 9)
	volume(body, "Music Volume", "MusicVolume", 10)
	cycle(body, "Replay Quality", "ReplayQuality", 11, "blue")
	cycle(body, "Dummy Limit", "DummyLimit", 12, "blue", function(v)
		send("SetDummyLimit", v, mobile)
	end)
end

-- Dummy customisation ("NPC Customization") -----------------------------------------------------------------
local function buildDummy()
	local body = window("Dummy", "Dummy Customization", "green", "dummy", 560, 380)
	Gui.list(8).Parent = body
	local r = row(body, "Body Type", 1)
	local holder = Gui.make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), Size = UDim2.fromOffset(if mobile then 300 else 360, 40), Parent = r }, { Gui.list(4, true) })
	local pills = {}
	local current = Config.DummyBody
	for i, def in { { "Man", "Man" }, { "Robloxian2", "Robloxian 2.0" }, { "Blocky", "Blocky" } } do
		pills[def[1]] = Gui.pill(def[2], if def[1] == current then "green" else "red", { Size = UDim2.new(1 / 3, -3, 1, 0), TextSize = if mobile then 13 else 15, LayoutOrder = i, Parent = holder }, function()
			current = def[1]
			for k, p in pills do
				Gui.recolor(p, if k == current then "green" else "red")
			end
			Audio.ui("uiSelect")
			send("SetBody", def[1])
		end)
	end
	r = row(body, "Dummy Type", 2, "Used by the SPAWN buttons in Sandbox")
	local names = { "Noob", "Crash", "Heavy", "Light", "Armored" }
	local tb: TextButton
	tb = Gui.pill("DUMMY", "blue", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 3), Size = UDim2.fromOffset(190, 40), TextSize = 16, Parent = r }, function()
		dummyType = names[(table.find(names, dummyType) :: number) % #names + 1]
		Gui.setText(tb, Config.DummyTypes[dummyType].display)
		Audio.ui("uiClick")
	end)
	Gui.label("All dummies are grey test dummies with the animated Man face.\nThe face reacts to every hit: shock, pain, dizzy, knocked out.", 14,
		{ LayoutOrder = 3, Size = UDim2.new(1, -8, 0, 60), TextWrapped = true, TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, Parent = body })
end

-- Crash report -------------------------------------------------------------------------------------------------
function UI.fillReport()
	for _, c in reportBody:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local r = lastReport
	if not r then
		Gui.label("No crash recorded yet. Hit a dummy!", 16, { TextColor3 = T.dim, Parent = reportBody })
	else
		section(reportBody, "LAST CRASH", 1)
		for i, l in { { "Vehicle", r.vehicle }, { "Impact Speed", r.mph .. " MPH" }, { "Dummies Hit", r.hit }, { "Down", r.down }, { "Knocked Out", r.unconscious },
			{ "Dead", r.dead }, { "Chain Reactions", r.chain }, { "Props Knocked Over", r.props } } do
			local line = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 24), LayoutOrder = 1 + i, Parent = reportBody })
			Gui.label(l[1], 16, { TextColor3 = T.dim, Size = UDim2.new(0.6, 0, 1, 0), Parent = line })
			Gui.label(tostring(l[2]), 16, { Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.4, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = line })
		end
		local total = string.format("%d", r.score):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
		Gui.label("CRASH SCORE  " .. total, 22, { TextColor3 = Color3.fromHex("#ffd24a"), LayoutOrder = 20, Size = UDim2.new(1, 0, 0, 34), Parent = reportBody })
	end
	section(reportBody, "EVENT LOG (newest first)", 30)
	for i, e in Feed.log do
		if i > 30 then
			break
		end
		Gui.label(string.format("#%02d  %s: %s, %s", e.id, e.part or e.region, e.injury or e.severity, string.lower(e.condition or e.status)), 13,
			{ LayoutOrder = 30 + i, Parent = reportBody })
	end
end

function UI.showReport(report)
	lastReport = report
	Audio.ui("report", 0.4)
	if openName == "Report" then
		UI.fillReport()
	end
end

-- Toast ---------------------------------------------------------------------------------------------------------
local toastLabel: TextLabel
local toastToken = 0
function UI.toast(text: string)
	toastToken += 1
	local my = toastToken
	toastLabel.Text = text
	toastLabel.Visible = true
	task.delay(3, function()
		if my == toastToken then
			toastLabel.Visible = false
		end
	end)
end

-- Key binds ---------------------------------------------------------------------------------------------------------
local BINDS = {
	car = { { "W", "Accelerate" }, { "S", "Brake / Reverse" }, { "A D", "Steer" }, { "H", "Horn" }, { "Space", "Get out" } },
	tank = { { "W S", "Drive" }, { "A D", "Pivot turn" }, { "Mouse", "Aim turret" }, { "Space", "Get out" } },
	train = { { "W", "Throttle" }, { "S", "Brake" }, { "H", "Whistle" }, { "Space", "Get out" } },
	sled = { { "W", "Ignite" }, { "S", "Brake" }, { "Space", "Bail out" } },
	plane = { { "W S", "Engine power" }, { "A D", "Bank / turn" }, { "E", "Pull up" }, { "Q", "Nose down" }, { "Space", "Eject" } },
	heli = { { "W S", "Forward / back" }, { "A D", "Turn" }, { "E", "Climb" }, { "Q", "Descend" }, { "Space", "Get out" } },
}
local PAD = { W = "RT", S = "LT", ["W S"] = "RT LT", ["A D"] = "L Stick", E = "RB", Q = "LB", H = "Y", Space = "A", Mouse = "R Stick" }
local TOUCH = {
	car = "Stick: drive + steer   |   Jump: get out", tank = "Stick: drive + pivot   |   Camera aims the turret", train = "Stick up / down: throttle",
	sled = "Stick up: ignite", plane = "Stick: power + bank   |   UP / DOWN buttons: pitch", heli = "Stick: move + turn   |   UP / DOWN buttons: climb",
}

function UI.init(screenGui: ScreenGui, isMobile: boolean, remotes: Instance)
	screen, mobile = screenGui, isMobile
	request = remotes:WaitForChild("Request") :: RemoteEvent
	local tile = if mobile then 76 else 104

	-- crash points + next unlock, under the title
	local pts = Gui.label("", if mobile then 12 else 15, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 58), Size = UDim2.fromOffset(420, 20),
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromHex("#ffd24a"), Parent = screen })
	local function paintPoints()
		local nextKey
		for _, k in LADDER_ORDER do
			if not unlocked(k) then
				nextKey = k
				break
			end
		end
		pts.Text = comma(points()) .. " CRASH POINTS" .. (if nextKey then string.format("   |   next: %s at %s", Specs.Vehicles[nextKey].display, comma(COST[nextKey])) else "   |   every unlockable vehicle unlocked")
	end
	paintPoints()
	player:GetAttributeChangedSignal("CrashPoints"):Connect(paintPoints)
	player:GetAttributeChangedSignal("Unlocked"):Connect(paintPoints)

	-- left column: SHOP / VEHICLES / SANDBOX
	local left = Gui.make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, if mobile then 62 else 120), Size = UDim2.fromOffset(tile, tile * 3 + 20), Parent = screen }, { Gui.list(8) })
	for i, def in { { "Shop", "shop" }, { "Vehicles", "car" }, { "Sandbox", "sandbox" } } do
		local b = Gui.make("TextButton", { Text = "", LayoutOrder = i, Size = UDim2.fromOffset(tile, tile), BackgroundColor3 = T.panel, BackgroundTransparency = 0.2, Parent = left },
			{ Gui.corner(8), Gui.stroke(T.stroke, 4) })
		local ic = Gui.icon(def[2], tile * 0.52, nil, b)
		ic.AnchorPoint = Vector2.new(0.5, 0)
		ic.Position = UDim2.new(0.5, 0, 0, tile * 0.1)
		Gui.label(def[1], if mobile then 13 else 17, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
		b.Activated:Connect(function()
			toggle(def[1])
		end)
	end

	-- top row: round buttons
	local top = Gui.make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(190, 52), Parent = screen },
		{ Gui.list(10, true, Enum.HorizontalAlignment.Center) })
	local controlsVisible = true
	for i, def in { { "Settings", "gear" }, { "Dummy", "dummy" }, { "Controls", "pad" } } do
		local b = Gui.make("TextButton", { Text = "", LayoutOrder = i, Size = UDim2.fromOffset(50, 50), BackgroundColor3 = Color3.fromHex("#141b29"), Parent = top }, { Gui.corner(25) })
		local ic = Gui.icon(def[2], 28, nil, b)
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		b.Activated:Connect(function()
			if def[1] == "Controls" then
				controlsVisible = not controlsVisible
				Audio.ui("uiClick")
			else
				toggle(def[1])
			end
		end)
	end

	-- right column: pack tiles + round buttons
	local right = Gui.make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, if mobile then 62 else 76),
		Size = UDim2.fromOffset(if mobile then 124 else 164, 240), Parent = screen }, { Gui.list(8, false, Enum.HorizontalAlignment.Right) })
	for i = 1, math.min(3, #Config.Shop) do
		local item = Config.Shop[i]
		local b = Gui.make("TextButton", { Text = "", LayoutOrder = i, Size = UDim2.new(1, 0, 0, if mobile then 44 else 54), BackgroundColor3 = T.panel2, BackgroundTransparency = 0.25, Parent = right },
			{ Gui.corner(6), Gui.stroke(T.stroke, 4) })
		Gui.label(Specs.Vehicles[item.vehicle].display, if mobile then 12 else 15, { Size = UDim2.new(1, 0, 0.55, 0), TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
		Gui.label(if item.id > 0 then "R$ " .. item.price else "SOON", if mobile then 12 else 15, { Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0.5, 0),
			TextColor3 = Color3.fromHex("#3cff55"), TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
		b.Activated:Connect(function()
			toggle("Shop")
		end)
	end
	local rounds = Gui.make("Frame", { BackgroundTransparency = 1, LayoutOrder = 9, Size = UDim2.new(1, 0, 0, 64), Parent = right }, { Gui.list(8, true, Enum.HorizontalAlignment.Right) })
	for i, def in { { "Revive", "revive", function()
		send("Event", "ReviveAll")
	end }, { "Reset", "reset", function()
		Audio.ui("resetScene")
		send("ResetScene")
	end } } do
		local b = Gui.make("TextButton", { Text = "", LayoutOrder = i, Size = UDim2.fromOffset(60, 60), BackgroundColor3 = Color3.fromHex("#141b29"), BackgroundTransparency = 0.25, Parent = rounds },
			{ Gui.corner(30), Gui.stroke(Color3.fromHex("#c9d2e3"), 2) })
		Gui.label(def[1], 13, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
		b.Activated:Connect(def[3])
	end

	buildShop()
	buildVehicles()
	buildSandbox()
	buildSettings()
	buildDummy()
	reportBody = window("Report", "Crash Report", "blue", "replay", 460, 500)
	Gui.list(4).Parent = reportBody

	toastLabel = Gui.label("", 18, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 84), Size = UDim2.fromOffset(460, 30),
		TextXAlignment = Enum.TextXAlignment.Center, Visible = false, Parent = screen })

	-- replay banner
	local banner = Gui.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(340, 58), Visible = false, Parent = screen })
	local bannerText = Gui.label("REPLAY", 16, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -150, 0, 24), Parent = banner })
	local barBack = Gui.make("Frame", { Position = UDim2.fromOffset(12, 38), Size = UDim2.new(1, -24, 0, 8), BackgroundColor3 = T.panel2, Parent = banner }, { Gui.corner(4) })
	local barFill = Gui.make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.good, Parent = barBack }, { Gui.corner(4) })
	local speedButton: TextButton
	speedButton = Gui.pill("0.25x", "blue", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -70, 0, 4), Size = UDim2.fromOffset(64, 28), TextSize = 14, Parent = banner }, function()
		Replay.speed = if Replay.speed == 0.25 then 0.5 elseif Replay.speed == 0.5 then 1 else 0.25
		Gui.setText(speedButton, Replay.speed .. "x")
	end)
	Gui.pill("EXIT", "red", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 4), Size = UDim2.fromOffset(58, 28), TextSize = 14, Parent = banner }, Replay.stop)
	Replay.onState = function(playing, t, dur)
		banner.Visible = playing
		if playing then
			bannerText.Text = string.format("SLOW MOTION  %.1f / %.1fs", t, dur)
			barFill.Size = UDim2.fromScale(math.clamp(t / math.max(dur, 0.01), 0, 1), 1)
		end
	end

	-- driving HUD: speed + key binds. Desktop / console: bottom right. Touch: slim strip under the top row.
	local hud = Gui.panel({ Name = "DriveHud", Visible = false, Parent = screen })
	local speed = Gui.label("0", 30, { Size = UDim2.fromOffset(70, 34), TextXAlignment = Enum.TextXAlignment.Right, Parent = hud })
	local unit = Gui.label("MPH", 13, { TextColor3 = T.dim, Size = UDim2.fromOffset(40, 16), Parent = hud })
	local nameLabel = Gui.label("", 15, { Size = UDim2.fromOffset(200, 20), Parent = hud })
	local extra = Gui.label("", 12, { TextColor3 = Color3.fromHex("#9fd0ff"), Size = UDim2.fromOffset(200, 16), Parent = hud })
	local binds = Gui.make("Frame", { BackgroundTransparency = 1, Parent = hud }, { Gui.list(4) })
	local touchLine = Gui.label("", 12, { TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = hud })
	local resetBtn = Gui.pill("RESET VEHICLE", "orange", { TextSize = 13, Parent = hud }, function()
		Audio.ui("resetScene")
		send("ResetVehicle")
	end)
	if mobile then
		hud.AnchorPoint = Vector2.new(0.5, 0)
		hud.Position = UDim2.new(0.5, 0, 0, 62)
		hud.Size = UDim2.fromOffset(420, 52)
		speed.Position, speed.Size, speed.TextSize = UDim2.fromOffset(4, 2), UDim2.fromOffset(52, 28), 24
		unit.Position = UDim2.fromOffset(60, 10)
		nameLabel.Position, nameLabel.Size = UDim2.fromOffset(98, 4), UDim2.fromOffset(190, 18)
		extra.Visible, binds.Visible = false, false
		touchLine.Position, touchLine.Size = UDim2.fromOffset(6, 30), UDim2.new(1, -12, 0, 18)
		resetBtn.AnchorPoint, resetBtn.Position, resetBtn.Size = Vector2.new(1, 0), UDim2.new(1, -6, 0, 4), UDim2.fromOffset(116, 24)
	else
		hud.AnchorPoint = Vector2.new(1, 1)
		hud.Position = UDim2.new(1, -14, 1, -14)
		hud.Size = UDim2.fromOffset(250, 250)
		speed.Position = UDim2.fromOffset(8, 6)
		unit.Position = UDim2.fromOffset(84, 20)
		nameLabel.Position = UDim2.fromOffset(12, 42)
		extra.Position = UDim2.fromOffset(12, 62)
		binds.Position, binds.Size = UDim2.fromOffset(12, 84), UDim2.new(1, -24, 0, 124)
		touchLine.Visible = false
		resetBtn.AnchorPoint, resetBtn.Position, resetBtn.Size = Vector2.new(0, 1), UDim2.new(0, 10, 1, -8), UDim2.new(1, -20, 0, 28)
	end

	local function fillBinds(kind: string)
		for _, c in binds:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local pad = UserInputService:GetLastInputType().Name:find("Gamepad") ~= nil
		for i, b in BINDS[kind] or BINDS.car do
			local line = Gui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = i, Parent = binds })
			local key = if pad then (PAD[b[1]] or b[1]) else b[1]
			local cap = Gui.make("Frame", { BackgroundColor3 = Color3.fromHex("#eef1f6"), Size = UDim2.fromOffset(math.max(26, #key * 9 + 12), 20), Parent = line }, { Gui.corner(4), Gui.stroke(T.stroke, 2) })
			Gui.label(key, 12, { NoOutline = true, TextColor3 = Color3.fromHex("#141b29"), Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = cap })
			Gui.label(b[2], 13, { Position = UDim2.fromOffset(84, 0), Size = UDim2.new(1, -84, 1, 0), Parent = line })
		end
		touchLine.Text = TOUCH[kind] or TOUCH.car
	end

	local lastModel, lastPad = nil, nil
	RunService.RenderStepped:Connect(function()
		local c = VehicleInput.current
		hud.Visible = c ~= nil and controlsVisible and not Replay.playing
		if not c then
			lastModel = nil
			return
		end
		local pad = UserInputService:GetLastInputType().Name:find("Gamepad") ~= nil
		if c.model ~= lastModel or pad ~= lastPad then
			if c.model ~= lastModel then
				Camera.frameVehicle(c.model)
			end
			lastModel, lastPad = c.model, pad
			nameLabel.Text = c.spec.display
			fillBinds(c.kind)
		end
		speed.Text = tostring(math.floor((c.speedMph or 0) + 0.5))
		if c.kind == "plane" then
			extra.Text = string.format("Power %d%%  |  Alt %d ft", (c.throttle or 0) * 100, math.max(0, (c.altitude or 0) * 0.92))
		elseif c.kind == "heli" then
			extra.Text = string.format("Alt %d ft", math.max(0, (c.altitude or 0) * 0.92))
		else
			extra.Text = if c.grounded then c.spec.klass else "Airborne"
		end
	end)

	remotes:WaitForChild("Notice").OnClientEvent:Connect(function(text)
		if typeof(text) == "string" then
			UI.toast(text)
		end
	end)
	if mobile then
		Settings.set("Graphics", "Medium")
		Settings.set("ReplayQuality", "Low")
		send("SetDummyLimit", "Automatic", true)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.ButtonB and openName then
			toggle(nil)
		end
	end)
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">VehicleInputController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Drives every vehicle the player owns. The server gives the player network ownership, so the
-- forces applied here are simulated locally with zero input lag; the collisions with dummies are
-- still real physical contacts and all damage is decided on the server.
--
-- Controls (also shown on the HUD):
--   Cars / tank / train   W S throttle + brake/reverse, A D steer        (thumbstick on mobile / gamepad)
--   Plane                 W S engine power up / down (stays where you leave it), A D bank + turn,
--                         E pull up, Q nose down                          (UP / DOWN touch buttons)
--   Helicopter            W S forward / back, A D turn, E climb, Q descend
--   H horn, jump to exit
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local Shared = game.ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Specs = require(Shared.VehicleSpecs)

local Controller = {}
Controller.current = nil :: any -- { model, spec, key, kind, speedMph, throttle, grounded, braking }
Controller.onHorn = nil :: (() -> ())?
Controller.suspended = false -- true while a replay is on screen: inputs are ignored

local player = Players.LocalPlayer
local folder: Folder
local pitchUp, pitchDown = false, false
local planeThrottle = {} :: { [Model]: number }
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function clampMag(v: Vector3, max: number): Vector3
	local m = v.Magnitude
	return if m > max then v * (max / m) else v
end

local function bindAir(on: boolean)
	if on then
		ContextActionService:BindAction("RCP_PitchUp", function(_, state)
			pitchUp = state == Enum.UserInputState.Begin
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonR1)
		ContextActionService:BindAction("RCP_PitchDown", function(_, state)
			pitchDown = state == Enum.UserInputState.Begin
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonL1)
		ContextActionService:SetTitle("RCP_PitchUp", "UP")
		ContextActionService:SetTitle("RCP_PitchDown", "DOWN")
		ContextActionService:SetPosition("RCP_PitchUp", UDim2.new(1, -150, 1, -230))
		ContextActionService:SetPosition("RCP_PitchDown", UDim2.new(1, -230, 1, -160))
	else
		ContextActionService:UnbindAction("RCP_PitchUp")
		ContextActionService:UnbindAction("RCP_PitchDown")
		pitchUp, pitchDown = false, false
	end
end

local function grounded(root: BasePart): boolean
	local up = root.CFrame.UpVector
	return workspace:Raycast(root.Position, -up * (root.Size.Y / 2 + 1.4), rayParams) ~= nil
end

local function stepVehicle(model: Model, dt: number, humanoid: Humanoid?)
	local root = model.PrimaryPart
	local drive = root and root:FindFirstChild("Drive") :: VectorForce?
	local steer = root and root:FindFirstChild("Steer") :: Torque?
	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat?
	if not (root and drive and steer and seat) then
		return
	end
	local key = model:GetAttribute("VehicleKey")
	local spec = Specs.Vehicles[key]
	local phys = spec.phys
	local kind = phys.kind
	local driving = humanoid ~= nil and seat.Occupant == humanoid
	local live = driving and not Controller.suspended and not model:GetAttribute("Exploded")
	local throttle = if live then (if seat.ThrottleFloat ~= 0 then seat.ThrottleFloat else seat.Throttle) else 0
	local steerIn = if live then (if seat.SteerFloat ~= 0 then seat.SteerFloat else seat.Steer) else 0

	local cf = root.CFrame
	local look, right, up = cf.LookVector, cf.RightVector, cf.UpVector
	local v = root.AssemblyLinearVelocity
	local w = root.AssemblyAngularVelocity
	local fwd, lat = v:Dot(look), v:Dot(right)
	local mass = root.AssemblyMass
	local g = workspace.Gravity
	local sz = root.Size
	local Iyaw = mass * (sz.X ^ 2 + sz.Z ^ 2) / 12
	local onGround = grounded(root)
	local force, torque = Vector3.zero, Vector3.zero
	local braking = false
	local power = math.abs(throttle)

	if kind == "car" or kind == "tank" or kind == "sled" or kind == "train" then
		if onGround or kind == "train" then
			local a
			if throttle ~= 0 then
				local target = if throttle > 0 then throttle * phys.maxSpeed else throttle * phys.maxSpeed * 0.35
				a = math.clamp((target - fwd) * 3, -phys.accel * 1.8, phys.accel)
				braking = throttle < 0 and fwd > 3
			else
				a = math.clamp(-fwd * 0.8, -phys.accel * 0.5, phys.accel * 0.5) -- engine braking / parked
			end
			force += look * a * mass
			if kind ~= "train" then
				local grip = phys.grip or 1
				force += right * math.clamp(-lat * 8, -70 * grip, 70 * grip) * mass
				local speedFactor = if kind == "tank" then 1 else math.clamp(fwd / 20, -1, 1)
				local fade = 1 - 0.35 * math.clamp(math.abs(fwd) / phys.maxSpeed, 0, 1)
				local targetYaw = -steerIn * phys.turn * speedFactor * fade
				torque = up * math.clamp((targetYaw - w:Dot(up)) * 10, -14, 14) * Iyaw
			end
		end
	elseif kind == "plane" then
		local t = planeThrottle[model] or 0
		if driving then
			t = math.clamp(t + throttle * dt * 0.7, 0, 1)
		else
			t = math.max(0, t - dt * 0.5)
		end
		planeThrottle[model] = t
		power = t
		local speedF = math.clamp(fwd / phys.takeoff, 0, 1)
		if fwd < phys.maxSpeed then
			force += look * phys.accel * mass * t
		end
		force += Vector3.yAxis * mass * g * math.min(1, speedF ^ 2) * math.max(0, up.Y) -- lift
		force += -(v - look * fwd) * mass * 2.2 * speedF -- wings make the velocity follow the nose
		force += -v * mass * 0.1 -- drag
		if onGround and speedF < 0.55 then
			-- taxiing: steer like a car, brake when the engine is idle
			force += right * math.clamp(-lat * 6, -50, 50) * mass
			if t < 0.05 then
				force += look * math.clamp(-fwd * 1.2, -20, 20) * mass
			end
			local targetYaw = -steerIn * 0.9 * math.clamp(fwd / 15, -1, 1)
			torque = up * math.clamp((targetYaw - w:Dot(up)) * 8, -10, 10) * Iyaw
		else
			local auth = math.clamp(speedF, 0.15, 1) -- controls go soft in a stall
			local pitchIn = (if pitchUp then 1 else 0) - (if pitchDown then 1 else 0)
			local bank = -math.asin(math.clamp(right.Y, -1, 1)) -- + = right wing down
			local wantBank = steerIn * math.rad(55)
			local want = Vector3.new(
				pitchIn * phys.pitch * auth,
				-bank * phys.turn * 1.3 * auth,
				-math.clamp((wantBank - bank) * 2.5, -phys.roll, phys.roll) * auth
			)
			local wl = cf:VectorToObjectSpace(w)
			local I = Vector3.new(sz.Y ^ 2 + sz.Z ^ 2, sz.X ^ 2 + sz.Z ^ 2, sz.X ^ 2 + sz.Y ^ 2) * (mass / 12)
			torque = cf:VectorToWorldSpace((want - wl) * I * 6)
		end
	elseif kind == "heli" then
		if driving then
			local climbIn = (if pitchUp then 1 else 0) - (if pitchDown then 1 else 0)
			force += Vector3.yAxis * mass * (g + math.clamp((climbIn * phys.climb - v.Y) * 3, -60, 60))
			local flat = look * Vector3.new(1, 0, 1)
			flat = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, -1)
			local hv = v * Vector3.new(1, 0, 1)
			force += clampMag((flat * throttle * phys.maxSpeed - hv) * 1.5, phys.accel) * mass
			local wantUp = (Vector3.yAxis + flat * throttle * 0.28).Unit
			local targetYaw = -steerIn * phys.turn
			torque = (up:Cross(wantUp) * 30 - (w - Vector3.yAxis * w.Y) * 6 + Vector3.yAxis * (targetYaw - w.Y) * 8) * Iyaw
			power = 0.6 + 0.4 * math.max(math.abs(throttle), math.abs(climbIn))
		else
			power = 0
		end
	end

	drive.Force = force
	steer.Torque = torque

	-- visuals: wheels, propellers, turret
	for i, wh in spec.wheels do
		local h = root:FindFirstChild("WheelHinge" .. i) :: HingeConstraint?
		if h then
			h.AngularVelocity = math.clamp(-fwd / wh.radius, -120, 120)
		end
	end
	for i in spec.spinners or {} do
		local h = root:FindFirstChild("Spinner" .. i) :: HingeConstraint?
		if h then
			h.AngularVelocity = if power > 0.02 or (driving and kind ~= "plane") then 10 + power * 34 else 0
		end
	end
	if spec.turret and driving then
		local h = root:FindFirstChild("TurretHinge") :: HingeConstraint?
		local cam = workspace.CurrentCamera
		if h and cam then
			local camLook = cam.CFrame.LookVector
			h.TargetAngle = math.deg(math.atan2(-camLook:Dot(right), camLook:Dot(look)))
		end
	end

	if driving then
		local c = Controller.current
		if not c or c.model ~= model then
			c = { model = model, spec = spec, key = key, kind = kind }
			Controller.current = c
			bindAir(kind == "plane" or kind == "heli")
		end
		c.speedMph = v.Magnitude * Config.STUDS_PER_SEC_TO_MPH
		c.speed = v.Magnitude
		c.throttle = power
		c.grounded = onGround
		c.braking = braking
		c.slip = math.abs(lat)
		c.altitude = root.Position.Y
	end
	model:SetAttribute("ClientPower", math.floor(power * 20 + 0.5) / 20) -- local only; read by AudioController
end

function Controller.init()
	folder = workspace:WaitForChild("Vehicles") :: Folder
	ContextActionService:BindAction("RCP_Horn", function(_, state)
		if state == Enum.UserInputState.Begin and Controller.current and Controller.onHorn then
			Controller.onHorn()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.H, Enum.KeyCode.ButtonY)
	folder.ChildRemoved:Connect(function(m)
		planeThrottle[m :: Model] = nil
	end)
	RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		rayParams.FilterDescendantsInstances = { folder, char, workspace:FindFirstChild("Dummies") } :: { any }
		local stillDriving = false
		for _, model in folder:GetChildren() do
			if model:IsA("Model") then
				stepVehicle(model, dt, humanoid)
				if Controller.current and Controller.current.model == model then
					local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat?
					stillDriving = seat ~= nil and humanoid ~= nil and seat.Occupant == humanoid
				end
			end
		end
		if Controller.current and not stillDriving then
			Controller.current = nil
			bindAir(false)
		end
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
